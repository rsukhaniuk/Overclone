{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:offline-latex:release-inputs:1",
  "title": "R4 A1 release inputs (candidate, not runtime authority)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "files", "buildInputs", "approvedProfileIdentity", "archiveLimits", "archives"],
  "properties": {
    "schemaVersion": {"const": 1},
    "release": {"$ref": "#/$defs/identity"},
    "files": {"$ref": "#/$defs/files"},
    "buildInputs": {"$ref": "#/$defs/file"},
    "approvedProfileIdentity": {"$ref": "#/$defs/file"},
    "archiveLimits": {"$ref": "#/$defs/archiveLimits"},
    "archives": {"type": "array", "items": {"$ref": "#/$defs/archive"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 8192},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "path": {"type": "string", "format": "release-path"},
    "time": {"type": "string", "format": "utc-time"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "length", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "length": {"$ref": "#/$defs/uint"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "files": {"type": "array", "x-sortBy": ["path"], "items": {"$ref": "#/$defs/file"}},
    "names": {"type": "array", "x-sortBy": [], "items": {"$ref": "#/$defs/name"}},
    "nullableFile": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]},
    "fileManifest": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "files"], "properties": {"schemaVersion": {"const": 1}, "files": {"$ref": "#/$defs/files"}}},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "source", "build", "compiler", "renderer", "analysis", "application", "materials"],
      "properties": {
        "schemaVersion": {"const": 1},
        "source": {"type": "object", "additionalProperties": false, "required": ["baseCommit", "treeManifest", "treeSha256"], "properties": {"baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "treeManifest": {"$ref": "#/$defs/file"}, "treeSha256": {"$ref": "#/$defs/sha"}}},
        "build": {"type": "object", "additionalProperties": false, "required": ["recipeManifest", "toolchainManifest", "dependencyManifest", "sourceDateEpoch", "stageReceipts", "rebuildComparison", "configuration"], "properties": {"recipeManifest": {"$ref": "#/$defs/file"}, "toolchainManifest": {"$ref": "#/$defs/file"}, "dependencyManifest": {"$ref": "#/$defs/file"}, "sourceDateEpoch": {"$ref": "#/$defs/uint"}, "stageReceipts": {"$ref": "#/$defs/files"}, "rebuildComparison": {"$ref": "#/$defs/file"}, "configuration": {"const": "Release;PublishTrimmed=false;CompressionEnabled=false"}}},
        "compiler": {"$ref": "#/$defs/compiler"},
        "renderer": {"type": "object", "additionalProperties": false, "required": ["loader", "wasm", "provenance"], "properties": {"loader": {"$ref": "#/$defs/file"}, "wasm": {"$ref": "#/$defs/file"}, "provenance": {"$ref": "#/$defs/file"}}},
        "analysis": {"type": "object", "additionalProperties": false, "required": ["wasm", "loader", "ruleMetadata"], "properties": {"wasm": {"$ref": "#/$defs/file"}, "loader": {"$ref": "#/$defs/file"}, "ruleMetadata": {"$ref": "#/$defs/files"}}},
        "application": {"type": "object", "additionalProperties": false, "required": ["publishedTree", "clientWasm", "sdkAssets", "sdkManifestVersion", "serviceWorker", "workerSources", "cspDocument", "cspHeaders", "pwaManifest", "managedDependencyLock"], "properties": {"publishedTree": {"$ref": "#/$defs/file"}, "clientWasm": {"$ref": "#/$defs/file"}, "sdkAssets": {"$ref": "#/$defs/file"}, "sdkManifestVersion": {"$ref": "#/$defs/text"}, "serviceWorker": {"$ref": "#/$defs/file"}, "workerSources": {"$ref": "#/$defs/files"}, "cspDocument": {"$ref": "#/$defs/file"}, "cspHeaders": {"$ref": "#/$defs/file"}, "pwaManifest": {"$ref": "#/$defs/file"}, "managedDependencyLock": {"$ref": "#/$defs/file"}}},
        "materials": {"type": "object", "additionalProperties": false, "required": ["componentInventory", "noticesIndex", "sourceAccess", "rebuildInstructions", "licenseDecision", "compatibilityMatrix"], "properties": {"componentInventory": {"$ref": "#/$defs/file"}, "noticesIndex": {"$ref": "#/$defs/file"}, "sourceAccess": {"$ref": "#/$defs/file"}, "rebuildInstructions": {"$ref": "#/$defs/file"}, "licenseDecision": {"$ref": "#/$defs/file"}, "compatibilityMatrix": {"$ref": "#/$defs/file"}}}
      }
    },
    "compiler": {"type": "object", "additionalProperties": false, "required": ["profile", "inventory", "closureSha256", "zip", "components", "formats", "admittedTuples"], "properties": {"profile": {"$ref": "#/$defs/uint"}, "inventory": {"$ref": "#/$defs/file"}, "closureSha256": {"$ref": "#/$defs/sha"}, "zip": {"$ref": "#/$defs/file"}, "components": {"type": "array", "minItems": 1, "x-sortBy": ["componentId"], "items": {"$ref": "#/$defs/component"}}, "formats": {"type": "array", "x-sortBy": ["componentId"], "items": {"$ref": "#/$defs/format"}}, "admittedTuples": {"type": "array", "minItems": 1, "x-sortBy": ["profile", "phase", "engineId", "tool", "workerRole", "componentId"], "items": {"$ref": "#/$defs/tuple"}}}},
    "component": {"type": "object", "additionalProperties": false, "required": ["componentId", "role", "sourceManifest", "patchManifest", "selectedLinkManifest", "noticeAssociation"], "properties": {"componentId": {"$ref": "#/$defs/name"}, "role": {"$ref": "#/$defs/name"}, "loader": {"$ref": "#/$defs/file"}, "wasm": {"$ref": "#/$defs/file"}, "sourceManifest": {"$ref": "#/$defs/file"}, "patchManifest": {"$ref": "#/$defs/file"}, "selectedLinkManifest": {"$ref": "#/$defs/file"}, "noticeAssociation": {"$ref": "#/$defs/file"}}},
    "format": {"type": "object", "additionalProperties": false, "required": ["componentId", "output", "engineComponentId", "inputManifest", "recipe", "generationEnvironment"], "properties": {"componentId": {"$ref": "#/$defs/name"}, "output": {"$ref": "#/$defs/file"}, "engineComponentId": {"$ref": "#/$defs/name"}, "inputManifest": {"$ref": "#/$defs/file"}, "recipe": {"$ref": "#/$defs/file"}, "generationEnvironment": {"$ref": "#/$defs/file"}}},
    "tuple": {"type": "object", "additionalProperties": false, "required": ["profile", "phase", "engineId", "tool", "workerRole", "componentId"], "properties": {"profile": {"$ref": "#/$defs/uint"}, "phase": {"$ref": "#/$defs/positive"}, "engineId": {"enum": ["pdftex", "latex-dvi", "xelatex", "lualatex", "dvi", "synctex", "pdf"]}, "tool": {"$ref": "#/$defs/name"}, "workerRole": {"enum": ["compile", "dvi", "xetex", "luatex", "pdf", "synctex", "biber"]}, "componentId": {"$ref": "#/$defs/name"}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "components"], "properties": {"schemaVersion": {"const": 1}, "components": {"type": "array", "minItems": 1, "x-sortBy": ["componentId"], "items": {"$ref": "#/$defs/inventoryRow"}}}},
    "inventoryRow": {"type": "object", "additionalProperties": false, "required": ["componentId", "role", "shippedFiles", "sourceFilesManifest", "upstreamIdentity", "generatedFrom", "patches", "buildReceipt", "selectedLinkManifest", "licenseEvidence", "licenseExpression", "provenanceStatus", "principalTextStatus", "distributionStatus", "reviewDecision"], "properties": {"componentId": {"$ref": "#/$defs/name"}, "role": {"enum": ["runtime", "build-only"]}, "shippedFiles": {"$ref": "#/$defs/files"}, "sourceFilesManifest": {"$ref": "#/$defs/file"}, "upstreamIdentity": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "generatedFrom": {"$ref": "#/$defs/names"}, "patches": {"$ref": "#/$defs/files"}, "buildReceipt": {"$ref": "#/$defs/file"}, "selectedLinkManifest": {"$ref": "#/$defs/nullableFile"}, "licenseEvidence": {"$ref": "#/$defs/files"}, "licenseExpression": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "provenanceStatus": {"enum": ["complete", "unknown"]}, "principalTextStatus": {"enum": ["present", "missing", "partial"]}, "distributionStatus": {"enum": ["pending", "approved", "blocked"]}, "reviewDecision": {"$ref": "#/$defs/nullableFile"}}},
    "patches": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "patches"], "properties": {"schemaVersion": {"const": 1}, "patches": {"type": "array", "x-sortBy": ["path"], "items": {"type": "object", "additionalProperties": false, "required": ["path", "patch", "before", "after"], "properties": {"path": {"$ref": "#/$defs/path"}, "patch": {"$ref": "#/$defs/file"}, "before": {"$ref": "#/$defs/file"}, "after": {"$ref": "#/$defs/file"}}}}}},
    "link": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "componentId", "members"], "properties": {"schemaVersion": {"const": 1}, "componentId": {"$ref": "#/$defs/name"}, "members": {"type": "array", "minItems": 1, "x-sortBy": ["path"], "items": {"type": "object", "additionalProperties": false, "required": ["path", "member", "sources", "workIds"], "properties": {"path": {"$ref": "#/$defs/path"}, "member": {"$ref": "#/$defs/file"}, "sources": {"$ref": "#/$defs/files"}, "workIds": {"$ref": "#/$defs/names"}}}}}},
    "notices": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "notices", "works"], "properties": {"schemaVersion": {"const": 1}, "notices": {"type": "array", "minItems": 1, "x-sortBy": ["id"], "items": {"type": "object", "additionalProperties": false, "required": ["id", "componentId", "text", "source", "member", "workId", "kind"], "properties": {"id": {"$ref": "#/$defs/name"}, "componentId": {"$ref": "#/$defs/name"}, "text": {"$ref": "#/$defs/file"}, "source": {"$ref": "#/$defs/file"}, "member": {"$ref": "#/$defs/nullableFile"}, "workId": {"$ref": "#/$defs/name"}, "kind": {"enum": ["complete", "excerpt"]}}}}, "works": {"type": "array", "minItems": 1, "x-sortBy": ["workId"], "items": {"type": "object", "additionalProperties": false, "required": ["workId", "componentIds", "sourceFiles", "noticeIds", "generatedFrom"], "properties": {"workId": {"$ref": "#/$defs/name"}, "componentIds": {"$ref": "#/$defs/names"}, "sourceFiles": {"$ref": "#/$defs/files"}, "noticeIds": {"$ref": "#/$defs/names"}, "generatedFrom": {"$ref": "#/$defs/names"}}}}}},
    "association": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "componentId", "noticeIds", "workIds"], "properties": {"schemaVersion": {"const": 1}, "componentId": {"$ref": "#/$defs/name"}, "noticeIds": {"$ref": "#/$defs/names"}, "workIds": {"$ref": "#/$defs/names"}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "status", "policy", "reviewReference", "components"], "properties": {"schemaVersion": {"const": 1}, "status": {"enum": ["pending", "approved", "blocked"]}, "policy": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "reviewReference": {"$ref": "#/$defs/nullableFile"}, "components": {"$ref": "#/$defs/names"}}},
    "sourceAccess": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "components"], "properties": {"schemaVersion": {"const": 1}, "components": {"type": "array", "x-sortBy": ["componentId"], "items": {"type": "object", "additionalProperties": false, "required": ["componentId", "route", "files", "decision"], "properties": {"componentId": {"$ref": "#/$defs/name"}, "route": {"enum": ["accompanying", "pending"]}, "files": {"$ref": "#/$defs/files"}, "decision": {"$ref": "#/$defs/nullableFile"}}}}}},
    "buildInputs": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "sourceTreeSha256", "recipeManifest", "toolchainManifest", "dependencyManifest", "sourceDateEpoch", "configuration", "approvedProfileSha256", "stageOutputs"], "properties": {"schemaVersion": {"const": 1}, "sourceTreeSha256": {"$ref": "#/$defs/sha"}, "recipeManifest": {"$ref": "#/$defs/file"}, "toolchainManifest": {"$ref": "#/$defs/file"}, "dependencyManifest": {"$ref": "#/$defs/file"}, "sourceDateEpoch": {"$ref": "#/$defs/uint"}, "configuration": {"const": "Release;PublishTrimmed=false;CompressionEnabled=false"}, "approvedProfileSha256": {"$ref": "#/$defs/sha"}, "stageOutputs": {"type": "object", "additionalProperties": false, "required": ["native", "rust", "managed"], "properties": {"native": {"$ref": "#/$defs/outputNames"}, "rust": {"$ref": "#/$defs/outputNames"}, "managed": {"$ref": "#/$defs/outputNames"}}}}},
    "outputNames": {"type": "array", "minItems": 1, "x-sortBy": [], "items": {"$ref": "#/$defs/path"}},
    "embedding": {"type": "object", "additionalProperties": false, "required": ["output", "origin"], "properties": {"output": {"$ref": "#/$defs/file"}, "origin": {"$ref": "#/$defs/file"}}},
    "stage": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "status", "command", "receipt", "stage", "replica", "sourceTreeSha256", "inputManifestSha256", "toolchainManifest", "predecessorReceipts", "outputs", "embeddedOutputs", "exitCode", "sourcePreservation", "freshBuild", "startedUtc", "finishedUtc"], "properties": {"schemaVersion": {"const": 1}, "id": {"$ref": "#/$defs/name"}, "status": {"enum": ["pass", "fail", "blocked", "not-run"]}, "command": {"$ref": "#/$defs/text"}, "receipt": {"$ref": "#/$defs/path"}, "stage": {"enum": ["native", "rust", "managed"]}, "replica": {"enum": ["A", "B"]}, "sourceTreeSha256": {"$ref": "#/$defs/sha"}, "inputManifestSha256": {"$ref": "#/$defs/sha"}, "toolchainManifest": {"$ref": "#/$defs/file"}, "predecessorReceipts": {"$ref": "#/$defs/files"}, "outputs": {"$ref": "#/$defs/files"}, "embeddedOutputs": {"type": "array", "x-sortBy": ["output.path"], "items": {"$ref": "#/$defs/embedding"}}, "exitCode": {"$ref": "#/$defs/uint"}, "sourcePreservation": {"$ref": "#/$defs/file"}, "freshBuild": {"type": "object", "additionalProperties": false, "required": ["runId", "outputRootId", "initialOutputFiles"], "properties": {"runId": {"$ref": "#/$defs/name"}, "outputRootId": {"$ref": "#/$defs/name"}, "initialOutputFiles": {"type": "array", "maxItems": 0}}}, "startedUtc": {"$ref": "#/$defs/time"}, "finishedUtc": {"$ref": "#/$defs/time"}, "skipCount": {"$ref": "#/$defs/uint"}, "skips": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reason", "coverage"], "properties": {"reason": {"$ref": "#/$defs/text"}, "coverage": {"$ref": "#/$defs/text"}}}}, "artifacts": {"$ref": "#/$defs/files"}, "reusedEvidence": {"$ref": "#/$defs/files"}, "environmentArtifact": {"$ref": "#/$defs/file"}, "releaseIdentitySha256": {"$ref": "#/$defs/sha"}, "compiledRevision": {"type": "null"}}},
    "preservation": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "beforeSha256", "afterSha256"], "properties": {"schemaVersion": {"const": 1}, "beforeSha256": {"$ref": "#/$defs/sha"}, "afterSha256": {"$ref": "#/$defs/sha"}}},
    "componentBuild": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "componentId", "sourceManifest", "patchManifest", "selectedLinkManifest", "inputManifestSha256", "outputs"], "properties": {"schemaVersion": {"const": 1}, "componentId": {"$ref": "#/$defs/name"}, "sourceManifest": {"$ref": "#/$defs/file"}, "patchManifest": {"$ref": "#/$defs/file"}, "selectedLinkManifest": {"$ref": "#/$defs/nullableFile"}, "inputManifestSha256": {"$ref": "#/$defs/sha"}, "outputs": {"$ref": "#/$defs/files"}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "status", "command", "receipt", "stageReceipts", "inputManifestSha256"], "properties": {"schemaVersion": {"const": 1}, "id": {"const": "R4-REP-01"}, "status": {"enum": ["pass", "fail", "blocked", "not-run"]}, "command": {"$ref": "#/$defs/text"}, "receipt": {"$ref": "#/$defs/path"}, "stageReceipts": {"$ref": "#/$defs/files"}, "inputManifestSha256": {"$ref": "#/$defs/sha"}}},
    "published": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "files", "exclusions"], "properties": {"schemaVersion": {"const": 1}, "files": {"$ref": "#/$defs/files"}, "exclusions": {"const": ["evidence/", "release-identity.json", "release-index.json"]}}},
    "archiveLimits": {"type": "object", "additionalProperties": false, "required": ["maxFileBytes", "maxTotalBytes", "maxMembers"], "properties": {"maxFileBytes": {"$ref": "#/$defs/positive"}, "maxTotalBytes": {"$ref": "#/$defs/positive"}, "maxMembers": {"type": "integer", "minimum": 1, "maximum": 200000}}},
    "archive": {"type": "object", "additionalProperties": false, "required": ["file", "format", "members"], "properties": {"file": {"$ref": "#/$defs/file"}, "format": {"enum": ["zip", "tar"]}, "members": {"$ref": "#/$defs/files"}}}
  }
}
