<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfBrowserHarness</RootNamespace>
    <AssemblyName>PdfBrowserHarness</AssemblyName>
    <PublishTrimmed>false</PublishTrimmed>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <Compile Include="../../src/Client/Pdf/**/*.cs" Link="Pdf/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../src/Client/wwwroot/js/pdf-port-bridge.js" Link="wwwroot/js/pdf-port-bridge.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../src/Client/wwwroot/js/pdf-port-worker.js" Link="wwwroot/js/pdf-port-worker.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
