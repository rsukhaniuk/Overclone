<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>/artifacts/dotnet/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>/artifacts/dotnet/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
