    private async Task CloseAsync()
    {
        // Closing cancels page-owned pending review authorization, but never
        // clears accepted recovery if the normal close/save flush must fail.
        _reviewIntent++;
        _reviewCts?.Cancel();
        ReviewService.Cancel();
        _reviewPending = false;
        _reviewNotice = null;
        _seenPreview = null;
        // CloseAsync flushes saves internally until clean (or aborts on failure),
        // so just call it. It serializes against save/import/restore.
        await Coordinator.CloseAsync(System.Threading.CancellationToken.None);
        CancelAutosave();
        await RefreshProjectsAsync();
        _history.Clear();
        _historyNextCursor = null;
        _comparison = null;
        StateHasChanged();
    }

