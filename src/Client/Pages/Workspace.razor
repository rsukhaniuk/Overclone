@page "/"
@inject WorkspaceCoordinator Coordinator
@inject IWorkspaceLocks StarterLocks
@using Client.Workspace.Starters
@using Client.Workspace.Imports
@using Client.Workspace.Renaming
@inject IProjectTransfer Transfer
@inject IArchiveExport ArchiveExport
@inject FolderTransferService Folders
@inject AnalysisCoordinator AnalysisCoord
@inject SourceNavigator Navigator
@using Client.Review
@using Client.Editing
@using Client.Editing.Search
@using Client.Editing.Completion
@using Client.Editing.Assistance
@inject IAuthoringAssistProvider AuthoringAssistProvider
@using Client.Compilation.Navigation
@using Client.Compilation.SyncTeX
@using Client.Pdf.Preview
@inject ISyncTeXQuery SourceMapQueries
@inject Client.Compilation.Presentation.CompileWorkspaceSession CompileSession
@inject IChangeReviewService ReviewService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Overclone · Document workspace</PageTitle>

<main class="@(Coordinator.IsOpen ? "workbench" : "project-dashboard")">

@if (Coordinator.Capabilities is { } caps && (!caps.Opfs || !caps.IndexedDb))
{
    <div class="banner banner-error" role="alert">
        This browser cannot store documents offline: OPFS or IndexedDB is unavailable.
        Editing is disabled. Use desktop Chrome or Edge.
    </div>
}

@if (!string.IsNullOrEmpty(_offlineReadinessNotice))
{
    <div class="banner banner-warn" role="status" data-testid="offline-readiness-notice">
        @_offlineReadinessNotice
    </div>
}

@if (!Coordinator.IsOpen)
{
    var displayedProjects = _projects.Where(p => p.Name.Contains(_projectQuery.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();

    <aside class="dashboard-sidebar" aria-label="Project manager navigation">
        <a class="dashboard-brand" href="/">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M6 3h8l4 4v14H6z" stroke="currentColor" stroke-width="1.6" /><path d="M14 3v5h4M9 12h6M9 16h6" stroke="currentColor" stroke-width="1.6" /></svg>
            Overclone
        </a>
        <nav aria-label="Projects navigation">
            <a class="dashboard-nav active" href="#all-projects" aria-current="page">Projects</a>
            <a class="dashboard-nav" href="#dashboard-import">Import projects</a>
            <a class="dashboard-nav" href="#dashboard-drive">Google Drive</a>
        </nav>
        <div class="dashboard-sidebar-bottom">
            <details class="dashboard-tools">
                <summary>Developer tools</summary>
                <NavLink href="/smoke">Worker smoke test</NavLink>
            </details>
            <p>Local workspace</p>
            <small>Keep an exported copy as a backup.</small>
        </div>
    </aside>

    <section class="projects-panel" id="all-projects" aria-label="Projects">
        <header class="projects-heading"><h1>All projects</h1></header>
        <div class="dashboard-toolbar">
            <div class="project-search">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.8" /><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" /></svg>
                <label class="sr-only" for="project-search">Search projects</label>
                <input id="project-search" type="search" @bind="_projectQuery" @bind:event="oninput" @bind:after="ProjectRenameFilterChanged" disabled="@ProjectRenameBusy"
                       placeholder="Search projects" autocomplete="off" data-testid="project-search" />
                @if (_projectQuery.Length > 0)
                {
                    <button class="clear-search" @onclick='() => { if (!ProjectRenameBusy) { _projectQuery = ""; ProjectRenameFilterChanged(); } }' disabled="@ProjectRenameBusy" aria-label="Clear search">✕</button>
                }
            </div>
            <details class="new-project-menu" data-testid="new-project-disclosure">
                <summary>New project <span aria-hidden="true">▾</span></summary>
                <form class="new-project-popover" @onsubmit="@(async () => await CreateProjectAsync())" @onsubmit:preventDefault>
                    <label for="new-project">Project name</label>
                    <input id="new-project" @bind="_newProjectName" @bind:event="oninput"
                           placeholder="Untitled project" autocomplete="off" />
                    <button class="dashboard-primary" type="submit" disabled="@ProjectRenameBusy">Create project</button>
                </form>
            </details>
        </div>

        <div class="project-table-scroll" tabindex="0" role="region" aria-label="Local projects table">
            <table class="project-table">
                <thead><tr><th scope="col">Title</th><th scope="col">Storage</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                    @foreach (var p in displayedProjects)
                    {
                        <tr @key="p.Id" data-testid="project-row" data-name="@p.Name"
                            data-project-id="@p.Id">
                            <td><button class="project-title" @onclick='() => OpenProjectAsync(p.Id)' data-testid="open-project" disabled="@ProjectRenameBusy">@p.Name</button></td>
                            <td class="project-storage">This device</td>
                            <td><span class="project-status">@(p.HeadRevisionId is null ? "Empty" : "Saved revision")</span></td>
                            <td>
                                <button class="project-delete" @onclick='() => DeleteProjectAsync(p.Id)' aria-label='Delete project @p.Name' disabled="@ProjectRenameBusy">Delete</button>
                                <button type="button" data-testid="project-rename-show" disabled="@ProjectRenameBusy" @onclick="() => ShowProjectRename(p)">Rename</button>
                                @if (_projectRename?.CurrentProposal is { } rename && rename.Expected.Id == p.Id)
                                {
                                    var capturedRename = rename;
                                    <form @onsubmit="() => ConfirmProjectRenameAsync(capturedRename)" @onsubmit:preventDefault>
                                        <label>New project name <input data-testid="project-rename-input" @bind="_projectRenameName" @bind:event="oninput" disabled="@ProjectRenameBusy" autocomplete="off" /></label>
                                        <p>Rename only: up to 256 Unicode scalar values, no controls or line breaks. Duplicate display names are allowed.</p>
                                        <button type="submit" data-testid="project-rename-confirm" disabled="@ProjectRenameBusy">Confirm rename</button>
                                        <button type="button" data-testid="project-rename-cancel" @onclick="() => CancelProjectRename(capturedRename)">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (displayedProjects.Length == 0)
                    {
                        <tr><td colspan="4" class="project-table-empty">
                            @if (_projects.Count == 0)
                            {
                                <h2>No projects yet</h2>
                                <p>Choose New project to create one, or <a href="#dashboard-import">import a ZIP or folder</a>.</p>
                            }
                            else
                            {
                                <h2>No matching projects</h2>
                                <p>Try another name, or use Clear search to show all projects.</p>
                            }
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_projectRename is { } renameStatus)
        {
            <p role="status" data-testid="project-rename-status" data-state="@renameStatus.State.ToString().ToLowerInvariant()" data-busy="@renameStatus.Busy.ToString().ToLowerInvariant()">@renameStatus.Notice</p>
        }
        <footer class="projects-footer">
            <span role="status" aria-live="polite" data-testid="project-count">Showing @displayedProjects.Length of @_projects.Count projects</span>
            <span>Local projects stay on this device. Export a copy for backup.</span>
        </footer>

        <details class="dashboard-import" id="dashboard-import" data-testid="project-import-disclosure">
            <summary>Import projects <span>ZIP or folder</span></summary>
            <div class="dashboard-import-body">
                <label class="zip-import">Import ZIP
                    <InputFile OnChange="OnImportZip" accept=".zip" data-testid="import-zip" disabled="@ProjectRenameBusy" />
                </label>
                <button @onclick="OnImportFolder" data-testid="import-folder"
                        disabled="@(ProjectRenameBusy || !_folderCap.Picker)">Import folder</button>
            </div>

        @if (_staged is { } staged)
        {
            <section class="staged-preview" data-testid="import-preview">
                <h2>Import preview</h2>
                <label for="staged-name">Project name</label>
                <input id="staged-name" @bind="_stagedName" @bind:event="oninput"
                       data-testid="staged-name" autocomplete="off" />
                @if (_stagedExcluded.Count > 0)
                {
                    <p class="hint">Excluded trees: @string.Join(", ", _stagedExcluded)</p>
                }
                @if (staged.ValidationErrors.Count > 0)
                {
                    <ul class="validation-errors" data-testid="validation-errors">
                        @foreach (var e in staged.ValidationErrors)
                        {
                            <li data-testid="validation-error">
                                <code>@(e.RelativePath.Length == 0 ? "(archive)" : e.RelativePath)</code>
                                — @e.Code: @e.Message
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="hint">@(staged.Files.Length) file(s):</p>
                    <ul class="staged-files">
                        @foreach (var f in staged.Files)
                        {
                            <li>
                                <span class="kind @(f.MediaKind == "binary" ? "bin" : "text")">[@f.MediaKind]</span>
                                <span class="path">@f.RelativePath</span>
                                <span class="meta">@f.ByteLength bytes@(f.HasBom ? ", BOM" : "")</span>
                            </li>
                        }
                    </ul>
                }
                <div class="actions">
                    <button @onclick="PublishStagedAsync" data-testid="publish-import"
                            disabled="@(ProjectRenameBusy || staged.ValidationErrors.Count > 0)">Publish as new project</button>
                    <button class="muted" @onclick="CancelStaged" data-testid="cancel-import">Cancel</button>
                </div>
            </section>
        }

        </details>
    </section>
}
else
{
    <section class="panel workspace" aria-label="Workspace @Coordinator.Project?.Name">
        <header class="workspace-header">
            <button class="project-back" @onclick="CloseAsync" aria-label="Close" title="Back to projects">←</button>
            <a class="brand" href="/">Overclone</a>
            <span class="workspace-badge">Local workspace</span>
            <div class="title-block">
                <h1>@Coordinator.Project?.Name</h1>
                <p class="status @StatusClass" role="status" aria-live="polite">@StatusText</p>
            </div>
            <div class="actions">
                <button @onclick="SaveAsync" disabled="@SaveDisabled" data-testid="save">
                    @(Coordinator.SavePhase == SavePhase.Saving ? "Saving…" : "Save")
                </button>
                <details class="project-menu">
                    <summary>Project</summary>
                    <div class="menu-items">
                        <button @onclick="ExportZipAsync" data-testid="export-zip">Export ZIP</button>
                        <button @onclick="ExportFolderAsync" data-testid="export-folder"
                                disabled="@(!_folderCap.Writable)">Export to folder</button>
                        <NavLink class="project-smoke-link" href="/smoke">Worker smoke test</NavLink>
                    </div>
                </details>
            </div>
        </header>

        @if (Coordinator.IsReadOnly)
        {
            <div class="banner banner-readonly" role="alert">
                @if (Coordinator.Capabilities?.WebLocks == false)
                {
                    <span>Writer locks are unavailable in this browser; the project is read-only.</span>
                }
                else
                {
                    <span>Another tab is editing this project. Opened read-only.</span>
                    <button @onclick="TakeOverAsync" data-testid="takeover">Take over editing</button>
                }
            </div>
        }

        @if (Coordinator.Recovery is { } recovery)
        {
            <div class="banner banner-recovery" role="alert">
                <p>The project head could not be verified and may be damaged. Damaged data is
                    retained. Select a complete checkpoint to recover to:</p>
                @if (recovery.CompleteCheckpoints.Count == 0)
                {
                    <p>No complete checkpoints are available. Export any recoverable content and
                        start a new project.</p>
                }
                else
                {
                    <ul class="checkpoint-list">
                        @foreach (var cp in recovery.CompleteCheckpoints)
                        {
                            <li>
                                <span>@cp.Reason — @(cp.RevisionId.ToString().Substring(0, 8))</span>
                                <button @onclick='() => RecoverToAsync(cp.RevisionId)'
                                        data-testid="recover">Recover to this</button>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_transferStatus))
        {
            <p class="transfer-status @TransferStatusClass" role="status" aria-live="polite"
               data-testid="transfer-status">@_transferStatus</p>
        }

        <div class="workspace-body">
            <aside class="file-tree" aria-label="Files">
                <h2 class="pane-title">Project files</h2>
                <form @onsubmit="@(() => CreateFile())" @onsubmit:preventDefault>
                    <input aria-label="New file path" @bind="_newFileName" @bind:event="oninput" placeholder="New file path…"
                           autocomplete="off" data-testid="new-file-name" />
                    <button type="submit" data-testid="new-file">New file</button>
                </form>
                <div class="import">
                    <label for="import-file">Import file</label>
                    <InputFile id="import-file" OnChange="OnImportFile" accept=".tex,.txt,.bib,.cls,.sty,.bst,.md,.json,.yaml,.yml,.csv,image/*,application/pdf"
                               data-testid="import-input" disabled="@(_singleFileImport?.Busy != false)" />
                    @if (_singleFileImport is { } importer)
                    {
                        <p role="status" data-testid="single-file-import-status"
                           data-state="@importer.State.ToString().ToLowerInvariant()"
                           data-busy="@importer.Busy.ToString().ToLowerInvariant()">@importer.Notice</p>
                        @if (importer.Busy)
                        {
                            <button type="button" data-testid="single-file-import-cancel" @onclick="importer.Cancel">Cancel import</button>
                        }
                    }
                </div>
                <details class="project-search-disclosure" data-testid="project-search-disclosure">
                    <summary>Search project</summary>
                    <ProjectSearchPanel OnNavigate="OnProjectSearchNavigateAsync" NavigationStatus="@_projectSearchNavigationStatus" />
                </details>
                <ul class="files">
                    @foreach (var f in Coordinator.Files.Where(f => !f.Deleted))
                    {
                        var id = f.Id;
                        <li class="@(Coordinator.ActiveFileId == id ? "active" : "")">
                            <button class="file-link" @onclick='() => { SelectFile(id); }'
                                    data-testid="select-file">
                                <span class="file-icon @(f.MediaKind == "binary" ? "bin" : "text")" aria-label="@f.MediaKind"></span>
                                <span class="file-name">@f.RelativePath</span>
                            </button>
                            @if (f.IsNew || f.DirtyContent || f.DirtyBinary || f.TreeChanged)
                            {
                                <span class="dirty-dot" aria-label="unsaved">●</span>
                            }
                            <button class="icon danger" @onclick='() => { DeleteFile(id); }'
                                    aria-label='Delete @f.RelativePath' data-testid="delete-file">✕</button>
                        </li>
                    }
                </ul>
            </aside>

            <div class="editor-area">
                @if (Coordinator.ActiveFile is { } active)
                {
                    <div class="editor-toolbar">
                        <label class="source-tab" for="editor">@active.RelativePath</label>
                        <details class="file-menu">
                            <summary>File actions</summary>
                            <div class="menu-items">
                                <label for="rename">Rename file</label>
                                <input id="rename" @bind="_renameTarget" @bind:event="oninput"
                                       placeholder="New path…" autocomplete="off" data-testid="rename-input" />
                                <button @onclick='() => { RenameFile(active.Id); }' data-testid="rename">Rename</button>
                                <button @onclick="DownloadFileAsync" data-testid="download">
                                    Download@(active.MediaKind == "binary" ? " file" : " text")
                                </button>
                            </div>
                        </details>
                    </div>
                    @if (active.MediaKind == "binary")
                    {
                        <div class="binary-view" data-testid="binary-view">
                            <p>This file is binary and is not text-editable.</p>
                            <dl>
                                <dt>Path</dt><dd>@active.RelativePath</dd>
                                <dt>Size</dt><dd>@(active.DurableLength > 0 ? active.DurableLength : (active.BinaryContent?.Length ?? 0)) bytes</dd>
                                <dt>Type</dt><dd>@(active.DurableHash is null ? "new asset" : "stored asset")</dd>
                            </dl>
                            <button @onclick="DownloadFileAsync" data-testid="download-binary">Download</button>
                            <BinaryAssetReplacementPanel Target="@active" />
                        </div>
                    }
                    else
                    {
                        <details class="source-tools" data-testid="source-tools" aria-busy='@(_sourceBusy ? "true" : "false")'>
                            <summary>Source tools</summary>
                            <div class="source-tools-controls" role="group" aria-label="Find and replace">
                                <label for="source-query">Find</label>
                                <input id="source-query" data-testid="source-query" @bind="_sourceQuery" @bind:event="oninput" @bind:after="SourceQueryChanged" autocomplete="off" />
                                <label class="source-tools-case"><input type="checkbox" data-testid="source-case" @bind="_sourceCase" @bind:after="SourceQueryChanged" /> Match case</label>
                                <button type="button" disabled="@_sourceBusy" @onclick='() => RunSourceToolAsync("previous")' data-testid="source-previous">Previous</button>
                                <button type="button" disabled="@_sourceBusy" @onclick='() => RunSourceToolAsync("next")' data-testid="source-next">Next</button>
                                <label for="source-replacement">Replace with</label>
                                <input id="source-replacement" data-testid="source-replacement" @bind="_sourceReplacement" @bind:event="oninput" autocomplete="off" />
                                <button type="button" disabled="@SourceEditsDisabled" @onclick='() => RunSourceToolAsync("replace")' data-testid="source-replace">Replace current</button>
                                <button type="button" disabled="@SourceEditsDisabled" @onclick='() => RunSourceToolAsync("all")' data-testid="source-all">Replace all</button>
                            </div>
                            <div class="source-tools-controls" role="group" aria-label="Selected lines">
                                <button type="button" disabled="@SourceEditsDisabled" @onclick='() => RunSourceToolAsync("indent")' data-testid="source-indent">Indent</button>
                                <button type="button" disabled="@SourceEditsDisabled" @onclick='() => RunSourceToolAsync("unindent")' data-testid="source-unindent">Unindent</button>
                                <button type="button" disabled="@SourceEditsDisabled" @onclick='() => RunSourceToolAsync("comment")' data-testid="source-comment">Toggle % comments</button>
                                <span role="status" aria-live="polite" data-testid="source-status">@_sourceStatus</span>
                            </div>
                            <div class="source-tools-controls" role="group" aria-label="Explicit LaTeX command suggestions">
                                <button type="button" disabled="@SourceEditsDisabled" data-testid="source-completion-show" @onclick="ShowCompletionsAsync">Suggest LaTeX commands</button>
                                <span role="status" data-testid="source-completion-status" data-state="@_completionState">@CompletionNotice</span>
                            </div>
                            <div data-testid="source-completion-results">
                                @if (_completions?.CurrentProposal is { } proposal && _completions.IsCurrent(proposal, _sourceIntent))
                                {
                                    @foreach (var command in proposal.Commands)
                                    {
                                        var captured = proposal;
                                        var id = command.Id;
                                        <button type="button" disabled="@SourceEditsDisabled" data-testid="source-completion-insert" data-command-id="@id"
                                                title="@command.Label" @onclick="() => InsertCompletionAsync(captured, id)">Insert @("\\" + id)</button>
                                    }
                                    <button type="button" data-testid="source-completion-dismiss" @onclick="() => DismissCompletion(proposal)">Dismiss</button>
                                }
                            </div>
                        </details>
                        <details data-testid="authoring-assist-disclosure">
                            <summary>Local source assistance</summary>
                            <label>Selected source root
                                <select value="@_assistRoot" @onchange="AssistanceRootChanged" data-testid="authoring-assist-root">
                                    <option value="">Select a current .tex root</option>
                                    @foreach (var root in ReferenceRootFiles) { <option value="@root.Id">@root.RelativePath</option> }
                                </select>
                            </label>
                            @if (_assistance is { } assistance) { <AuthoringAssistPanel Session="@assistance" /> }
                        </details>
                        <div class="source-pdf-navigation" aria-label="Source and PDF navigation">
                            <button type="button" data-testid="source-go-to-pdf" disabled="@(!CanMapNavigate || _syncBusy)" @onclick="GoToPdfAsync">Go to PDF</button>
                            <span role="status" data-testid="source-map-status">@_syncStatus</span>
                            @if (_syncResult is { } mapped && _syncNavigation.IsCurrent(mapped))
                            {
                                @for (int i = 0; i < mapped.Matches.Length; i++)
                                {
                                    int matchIndex = i;
                                    var match = mapped.Matches[i];
                                    <button type="button" data-testid="source-map-match" @onclick="() => ActivateSyncMatchAsync(mapped, matchIndex)">@match.File.RelativePath:@match.Line — PDF page @match.Page</button>
                                }
                                @if (mapped.Truncated) { <small>Additional native matches were omitted.</small> }
                            }
                        </div>
                        <label class="sr-only" for="editor">Source for @active.RelativePath</label>
                        <div class="source-editor-shell" data-testid="source-editor-shell">
                            <SourceHighlightLayer Source="@active.Content" FileIdentity="@active.Id.ToString()"
                                Revision="@Coordinator.WorkingGeneration.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                ReadOnly="@Coordinator.IsReadOnly" />
                            <textarea id="editor" @bind="ActiveContent" @bind:event="oninput"
                                  disabled="@Coordinator.IsReadOnly"
                                  data-file-id="@active.Id.ToString()"
                                  data-highlight-revision="@Coordinator.WorkingGeneration.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  @onselect="AssistanceEditorIntentChanged" @onkeydown="AssistanceEditorIntentChanged"
                                  @onkeyup="AssistanceEditorIntentChanged" @onpointerup="AssistanceEditorIntentChanged"
                                  data-testid="editor" @ref="_editorRef" spellcheck="false" wrap="off"></textarea>
                        </div>
                    }
                }
                else
                {
                    <div class="editor-empty">
                        <span class="eyebrow">Source editor</span><h2>No file selected</h2>
                        @if (_articleStarter?.Capture() is { } starter)
                        {
                            <p>Create an editable <code>main.tex</code> to begin. Compiling requires separately installed supported compiler resources.</p>
                            <button type="button" data-testid="starter-article" @onclick="() => StartBlankArticle(starter)">Start a blank article</button>
                        }
                        <p>Select a project file, or use <strong>New file</strong> or <strong>Import file</strong> on the left to begin.</p>
                        @if (_starterStatus is not null)
                        {
                            <p role="status" data-testid="starter-status">@_starterStatus</p>
                        }
                    </div>
                }
            </div>

            <CompilePanel SourceLineRequested="OnCompilerSourceNavigateAsync" SourceNavigationStatus="@_compilerSourceStatus"
                SourceMappingAvailable="@CanMapNavigate" SourcePointRequested="OnPdfPointAsync" MapNavigationStatus="@_syncStatus"
                SourceMatch="@CurrentSyncMatch" SourceMatchPdfHash="@(_syncResult?.Output.OutputHash?.Hex)" />

        </div>

        <div class="secondary-tools" aria-label="Project tools">
            <details class="tool-disclosure history-panel" data-testid="source-history-disclosure">
                <summary>Source history <span>Compare &amp; restore</span></summary>
                <div class="tool-content">
                @if (_history.Count == 0)
                {
                    <p class="hint">No checkpoints yet. Save or import to record history.</p>
                }
                else
                {
                    <ul class="history-list" data-testid="history-list">
                        @foreach (var cp in _history)
                        {
                            var cpId = cp.Id;
                            <li class="@(SelectedHistoryId == cpId ? "selected" : "")">
                                <button class="history-link" @onclick='() => SelectHistoryAsync(cpId)'
                                        data-testid="select-history">
                                    @cp.Reason
                                    <span class="meta">@cp.CreatedAt.ToLocalTime().ToString("g")</span>
                                </button>
                            </li>
                        }
                    </ul>
                    @if (_historyNextCursor is not null)
                    {
                        <button @onclick="LoadMoreHistoryAsync" data-testid="history-more">More…</button>
                    }
                }

                @if (_comparison is { } comp)
                {
                    <section class="comparison" data-testid="comparison">
                        <h3>Changes vs current head</h3>
                        @if (comp.DiffBudgetExceeded)
                        {
                            <p class="hint">Detailed diff budget exceeded; showing summary.</p>
                        }
                        <ul class="changes">
                            @foreach (var c in comp.Changes.Where(c => c.Kind != FileChangeKind.Unchanged))
                            {
                                <li data-testid="file-change" data-kind="@c.Kind">
                                    <span class="change-kind">@c.Kind</span>
                                    <span class="change-path">@c.Path</span>
                                    @if (c.OldPath is { } op && op != c.Path)
                                    {
                                        <span class="change-oldpath">(was @op)</span>
                                    }
                                    <span class="change-meta">
                                        @(c.OldLength)→@(c.NewLength) bytes
                                    </span>
                                </li>
                            }
                            @if (!comp.Changes.Any(c => c.Kind != FileChangeKind.Unchanged))
                            {
                                <li data-testid="no-changes">No changes.</li>
                            }
                        </ul>
                        @if (_selectedDiff is { } diff && diff.Count > 0)
                        {
                            <details class="diff" data-testid="diff-detail">
                                <summary>Diff for @_selectedDiffPath</summary>
                                <pre class="diff-output">
@foreach (var line in diff)
{
    var cls = line.Op == DiffOp.Insert ? "diff-add" : line.Op == DiffOp.Delete ? "diff-del" : "diff-eq";
<text><span class="@cls">@line.Op @line.Text</span>
</text>
}
