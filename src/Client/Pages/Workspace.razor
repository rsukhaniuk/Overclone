    private async Task LoadHistoryAsync(bool first)
    {
        if (Coordinator.Project is null) return;
        if (first)
        {
            _history.Clear();
            _historyNextCursor = null;
        }
        var page = await Coordinator.ReadHistoryAsync(Coordinator.Project.Id,
            _historyNextCursor is null ? null : new HistoryCursor(_historyNextCursor),
            System.Threading.CancellationToken.None);
        _history.AddRange(page.Checkpoints);
        _historyNextCursor = page.NextCursor;
    }

    private async Task LoadMoreHistoryAsync()
    {
        await LoadHistoryAsync(first: false);
        StateHasChanged();
    }

    private async Task SelectHistoryAsync(CheckpointId id)
    {
        SelectedHistoryId = id;
        _restoreError = null;
        if (Coordinator.Project is null) return;
        var cp = _history.FirstOrDefault(c => c.Id == id);
        if (cp is null) return;
        try
        {
            _restorePreview = await Coordinator.CaptureRestorePreviewAsync(cp.RevisionId, System.Threading.CancellationToken.None);
            _comparison = _restorePreview.Summary;
            // Pick the first content-changed text file for an optional detailed diff.
            var changed = _comparison.Changes.FirstOrDefault(c =>
                c.Kind == FileChangeKind.ContentChanged && c.Diff is not null);
            if (changed is { } ch && ch.Diff is { } d)
            {
                _selectedDiff = d;
                _selectedDiffPath = ch.Path;
            }
            else
            {
                _selectedDiff = null;
                _selectedDiffPath = "";
            }
        }
        catch (System.Exception ex)
        {
            _restoreError = ex.Message;
            _comparison = null;
            _restorePreview = null;
        }
        StateHasChanged();
    }

    private async Task AcceptRestoreAsync()
    {
        if (_restorePreview is null) return;
        var result = await Coordinator.AcceptRestoreAsync(_restorePreview, System.Threading.CancellationToken.None);
        if (result.Status == CommitStatus.Saved)
        {
            _restoreError = null;
            _comparison = null;
            _restorePreview = null;
            SelectedHistoryId = null;
            await LoadHistoryAsync(first: true);
        }
        else
        {
            _restoreError = result.SafeMessage ?? result.ErrorCode ?? "Restore failed.";
            // The preview is stale; clear it so the user re-captures.
            _restorePreview = null;
            _comparison = null;
        }
        StateHasChanged();
    }

