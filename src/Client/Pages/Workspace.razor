    }
    private async Task InsertCompletionAsync(CommandCompletionSession.Proposal proposal, string commandId)
    {
        if (_sourceBusy || _pageDisposed || _completions?.IsCurrent(proposal, _sourceIntent) != true || _navCts is null) return;
        // Reuse the proposal's still-current intent/token, never recapture a new
        // navigation/project/caret for a captured old Insert button.
        var ct = _navCts.Token; var owner = new object(); var request = proposal.Request;
        _sourceOperation = owner; _completionOperation = owner; _completionState = "reading";
        try
        {
            if (!CompletionCurrent(owner, request, ct)) return;
            var module = await GetEditorSelectAsync(System.Threading.CancellationToken.None);
            if (!CompletionCurrent(owner, request, ct)) return;
            if (module is null) { _completionState = "unavailable"; _completions.Clear(); return; }
            var snapshot = request.Snapshot;
            var dom = await module.InvokeAsync<SourceDomRange?>("readSelection", _editorRef,
                snapshot.File.ToString(), SourceTools.TextareaText(snapshot.Text));
            if (!CompletionCurrent(owner, request, ct)) return;
            if (dom is not { Start: { } start, End: { } end } || new SourceRange(start, end) != proposal.DomCaret)
            { InvalidateCompletion(); return; }
            var edit = _completions.Consume(proposal, commandId, new(start, end), _sourceIntent, SourceByteBudget(snapshot));
