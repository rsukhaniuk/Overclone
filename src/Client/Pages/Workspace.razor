        _singleFileImport = new(Coordinator, StarterLocks, action => InvokeAsync(action), selected: SelectFile);
        _singleFileImport.Changed += SingleFileImportChanged;
        // Subscribe BEFORE the first await so no coordinator Changed event is
        // missed. The handler marshals through InvokeAsync and reads the
        // CURRENT coordinator.State (never a stale event argument).
        _compilerSource = new(Coordinator, CompileSession);
        _syncNavigation = new(Coordinator, CompileSession, SourceMapQueries);
        Coordinator.WorkspaceChanged += CompilerSourceAuthorityChanged;
        CompileSession.Changed += CompilerSourceAuthorityChanged;
        AnalysisCoord.Changed += OnAnalysisChanged;
        ReviewService.Changed += OnReviewChanged;
        _reviewSession = Coordinator.SessionId;
        await Coordinator.LoadCapabilitiesAsync(System.Threading.CancellationToken.None);
        _folderCap = await Folders.GetCapabilitiesAsync(System.Threading.CancellationToken.None);
        await RefreshProjectsAsync();
        // Entering an already-open project (e.g. navigating back to this page
        // without closing): request a fresh analysis. Opening a project from
        // the list raises WorkspaceChanged and the coordinator schedules
        // automatically, so this only matters for the remount-while-open case.
        if (Coordinator.IsOpen)
            AnalysisCoord.RequestReanalyze();
    }

    private void OnAnalysisChanged(AnalysisState state)
    {
        // Marshal onto the renderer and READ the current coordinator.State
        // (the argument is intentionally unused: a queued render must not
        // repaint an old event after a newer state became current). Observe
        // async handler failures so a faulting callback is never unobserved.
        _ = state; // discard the event argument; the render reads current State
        _ = InvokeAsync(RenderAnalysisState).ContinueWith(ObserveTaskFault, TaskScheduler.Default);
    }

    private void RenderAnalysisState()
    {
        if (_pageDisposed) return;
        StateHasChanged();
    }

    private static void ObserveTaskFault(System.Threading.Tasks.Task t)
    {
        if (t.IsFaulted) { var ex = t.Exception; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await AssistanceAfterRenderAsync();
        if (firstRender)
        {
            // Subscribe to the service-worker warm-result readiness event so the
            // page can show a C#-owned provisioning/incomplete notice when a
            // required offline asset could not be cached. The glue module only
            // forwards the readiness state; it never decides the message.
            // Post-await page-lifetime checks: a late import must not attach a
            // dead page/ref, and refs arriving late are cleaned up exactly
            // once (never assigned into a dead page).
            if (_offlineReadinessRef is null && !_pageDisposed)
            {
                var refObj = DotNetObjectReference.Create(this);
                try
                {
                    // Import the tiny event-glue module and call its subscribe
                    // export on the module ref (ES module exports are not on
                    // window). The module only forwards the readiness state.
                    var mod = await JS.InvokeAsync<IJSObjectReference>("import", "./js/offline-readiness.js");
                    if (_pageDisposed)
                    {
                        // Page disposed during the import: clean up the module
                        // exactly once and do NOT subscribe a dead page.
                        try { await mod.DisposeAsync(); } catch (JSException) { /* best-effort */ }
                        refObj.Dispose();
                        return;
                    }
                    var subId = await mod.InvokeAsync<string>("subscribeOfflineReadiness", refObj);
                    if (_pageDisposed)
                    {
                        // Page disposed during subscribe: the sink was installed,
                        // so unsubscribe (clears it only if still this one) then drop.
                        try { await mod.InvokeVoidAsync("unsubscribeOfflineReadiness", subId); } catch (JSException) { /* best-effort */ }
                        try { await mod.DisposeAsync(); } catch (JSException) { /* best-effort */ }
                        refObj.Dispose();
                        return;
                    }
                    _offlineReadinessModule = mod;
                    _offlineReadinessRef = refObj;
                    _offlineReadinessSubId = subId;
                }
                catch (JSException)
                {
                    // Offline readiness is best-effort: editing/saving stay
                    // available regardless. Drop the refs so dispose is clean.
                    _offlineReadinessModule = null;
                    _offlineReadinessRef = null;
                    _offlineReadinessSubId = null;
                    refObj.Dispose();
                }
            }
            return;
        }

        // Apply a pending cross-file selection once the target textarea has
        // rendered (no Task.Delay/Task.Run render guessing). SelectFile does
        // not bump generation, so this never invalidates the report. The pending
        // selection carries the navigation intent token; a newer click or page
        // dispose cancels it before the (possibly stale) application runs.
        if (_sourceSelection is { } sourceSelection)
        {
            _sourceSelection = null;
            bool completion = ReferenceEquals(_completionOperation, sourceSelection.Owner);
            if (completion) _completionSelecting = sourceSelection.Owner;
            try
            {
                bool selected = await SelectSourceToolAsync(sourceSelection.Snapshot, sourceSelection.Range, false, sourceSelection.Token, sourceSelection.Owner);
                if (completion && CompletionOwns(sourceSelection.Owner, sourceSelection.Token) && sourceSelection.Snapshot.Intent == _sourceIntent)
                    _completionState = selected ? "applied" : "stale";
            }
            catch (Exception error) when (error is JSException || completion && error is (System.Text.Json.JsonException or System.OperationCanceledException or ObjectDisposedException))
            {
                if (SourceOperationCurrent(sourceSelection.Owner, sourceSelection.Snapshot, sourceSelection.Token, true))
                {
                    _sourceStatus = "Text edited; selection could not be restored.";
                    if (completion) _completionState = "stale";
                }
            }
            finally
            {
                if (ReferenceEquals(_completionSelecting, sourceSelection.Owner)) _completionSelecting = null;
                bool finished = FinishSourceOperation(sourceSelection.Owner);
                bool retired = RetireCompletion(sourceSelection.Owner);
                // A superseded operation may only release its own admission;
                // current view still needs the now-enabled controls rendered.
                if ((finished || retired) && !_pageDisposed) StateHasChanged();
            }
        }
        if (_pendingCompilerSource is { } compilerSource)
        {
            _pendingCompilerSource = null;
            await ApplyCompilerSourceSelectionAsync(compilerSource, _pendingCompilerSourceCt);
        }
        if (_pendingSyncSource is { } mappedSource)
        {
            _pendingSyncSource = null;
            await ApplySyncSourceAsync(mappedSource, _pendingSyncSourceCt);
        }
        if (_pendingProjectSearch is { } search)
        {
            _pendingProjectSearch = null;
            await ApplyProjectSearchSelectionAsync(search, _pendingProjectSearchCt);
        }
        if (_pendingSelect is { } sel && Coordinator.ActiveFileId == sel.FileId)
        {
            _pendingSelect = null;
            var ct = _pendingSelectCt;
            await ApplySelectionAsync(sel, ct);
        }
    }

    [JSInvokable]
    public async Task OnOfflineReadiness(string state)
    {
        // C# owns the visible message; JS only reports the readiness state
        // ("unknown" | "ready" | "incomplete"). Show an actionable notice ONLY
        // when warming finished incomplete — not during normal startup.
        _offlineReadinessNotice = state == "incomplete"
            ? "Offline analysis is not fully provisioned: a required asset could not be cached. Connect to the network and reload to retry. Editing and saving remain available."
            : null;
        if (!_pageDisposed)
            await InvokeAsync(StateHasChanged);
    }

