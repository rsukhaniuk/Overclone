    private System.Threading.CancellationToken NavCancelAndStart()
    {
        // Cancel any in-flight navigation intent (an older click still awaiting
        // the worker epoch or DOM module) before starting a new one, so the
        // older callback cannot later activate/select a stale file.
        _navCts?.Cancel();
        _navCts?.Dispose();
        _navCts = new System.Threading.CancellationTokenSource();
        return _navCts.Token;
    }

    private async Task OnFindingClickAsync(AnalysisEngineDiagnosticDto diag)
    {
        if (AnalysisCurrentReport is not { } report)
        {
            _navNotice = "Run analysis to see this diagnostic.";
            StateHasChanged();
            return;
        }
        var ct = NavCancelAndStart();
        _navNotice = null;
        NavigationResult result;
        try { result = await Navigator.NavigateAsync(report, diag, ct); }
        catch (System.OperationCanceledException) { return; }
        catch (System.Exception)
        {
            if (!_pageDisposed && !ct.IsCancellationRequested)
            { _navNotice = "Analysis could not navigate to this diagnostic; run analysis again."; StateHasChanged(); }
            return;
        }
        if (ct.IsCancellationRequested || _pageDisposed) return;

        switch (result)
        {
            case NavigationResult.Selected s:
                if (Coordinator.ActiveFileId == s.FileId)
                {
                    // Already active: validate the existing DOM value BEFORE an
                    // unnecessary rerender can overwrite a DOM-only mismatch.
                    await ApplySelectionAsync(s, ct);
                }
                else
                {
                    // Switch files: SelectFile + render, then OnAfterRenderAsync
                    // applies the selection once the target textarea has rendered.
                    if (!Coordinator.SelectFile(s.FileId))
                    {
                        if (!ct.IsCancellationRequested && !_pageDisposed)
                        { _navNotice = "The diagnostic's file is no longer open."; StateHasChanged(); }
                        return;
                    }
                    if (ct.IsCancellationRequested || _pageDisposed) return;
                    _pendingSelect = s;
                    _pendingSelectCt = ct;
                    StateHasChanged();
                }
                break;
            case NavigationResult.NonSelectable ns:
                _navNotice = ns.Display;
                if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
                break;
            case NavigationResult.Rejected r:
                _navNotice = r.Reason;
                if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
                break;
        }
    }

    private async Task ApplySelectionAsync(NavigationResult.Selected s, System.Threading.CancellationToken ct)
    {
        // Check after EVERY await: a newer navigation, a page dispose, or an
        // edit/close/worker-reset during any await must prevent a stale
        // selection. The JS module then atomically verifies the DOM
        // (data-file-id + live value) in the SAME call as focus/setSelectionRange.
        if (_pageDisposed || ct.IsCancellationRequested) return;

        // Load/import the DOM module FIRST (shared single-flight import). A late
        // module arriving after page dispose is disposed, not assigned into a
        // dead page.
        var mod = await GetEditorSelectAsync(ct);
        if (ct.IsCancellationRequested || _pageDisposed) return;
        if (mod is null)
        {
            _navNotice = "Could not load the editor selection module; run analysis again.";
            if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
            return;
        }

        // Final AWAITED verification: report reference + workspace identity +
        // worker epoch, checked before AND after the epoch query. This re-runs
        // the worker-epoch check that NavigateAsync already did — an edit/close/
        // reset during the module import/render is caught here.
        var v = await Navigator.VerifyCurrentAsync(s.Report, ct);
        if (ct.IsCancellationRequested || _pageDisposed) return;
        if (!v.Ok)
        {
            _navNotice = v.Reason ?? "This analysis is no longer current; run analysis again.";
            if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
            return;
        }

        // Synchronous final checks IMMEDIATELY before the final DOM call (no
        // unrelated await between these and trySelect): page lifetime, intent,
        // report currency, and the target file is the active file.
        if (_pageDisposed || ct.IsCancellationRequested) return;
        if (!Navigator.IsStillCurrent(s.Report))
        {
            _navNotice = "The workspace changed since this analysis; run analysis again.";
            if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
            return;
        }
        if (Coordinator.ActiveFileId != s.FileId)
        {
            _navNotice = "The target file is not active; run analysis again.";
            if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
            return;
        }

        try
        {
            var ok = await mod.InvokeAsync<bool>("trySelect", _editorRef, s.FileId.ToString(), s.ExpectedTextareaText, s.TextareaStart, s.TextareaEnd);
            if (ct.IsCancellationRequested || _pageDisposed) return;
            _navNotice = ok ? null : "The editor no longer matches the analyzed source; run analysis again.";
        }
        catch (JSException)
        {
            if (ct.IsCancellationRequested || _pageDisposed) return;
            _navNotice = "Could not select the diagnostic location; run analysis again.";
        }
        if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
    }

    private async System.Threading.Tasks.Task<IJSObjectReference?> GetEditorSelectAsync(System.Threading.CancellationToken ct)
    {
        if (_pageDisposed) return null;
        // Single-flight shared import: the FIRST caller assigns the import Task
        // synchronously (before awaiting), so a concurrent second navigation
        // reuses the SAME Task — no duplicate module refs leak on rapid clicks.
        var t = _editorSelectTask;
        if (t is null)
            t = _editorSelectTask = JS.InvokeAsync<IJSObjectReference>("import", "./js/editor-select.js").AsTask();
        // Per-caller WaitAsync(ct): a navigation's cancellation finishes promptly
        // WITHOUT canceling the shared import Task (a newer click reuses it).
        try { return await t.WaitAsync(ct).ConfigureAwait(false); }
        catch (System.OperationCanceledException) { return null; } // per-caller cancel; do NOT fault the shared task
        catch (JSException)
        {
            // Genuine interop fault: clear the shared task BY IDENTITY so a
            // later caller retries, but an old failed/canceled import cannot
            // clear a newer cached import (different task).
            if (System.Threading.Tasks.Task<IJSObjectReference>.ReferenceEquals(_editorSelectTask, t)) _editorSelectTask = null;
            return null;
        }
    }

    private void ScheduleAutosave()
    {
        CancelAutosave();
        if (_pageDisposed || Coordinator.Project is not { } project) return;
        var session = Coordinator.SessionId;
        var timer = _autosaveCts = new System.Threading.CancellationTokenSource();
        var token = timer.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(2), token);
                await InvokeAsync(async () =>
                {
                    // A cancelled debounce can already be queued on the renderer.
                    // Never let an old page/timer save whichever project is open.
                    if (_pageDisposed || token.IsCancellationRequested || !ReferenceEquals(_autosaveCts, timer)
                        || Coordinator.SessionId != session || Coordinator.Project?.Id != project.Id) return;
                    await Coordinator.SaveSessionAsync(project.Id, session, token);
                    if (!_pageDisposed && Coordinator.SessionId == session && Coordinator.Project?.Id == project.Id)
                        StateHasChanged();
                });
            }
            catch (System.OperationCanceledException) { /* debounce/page/session superseded; no retry loop */ }
        });
    }

    private void CancelAutosave()
    {
        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();
        _autosaveCts = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_pageDisposed) return; // idempotent
        _pageDisposed = true;
        // 1. SYNCHRONOUS, bounded teardown FIRST: unsubscribe events and
        //    cancel analysis/nav/autosave, and release owned refs — BEFORE any
        //    await that could be unbounded (a blocked editor-module import).
        //    Never dispose the injected AnalysisCoordinator/ISourceAnalyzer:
        //    DI owns them (scoped = app lifetime in WASM); returning to this
        //    page must reuse the same coordinator.
        AnalysisCoord.Changed -= OnAnalysisChanged;
        ReviewService.Changed -= OnReviewChanged;
        _reviewIntent++;
        _reviewCts?.Cancel();
        ReviewService.Cancel(); // cancel page work, never dispose the scoped service or erase accepted recovery
        AnalysisCoord.Cancel();
        _pendingSelect = null;
        _navCts?.Cancel();
        _navCts?.Dispose();
        _navCts = null;
        CancelAutosave();
        // Unsubscribe the readiness callback BEFORE disposing the DotNet ref
        // (so no .NET callback fires after the ref is gone). The JS glue
        // clears the sink only if it is still owned by THIS subscription.
        var readinessSubId = _offlineReadinessSubId;
        var readinessMod = _offlineReadinessModule;
        _offlineReadinessSubId = null;
        _offlineReadinessModule = null;
        var refObj = _offlineReadinessRef;
        _offlineReadinessRef = null;
        if (readinessMod is not null && readinessSubId is not null)
        {
            try { await readinessMod.InvokeVoidAsync("unsubscribeOfflineReadiness", readinessSubId); }
            catch (JSException) { /* best-effort */ }
        }
        refObj?.Dispose();
        // 2. Editor-select module: do NOT await an in-flight import in the dispose
        //    path (it could be blocked forever, e.g. a held route in tests or a
        //    network stall). Snapshot the task BY IDENTITY and attach an OBSERVED
        //    eventual-cleanup task that disposes the late module exactly once —
        //    without reviving the page, selecting/activating anything, or calling
        //    StateHasChanged. A newer page's import is a DIFFERENT task, so an
        //    old failed/canceled import cannot clear it.
        var modTask = _editorSelectTask;
        _editorSelectTask = null;
        if (modTask is not null)
            _ = DisposeEditorSelectLaterAsync(modTask);
        // 3. Dispose the readiness module ref (already imported; bounded await).
        if (readinessMod is not null)
        {
            try { await readinessMod.DisposeAsync(); } catch (JSException) { /* best-effort */ }
        }
        await ValueTask.CompletedTask;
    }

    private async System.Threading.Tasks.Task DisposeEditorSelectLaterAsync(
        System.Threading.Tasks.Task<IJSObjectReference> modTask)
    {
        // Observed eventual cleanup: dispose the late module exactly once. The
        // captured modTask is this page's import (identity); a newer page's
        // import is a different task and is unaffected. Never selects/activates
        // or revives the page; no StateHasChanged. All exceptions are caught so
        // the task never faults (no unobserved exception).
        try
        {
            var m = await modTask.ConfigureAwait(false);
            await m.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSException) { /* best-effort teardown */ }
        catch (System.OperationCanceledException) { /* best-effort */ }
    }
}
