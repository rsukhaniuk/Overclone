                <button @onclick="CancelAnalysis" data-testid="cancel-analysis">Cancel</button>
            </div>
            <p class="analysis-status-line @AnalysisStatusClass" role="status" aria-live="polite"
               data-testid="analysis-status">@AnalysisStatusText</p>
            @if (AnalysisCurrentReport is { } report)
            {
                @if (IsIncomplete(report))
                {
                    <p class="hint analysis-incomplete" data-testid="analysis-incomplete">
                        This analysis is incomplete: some files could not be fully scanned. Known findings are shown below; do not treat them as a complete check or as document correctness.
                    </p>
                }
                @if (report.Result.Profile.Id == AnalysisCatalog.ReferenceId)
                { <ReferenceChecksView Report="report" /> }
                <section class="analysis-findings" aria-label="Engine checks">
                    <h3>Engine checks</h3>
                    <p data-testid="engine-outcome">Independent lexical engine outcome: @EngineOutcome(report).</p>
                    @if (!report.Result.Diagnostics.Any(d => d.Origin == "engine") && !IsIncomplete(report))
                    {
                        <p class="hint" data-testid="analysis-pass">No engine-check findings in the supported lexical subset. This is not a document-correctness or compliance claim.</p>
                    }
                    else
                    {
                        <ul class="finding-list" data-testid="finding-list">
                            @foreach (var d in report.Result.Diagnostics.Where(d => d.Origin == "engine"))
                            {
                                <li class="finding" data-testid="analysis-finding" data-origin="engine"
                                    data-diag-id="@d.Id" data-snapshot-id="@report.Snapshot.Id.ToString()"
                                    data-epoch="@report.WorkerEpoch">
                                    <button class="finding-link" @onclick='() => OnFindingClickAsync(report, d)'
                                            data-testid="finding-link"
                                            aria-label='Open diagnostic @d.RuleId'>
                                        <span class="finding-severity severity-@d.Severity">@d.Severity</span>
                                        <span class="finding-rule">@d.RuleId</span>
                                        <span class="finding-file">@FileLabel(report, d.FileId)</span>
                                        <span class="finding-msg">@d.Message</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    @if (report.Result.Coverage.Unsupported.Count > 0 || report.Snapshot.Excluded.Length > 0)
                    {
                        <section class="analysis-unsupported" data-testid="analysis-unsupported">
                            <h4>Unsupported (not implemented)</h4>
                            <p class="hint">These are recorded as not implemented; absence is not compliance.</p>
                            <ul>
                                @foreach (var u in report.Result.Coverage.Unsupported)
                                { <li>@u</li> }
                                @foreach (var x in report.Snapshot.Excluded)
                                { <li data-testid="analysis-excluded">@x.RelativePath — @x.Reason</li> }
                            </ul>
                        </section>
                    }
                    @if (report.Result.UnavailableCapabilities.Count > 0)
                    {
                        <section class="analysis-unavailable" data-testid="analysis-unavailable">
                            <h4>Unavailable</h4>
                            <p class="hint">These checks require a capability this build does not have. PDF facts and rendered PDF checks are unavailable; source observations do not measure rendered layout.</p>
                            <ul>
                                @foreach (var u in report.Result.UnavailableCapabilities)
                                { <li>@u</li> }
                            </ul>
                        </section>
                    }
                </section>
                @if (report.Result.Knu is not null)
                { <KnuReportView Report="report" FindingSelected="@(d => OnFindingClickAsync(report, d))" FixRequested="PreviewFixAsync" ReviewWorking="@(_reviewPending || CurrentReview.Busy)" /> }
            }
            @if (!string.IsNullOrEmpty(_navNotice))
            {
                <p class="hint nav-notice" role="status" data-testid="nav-notice">@_navNotice</p>
            }
        </section>
        </details>
        <details class="tool-disclosure review-disclosure" data-testid="review-disclosure"
                 open="@(_reviewPending || CurrentReview.Busy || CurrentReview.Preview is not null || CurrentReview.Action is not null || CurrentReview.Notice is not null || !string.IsNullOrEmpty(_reviewNotice))">
            <summary>Review <span>Preview &amp; accept edits</span></summary>
            <ReviewPanel State="CurrentReview" Writable="ReviewWritable" Working="_reviewPending" Notice="@_reviewNotice"
                         Accept="AcceptReviewAsync" Decline="DeclineReview" Retry="RetryReviewAsync" Undo="UndoReviewAsync" Cancel="CancelReview" />
        </details>
        <details class="tool-disclosure" data-testid="ai-disclosure">
            <summary>AI assistance</summary>
            <div class="tool-content"><AiPanel /></div>
        </details>
        </div>
    </section>
}

<details class="tool-disclosure drive-disclosure" id="@(Coordinator.IsOpen ? null : "dashboard-drive")" data-testid="drive-disclosure">
    <summary>Google Drive <span>Import &amp; export</span></summary>
    <div class="tool-content"><DriveTransferPanel Imported="@(_ => RefreshProjectsAsync())" /></div>
</details>
