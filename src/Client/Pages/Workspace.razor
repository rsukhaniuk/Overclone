@page "/"
@inject WorkspaceCoordinator Coordinator
@inject IProjectTransfer Transfer
@inject FolderTransferService Folders
@inject AnalysisCoordinator AnalysisCoord
@inject SourceNavigator Navigator
@using Client.Review
@inject IChangeReviewService ReviewService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Document workspace</PageTitle>

@if (Coordinator.Capabilities is { } caps && (!caps.Opfs || !caps.IndexedDb))
{
    <div class="banner banner-error" role="alert">
        This browser cannot store documents offline: OPFS or IndexedDB is unavailable.
        Editing is disabled. Use desktop Chrome or Edge.
    </div>
}

@if (!string.IsNullOrEmpty(_offlineReadinessNotice))
{
    <div class="banner banner-warn" role="status" data-testid="offline-readiness-notice">
        @_offlineReadinessNotice
    </div>
}

@if (!Coordinator.IsOpen)
{
    <section class="panel" aria-label="Projects">
        <h1>Projects</h1>
        <p class="hint">Local projects are stored in this browser (OPFS + IndexedDB). They survive
            closing the browser and work offline after provisioning.</p>

        <div class="transfer-bar">
            <form @onsubmit="@(async () => await CreateProjectAsync())" @onsubmit:preventDefault>
                <label for="new-project">New project name</label>
                <input id="new-project" @bind="_newProjectName" @bind:event="oninput"
                       placeholder="e.g. Diploma 2026" autocomplete="off" />
                <button type="submit">Create project</button>
            </form>
            <span class="transfer-sep">or import:</span>
            <InputFile OnChange="OnImportZip" accept=".zip"
                       data-testid="import-zip" />
            <button @onclick="OnImportFolder" data-testid="import-folder"
                    disabled="@( !_folderCap.Picker)">Import folder</button>
        </div>

        @if (_staged is { } staged)
        {
            <section class="staged-preview" data-testid="import-preview">
                <h2>Import preview</h2>
                <label for="staged-name">Project name</label>
                <input id="staged-name" @bind="_stagedName" @bind:event="oninput"
                       data-testid="staged-name" autocomplete="off" />
                @if (_stagedExcluded.Count > 0)
                {
                    <p class="hint">Excluded trees: @string.Join(", ", _stagedExcluded)</p>
                }
                @if (staged.ValidationErrors.Count > 0)
                {
                    <ul class="validation-errors" data-testid="validation-errors">
                        @foreach (var e in staged.ValidationErrors)
                        {
                            <li data-testid="validation-error">
                                <code>@(e.RelativePath.Length == 0 ? "(archive)" : e.RelativePath)</code>
                                — @e.Code: @e.Message
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="hint">@(staged.Files.Length) file(s):</p>
                    <ul class="staged-files">
                        @foreach (var f in staged.Files)
                        {
                            <li>
                                <span class="kind @(f.MediaKind == "binary" ? "bin" : "text")">[@f.MediaKind]</span>
                                <span class="path">@f.RelativePath</span>
                                <span class="meta">@f.ByteLength bytes@(f.HasBom ? ", BOM" : "")</span>
                            </li>
                        }
                    </ul>
                }
                <div class="actions">
                    <button @onclick="PublishStagedAsync" data-testid="publish-import"
                            disabled="@(staged.ValidationErrors.Count > 0)">Publish as new project</button>
                    <button class="muted" @onclick="CancelStaged" data-testid="cancel-import">Cancel</button>
                </div>
            </section>
        }

        @if (_projects.Count == 0)
        {
            <p role="status">No local projects yet. Create one or import a ZIP/folder to start editing.</p>
        }
        else
        {
            <ul class="project-list">
                @foreach (var p in _projects)
                {
                    <li data-testid="project-row" data-name="@p.Name">
                        <span class="project-name">@p.Name</span>
                        <span class="project-meta">@((p.HeadRevisionId is null ? "empty" : "1+ revisions"))</span>
                        <button @onclick='() => OpenProjectAsync(p.Id)' data-testid="open-project">Open</button>
                        <button class="danger" @onclick='() => DeleteProjectAsync(p.Id)'
                                aria-label='Delete project @p.Name'>Delete</button>
                    </li>
                }
            </ul>
        }
    </section>
}
else
{
    <section class="panel workspace" aria-label="Workspace @Coordinator.Project?.Name">
        <header class="workspace-header">
            <div class="title-block">
                <h1>@Coordinator.Project?.Name</h1>
                <p class="status @StatusClass" role="status" aria-live="polite">@StatusText</p>
            </div>
            <div class="actions">
                <button @onclick="SaveAsync" disabled="@SaveDisabled" data-testid="save">
                    @(Coordinator.SavePhase == SavePhase.Saving ? "Saving…" : "Save")
                </button>
                <button @onclick="ExportZipAsync" data-testid="export-zip">Export ZIP</button>
                <button @onclick="ExportFolderAsync" data-testid="export-folder"
                        disabled="@(!_folderCap.Writable)">Export to folder</button>
                <button @onclick="CloseAsync">Close</button>
            </div>
        </header>

        @if (Coordinator.IsReadOnly)
        {
            <div class="banner banner-readonly" role="alert">
                @if (Coordinator.Capabilities?.WebLocks == false)
                {
                    <span>Writer locks are unavailable in this browser; the project is read-only.</span>
                }
                else
                {
                    <span>Another tab is editing this project. Opened read-only.</span>
                    <button @onclick="TakeOverAsync" data-testid="takeover">Take over editing</button>
                }
            </div>
        }

        @if (Coordinator.Recovery is { } recovery)
        {
            <div class="banner banner-recovery" role="alert">
                <p>The project head could not be verified and may be damaged. Damaged data is
                    retained. Select a complete checkpoint to recover to:</p>
                @if (recovery.CompleteCheckpoints.Count == 0)
                {
                    <p>No complete checkpoints are available. Export any recoverable content and
                        start a new project.</p>
                }
                else
                {
                    <ul class="checkpoint-list">
                        @foreach (var cp in recovery.CompleteCheckpoints)
                        {
                            <li>
                                <span>@cp.Reason — @(cp.RevisionId.ToString().Substring(0, 8))</span>
                                <button @onclick='() => RecoverToAsync(cp.RevisionId)'
                                        data-testid="recover">Recover to this</button>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_transferStatus))
        {
            <p class="transfer-status @TransferStatusClass" role="status" aria-live="polite"
               data-testid="transfer-status">@_transferStatus</p>
        }

        <div class="workspace-body">
            <aside class="file-tree" aria-label="Files">
                <form @onsubmit="@(() => CreateFile())" @onsubmit:preventDefault>
                    <input @bind="_newFileName" @bind:event="oninput" placeholder="new file path"
                           autocomplete="off" data-testid="new-file-name" />
                    <button type="submit" data-testid="new-file">New file</button>
                </form>
                <div class="import">
                    <InputFile OnChange="OnImportFile" accept=".tex,.txt,.bib,.cls,.sty,.bst,.md,.json,.yaml,.yml,.csv,image/*,application/pdf"
                               data-testid="import-input" />
                </div>
                <ul class="files">
                    @foreach (var f in Coordinator.Files.Where(f => !f.Deleted))
                    {
                        var id = f.Id;
                        <li class="@(Coordinator.ActiveFileId == id ? "active" : "")">
                            <button class="file-link" @onclick='() => { SelectFile(id); }'
                                    data-testid="select-file">
                                <span class="kind @(f.MediaKind == "binary" ? "bin" : "text")">[@f.MediaKind]</span>
                                @f.RelativePath
                            </button>
                            @if (f.IsNew || f.DirtyContent || f.DirtyBinary || f.TreeChanged)
                            {
                                <span class="dirty-dot" aria-label="unsaved">●</span>
                            }
                            <button class="icon danger" @onclick='() => { DeleteFile(id); }'
                                    aria-label='Delete @f.RelativePath' data-testid="delete-file">✕</button>
                        </li>
                    }
                </ul>
            </aside>

            <div class="editor-area">
                @if (Coordinator.ActiveFile is { } active)
                {
                    <div class="editor-toolbar">
                        <label for="rename">@active.RelativePath</label>
                        <input id="rename" @bind="_renameTarget" @bind:event="oninput"
                               placeholder="rename to…" autocomplete="off" data-testid="rename-input" />
                        <button @onclick='() => { RenameFile(active.Id); }' data-testid="rename">Rename</button>
                        <button @onclick="DownloadFileAsync" data-testid="download">
                            Download@(active.MediaKind == "binary" ? " file" : " text")
                        </button>
                    </div>
                    @if (active.MediaKind == "binary")
                    {
                        <div class="binary-view" data-testid="binary-view">
                            <p>This file is binary and is not text-editable.</p>
                            <dl>
                                <dt>Path</dt><dd>@active.RelativePath</dd>
                                <dt>Size</dt><dd>@(active.DurableLength > 0 ? active.DurableLength : (active.BinaryContent?.Length ?? 0)) bytes</dd>
                                <dt>Type</dt><dd>@(active.DurableHash is null ? "new asset" : "stored asset")</dd>
                            </dl>
                            <button @onclick="DownloadFileAsync" data-testid="download-binary">Download</button>
                        </div>
                    }
                    else
                    {
                        <label class="sr-only" for="editor">Source for @active.RelativePath</label>
                        <textarea id="editor" @bind="ActiveContent" @bind:event="oninput"
                              disabled="@Coordinator.IsReadOnly"
                              data-file-id="@active.Id.ToString()"
                              data-testid="editor" @ref="_editorRef" spellcheck="false"></textarea>
                    }
                }
                else
                {
                    <p class="hint">Select a file or create one to start editing.</p>
                }
            </div>

            <aside class="history-panel" aria-label="History">
                <h2>History</h2>
                @if (_history.Count == 0)
                {
                    <p class="hint">No checkpoints yet. Save or import to record history.</p>
                }
                else
                {
                    <ul class="history-list" data-testid="history-list">
                        @foreach (var cp in _history)
                        {
                            var cpId = cp.Id;
                            <li class="@(SelectedHistoryId == cpId ? "selected" : "")">
                                <button class="history-link" @onclick='() => SelectHistoryAsync(cpId)'
                                        data-testid="select-history">
                                    @cp.Reason
                                    <span class="meta">@cp.CreatedAt.ToLocalTime().ToString("g")</span>
                                </button>
                            </li>
                        }
                    </ul>
                    @if (_historyNextCursor is not null)
                    {
                        <button @onclick="LoadMoreHistoryAsync" data-testid="history-more">More…</button>
                    }
                }

                @if (_comparison is { } comp)
                {
                    <section class="comparison" data-testid="comparison">
                        <h3>Changes vs current head</h3>
                        @if (comp.DiffBudgetExceeded)
                        {
                            <p class="hint">Detailed diff budget exceeded; showing summary.</p>
                        }
                        <ul class="changes">
                            @foreach (var c in comp.Changes.Where(c => c.Kind != FileChangeKind.Unchanged))
                            {
                                <li data-testid="file-change" data-kind="@c.Kind">
                                    <span class="change-kind">@c.Kind</span>
                                    <span class="change-path">@c.Path</span>
                                    @if (c.OldPath is { } op && op != c.Path)
                                    {
                                        <span class="change-oldpath">(was @op)</span>
                                    }
                                    <span class="change-meta">
                                        @(c.OldLength)→@(c.NewLength) bytes
                                    </span>
                                </li>
                            }
                            @if (!comp.Changes.Any(c => c.Kind != FileChangeKind.Unchanged))
                            {
                                <li data-testid="no-changes">No changes.</li>
                            }
                        </ul>
                        @if (_selectedDiff is { } diff && diff.Count > 0)
                        {
                            <details class="diff" data-testid="diff-detail">
                                <summary>Diff for @_selectedDiffPath</summary>
                                <pre class="diff-output">
@foreach (var line in diff)
{
    var cls = line.Op == DiffOp.Insert ? "diff-add" : line.Op == DiffOp.Delete ? "diff-del" : "diff-eq";
<text><span class="@cls">@line.Op @line.Text</span>
</text>
}
                                </pre>
                            </details>
                        }
                    </section>
                }
                @if (_restorePreview is not null || !string.IsNullOrEmpty(_restoreError))
                {
                    <section class="restore-actions" data-testid="restore-actions">
                        @if (_restorePreview is not null)
                        {
                            <div class="actions">
                                <button @onclick="AcceptRestoreAsync" data-testid="restore"
                                        disabled="@Coordinator.IsReadOnly">Restore this revision</button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_restoreError))
                        {
                            <p class="banner banner-error" role="alert" data-testid="restore-error">@_restoreError</p>
                        }
                    </section>
                }
            </aside>
        </div>

        <section class="analysis-panel" aria-label="Source analysis" data-testid="analysis-panel" data-generation="@Coordinator.WorkingGeneration" data-session="@Coordinator.SessionId" data-head="@Coordinator.CurrentRevision?.Id">
            <h2>@(AnalysisCoord.CurrentProfile.Id == AnalysisCatalog.KnuId ? "Source analysis" : "Engine analysis")</h2>
            <div class="analysis-controls">
                <label for="analysis-profile">Analysis profile</label>
                <select id="analysis-profile" data-testid="analysis-profile" value="@AnalysisCoord.CurrentProfile.Id" @onchange="ChangeAnalysisProfile">
                    <option value="engine-structural">Engine checks</option>
                    <option value="knu-csc-2025-source">KNU CSC 2025 source observations</option>
                </select>
                @if (AnalysisCoord.CurrentConfiguration is { } configuration)
                {
                    <label for="analysis-work-type">Work type</label>
                    <select id="analysis-work-type" data-testid="analysis-work-type" value="@AnalysisPresentation.WorkValue(configuration.WorkType)" @onchange="ChangeWorkType">
                        @foreach (var work in Enum.GetValues<AnalysisWorkType>())
                        { <option value="@AnalysisPresentation.WorkValue(work)">@AnalysisPresentation.WorkType(work)</option> }
                    </select>
                }
                <button @onclick="AnalyzeNowAsync" data-testid="analyze-now">Analyze now</button>
                <button @onclick="CancelAnalysis" data-testid="cancel-analysis">Cancel</button>
            </div>
            <p class="analysis-status-line @AnalysisStatusClass" role="status" aria-live="polite"
               data-testid="analysis-status">@AnalysisStatusText</p>
            @if (AnalysisCurrentReport is { } report)
            {
                @if (IsIncomplete(report))
                {
                    <p class="hint analysis-incomplete" data-testid="analysis-incomplete">
                        This analysis is incomplete: some files could not be fully scanned. Known findings are shown below; do not treat them as a complete check or as document correctness.
                    </p>
                }
                <section class="analysis-findings" aria-label="Engine checks">
                    <h3>Engine checks</h3>
                    <p data-testid="engine-outcome">Independent lexical engine outcome: @EngineOutcome(report).</p>
                    @if (!report.Result.Diagnostics.Any(d => d.Origin == "engine") && !IsIncomplete(report))
                    {
                        <p class="hint" data-testid="analysis-pass">No engine-check findings in the supported lexical subset. This is not a document-correctness or compliance claim.</p>
                    }
                    else
                    {
                        <ul class="finding-list" data-testid="finding-list">
                            @foreach (var d in report.Result.Diagnostics.Where(d => d.Origin == "engine"))
                            {
                                <li class="finding" data-testid="analysis-finding" data-origin="engine"
                                    data-diag-id="@d.Id" data-snapshot-id="@report.Snapshot.Id.ToString()"
                                    data-epoch="@report.WorkerEpoch">
                                    <button class="finding-link" @onclick='() => OnFindingClickAsync(d)'
                                            data-testid="finding-link"
                                            aria-label='Open diagnostic @d.RuleId'>
                                        <span class="finding-severity severity-@d.Severity">@d.Severity</span>
                                        <span class="finding-rule">@d.RuleId</span>
                                        <span class="finding-file">@FileLabel(report, d.FileId)</span>
                                        <span class="finding-msg">@d.Message</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    @if (report.Result.Coverage.Unsupported.Count > 0 || report.Snapshot.Excluded.Length > 0)
                    {
                        <section class="analysis-unsupported" data-testid="analysis-unsupported">
                            <h4>Unsupported (not implemented)</h4>
                            <p class="hint">These are recorded as not implemented; absence is not compliance.</p>
                            <ul>
                                @foreach (var u in report.Result.Coverage.Unsupported)
                                { <li>@u</li> }
                                @foreach (var x in report.Snapshot.Excluded)
                                { <li data-testid="analysis-excluded">@x.RelativePath — @x.Reason</li> }
                            </ul>
                        </section>
                    }
                    @if (report.Result.UnavailableCapabilities.Count > 0)
                    {
                        <section class="analysis-unavailable" data-testid="analysis-unavailable">
                            <h4>Unavailable</h4>
                            <p class="hint">These checks require a capability this build does not have. PDF facts and rendered PDF checks are unavailable; source observations do not measure rendered layout.</p>
                            <ul>
                                @foreach (var u in report.Result.UnavailableCapabilities)
                                { <li>@u</li> }
                            </ul>
                        </section>
                    }
                </section>
                @if (report.Result.Knu is not null)
                { <KnuReportView Report="report" FindingSelected="OnFindingClickAsync" FixRequested="PreviewFixAsync" ReviewWorking="@(_reviewPending || CurrentReview.Busy)" /> }
            }
            @if (!string.IsNullOrEmpty(_navNotice))
            {
                <p class="hint nav-notice" role="status" data-testid="nav-notice">@_navNotice</p>
            }
        </section>
        <ReviewPanel State="CurrentReview" Writable="ReviewWritable" Working="_reviewPending" Notice="@_reviewNotice"
                     Accept="AcceptReviewAsync" Decline="DeclineReview" Retry="RetryReviewAsync" Undo="UndoReviewAsync" Cancel="CancelReview" />
    </section>
}

@code {
    private System.Threading.CancellationTokenSource? _autosaveCts;

    // ---- independent engine analysis (M2a-2b-2b) ----
    // The coordinator and analyzer are DI-owned scoped services (app-lifetime in
    // WASM): the page only subscribes/cancels and must NOT dispose them, so
    // navigating away and back reuses the SAME coordinator (no disposed-service
    // reuse) and the worker epoch survives a remount. Analysis is independent
    // of save/AI/network; lazy worker init never blocks editing/saving.
    private ElementReference _editorRef;
    // Single-flight shared import of the tiny editor-select.js DOM module. A
    // concurrent second navigation reuses the SAME in-flight import Task (no
    // duplicate module refs). On dispose, the (possibly in-flight) Task is awaited
    // and its module disposed exactly once; a module arriving after page dispose
    // is never assigned into a dead page.
    private System.Threading.Tasks.Task<IJSObjectReference>? _editorSelectTask;
    // Cross-file selection deferred to OnAfterRenderAsync once the target textarea
    // renders. Carries the navigation intent token so a newer click / page dispose
    // cancels the pending application before it can select.
    private NavigationResult.Selected? _pendingSelect;
    private System.Threading.CancellationToken _pendingSelectCt;
    // One navigation intent at a time: a new click cancels the previous, and page
    // dispose cancels any in flight. Each navigation re-checks its own token after
    // every await, so a late callback cannot activate/select a stale file.
    private System.Threading.CancellationTokenSource? _navCts;
    private string? _navNotice;
    private bool _pageDisposed;

    // Offline-readiness subscription: JS forwards the service-worker warm-result
    // event (a browser warm-status event) to this [JSInvokable] method via a
    // tiny event-glue module; C# owns the visible provisioning/incomplete
    // notice and guidance. JS only reports the readiness state. The page
    // stores the opaque subscription id returned by subscribeOfflineReadiness
    // and calls unsubscribeOfflineReadiness BEFORE disposing the DotNet ref.
    private DotNetObjectReference<Workspace>? _offlineReadinessRef;
    private IJSObjectReference? _offlineReadinessModule;
    private string? _offlineReadinessSubId;
    private string? _offlineReadinessNotice;

    /// <summary>The CURRENT usable report, or null when the coordinator is not
    /// Completed. Read fresh from the coordinator on every render so a queued
    /// render never repaints a stale event argument after a newer state is
    /// current.</summary>
    private AnalysisReport? AnalysisCurrentReport
        => AnalysisCoord.State is AnalysisState.Completed c ? c.Report : null;

    private string ActiveContent
    {
        get => Coordinator.ActiveFile?.Content ?? "";
        set
        {
            if (Coordinator.ActiveFile is { } af && Coordinator.EditText(af.Id, value))
            {
                ScheduleAutosave();
                StateHasChanged();
            }
        }
    }

    private string StatusText
    {
        get
        {
            if (Coordinator.Recovery is not null) return "Recovery required — head is damaged.";
            if (Coordinator.IsReadOnly) return "Read-only.";
            return Coordinator.SavePhase switch
            {
                SavePhase.Saving => "Saving…",
                SavePhase.Saved => Coordinator.IsDirty ? "Unsaved changes." : "Saved.",
                SavePhase.Failed => "Save failed: " + (Coordinator.LastError ?? "unknown"),
                SavePhase.Dirty => "Unsaved changes.",
                _ => Coordinator.IsDirty ? "Unsaved changes." : "Saved."
            };
        }
    }

    private string StatusClass
    {
        get
        {
            if (Coordinator.Recovery is not null) return "status-recovery";
            if (Coordinator.IsReadOnly) return "status-readonly";
            return Coordinator.SavePhase switch
            {
                SavePhase.Saving => "status-saving",
                SavePhase.Failed => "status-failed",
                SavePhase.Saved => Coordinator.IsDirty ? "status-dirty" : "status-saved",
                SavePhase.Dirty => "status-dirty",
                _ => Coordinator.IsDirty ? "status-dirty" : "status-saved"
            };
        }
    }

    private bool SaveDisabled =>
        Coordinator.IsReadOnly || Coordinator.Recovery is not null ||
        (!Coordinator.IsDirty && Coordinator.SavePhase != SavePhase.Saving && Coordinator.SavePhase != SavePhase.Failed);

    // ---- independent engine analysis status (honest per-state labels) ----
    // Local save status stays separate: these labels never mention save/AI/network.
    private string AnalysisStatusText => AnalysisCoord.State switch
    {
        AnalysisState.NoProject => "No project open.",
        AnalysisState.Pending => "Analysis queued…",
        AnalysisState.Running => "Analyzing…",
        AnalysisState.Completed => "Analysis complete.",
        AnalysisState.Cancelled => "Analysis cancelled.",
        AnalysisState.InvalidInput i => "Analysis rejected the input: " + i.SafeMessage,
        AnalysisState.QuotaExceeded q => "Analysis skipped: " + q.SafeMessage,
        AnalysisState.Unavailable u => "Analysis unavailable: " + u.SafeMessage,
        AnalysisState.Superseded => "Analysis was superseded by a newer change; run analysis again.",
        AnalysisState.Failed f => "Analysis failed: " + (f.Error?.SafeMessage ?? "unknown"),
        AnalysisState.Disposed => "Analysis is no longer available.",
        _ => "",
    };

    private string AnalysisStatusClass => AnalysisCoord.State switch
    {
        AnalysisState.Completed => "status-saved",
        AnalysisState.Pending or AnalysisState.Running => "status-saving",
        AnalysisState.Cancelled or AnalysisState.Superseded => "status-dirty",
        AnalysisState.InvalidInput or AnalysisState.QuotaExceeded
            or AnalysisState.Unavailable or AnalysisState.Failed or AnalysisState.Disposed => "status-failed",
        AnalysisState.NoProject => "status-readonly",
        _ => "",
    };

    /// <summary>True when the completed result is a bounded-partial / truncated
    /// / indeterminate analysis: known findings stay visible, but the UI must
    /// label it incomplete and must NOT show Pass/compliance.</summary>
    private static bool IsIncomplete(AnalysisReport report)
    {
        var cov = report.Result.Coverage;
        return EngineOutcome(report) == RuleOutcome.Indeterminate
            || EngineOutcome(report) == RuleOutcome.Unavailable
            || (report.Result.Knu is null && cov.DiagnosticsTruncated) || cov.ResultTruncated
            || cov.TruncatedFiles.Count > 0
            || report.Result.Facts.Files.Any(f => f.Truncated || f.BraceDepthExceeded);
    }

    private static RuleOutcome EngineOutcome(AnalysisReport report)
        => report.Result.Knu?.EngineAggregateOutcome ?? report.Result.AggregateOutcome;

    private void ChangeAnalysisProfile(ChangeEventArgs e)
    {
        ClearSelectionIntent();
        if (e.Value?.ToString() == "engine-structural") AnalysisCoord.SetSelection(AnalysisSelection.EngineStructural());
        else if (e.Value?.ToString() == AnalysisCatalog.KnuId) AnalysisCoord.SetSelection(AnalysisSelection.Knu(AnalysisWorkType.Unspecified));
        else AnalysisCoord.SetSelection(default);
    }
    private void ChangeWorkType(ChangeEventArgs e)
    {
        ClearSelectionIntent();
        var work = e.Value?.ToString() switch {
            "unspecified" => AnalysisWorkType.Unspecified, "coursework" => AnalysisWorkType.Coursework,
            "bachelorQualification" => AnalysisWorkType.BachelorQualification,
            "masterQualification" => AnalysisWorkType.MasterQualification, _ => (AnalysisWorkType)(-1),
        };
        AnalysisCoord.SetSelection(AnalysisSelection.Knu(work));
    }
    private void ClearSelectionIntent()
    {
        _navCts?.Cancel(); _pendingSelect = null; _navNotice = null;
    }

    private static string FileLabel(AnalysisReport report, string fileId)
    {
        var cf = report.Snapshot.Files.FirstOrDefault(f => f.FileId.ToString() == fileId);
        var x = report.Snapshot.Excluded.FirstOrDefault(f => f.FileId.ToString() == fileId);
        return cf?.RelativePath ?? x?.RelativePath ?? fileId;
    }

    private List<Project> _projects = new();
    private string _newProjectName = "";
