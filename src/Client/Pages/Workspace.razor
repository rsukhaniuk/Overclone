            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            await module.InvokeVoidAsync("downloadZip", filename, archive.Bytes);
            await module.DisposeAsync();
            _transferStatus = $"Exported revision {receipt.CapturedRevision.ToString().Substring(0,8)} ({receipt.FileCount} files, {receipt.ByteLength} bytes).";
            _transferOk = true;
        }
        catch (System.Exception ex)
        {
            _transferStatus = "Export ZIP failed: " + ex.Message;
            _transferOk = false;
        }
        StateHasChanged();
    }

    private async Task ExportFolderAsync()
    {
        try
        {
