    private async Task PublishStagedAsync()
    {
        if (_staged is null) return;
        var result = await Coordinator.PublishImportAsync(_staged, _stagedName, System.Threading.CancellationToken.None);
        if (result.Published && result.Project is { } p && result.Head is { } head)
        {
