        <details class="tool-disclosure" data-testid="analysis-disclosure">
            <summary>Analysis <span class="@AnalysisStatusClass">@AnalysisStatusText</span></summary>
        <section class="analysis-panel tool-content" aria-label="Source analysis" data-testid="analysis-panel" data-generation="@Coordinator.WorkingGeneration" data-session="@Coordinator.SessionId" data-head="@Coordinator.CurrentRevision?.Id">
            <h2>@(AnalysisCoord.CurrentProfile.Id == AnalysisCatalog.KnuId ? "Source analysis" : "Engine analysis")</h2>
            <div class="analysis-controls">
                <label for="analysis-profile">Analysis profile</label>
                <select id="analysis-profile" data-testid="analysis-profile" value="@AnalysisProfileValue" @onchange="ChangeAnalysisProfile">
                    <option value="engine-structural">Engine checks</option>
                    <option value="engine-source-references">Source references</option>
                    <option value="knu-csc-2025-source">KNU CSC 2025 source observations v1.1</option>
                    <option value="knu-csc-2025-source@1.3.0">KNU CSC 2025 source observations — geometry package v1.3</option>
                    <option value="knu-csc-2025-source@1.4.0">KNU CSC 2025 source observations — formatting intent v1.4</option>
                    <option value="knu-csc-2025-source@1.2.0">KNU CSC 2025 source observations — reviewable margin fixes v1.2</option>
                    <option value="knu-csc-2025-source@1.0.0">KNU CSC 2025 source observations — legacy v1.0</option>
                </select>
                @if (AnalysisCoord.CurrentConfiguration is { } configuration)
                {
                    <label for="analysis-work-type">Work type</label>
                    <select id="analysis-work-type" data-testid="analysis-work-type" value="@AnalysisPresentation.WorkValue(configuration.WorkType)" @onchange="ChangeWorkType">
                        @foreach (var work in Enum.GetValues<AnalysisWorkType>())
                        { <option value="@AnalysisPresentation.WorkValue(work)">@AnalysisPresentation.WorkType(work)</option> }
                    </select>
