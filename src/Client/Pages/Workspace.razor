    private async Task PublishStagedAsync()
    {
        if (_projectRename?.TryOtherAction() == false) return;
        if (_staged is null) return;
        var result = await Coordinator.PublishImportAsync(_staged, _stagedName, System.Threading.CancellationToken.None);
        if (result.Published && result.Project is { } p && result.Head is { } head)
        {
            _staged = null;
            _stagedExcluded = Array.Empty<string>();
            _stagedName = "";
            _transferStatus = "Imported project published.";
            _transferOk = true;
            await RefreshProjectsAsync();
            // Opening the result follows successful persistence.
            if (_projectRename?.TryOtherAction() == false) return;
            await Coordinator.OpenAsync(p.Id, System.Threading.CancellationToken.None);
            await LoadHistoryAsync(first: true);
        }
        else
        {
            _transferStatus = "Import failed: " + (result.SafeMessage ?? result.ErrorCode ?? "unknown");
            _transferOk = false;
        }
        StateHasChanged();
    }

