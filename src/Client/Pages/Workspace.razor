    private async Task ShowCompletionsAsync()
    {
        if (_sourceBusy || _pageDisposed || _completions is null) return;
        var ct = NavCancelAndStart(); var owner = new object();
        _sourceOperation = owner; _completionOperation = owner; _completionState = "reading";
        var request = _completions.Begin(_sourceIntent);
        try
        {
            if (request is null) { _completionState = "unavailable"; return; }
            if (!CompletionCurrent(owner, request, ct)) return;
            // None is deliberate: keep admission through the ACTUAL shared import,
            // not the helper's per-caller cancellation WaitAsync proxy.
            var module = await GetEditorSelectAsync(System.Threading.CancellationToken.None);
            if (!CompletionCurrent(owner, request, ct)) return;
            if (module is null) { _completionState = "unavailable"; _completions.Clear(); return; }
            var snapshot = request.Snapshot;
            var dom = await module.InvokeAsync<SourceDomRange?>("readSelection", _editorRef,
                snapshot.File.ToString(), SourceTools.TextareaText(snapshot.Text));
            if (!CompletionCurrent(owner, request, ct)) return;
            if (dom is not { Start: { } start, End: { } end }) { _completionState = "unavailable"; _completions.Clear(); return; }
            _completions.Propose(request, new(start, end), _sourceIntent, out var result);
            _completionState = result switch { CompletionMatchState.Ready => "ready", CompletionMatchState.Empty => "empty", _ => "unavailable" };
            if (result != CompletionMatchState.Ready) _completions.Clear();
