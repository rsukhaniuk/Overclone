    /// <summary>True when the completed result is a bounded-partial / truncated
    /// / indeterminate analysis: known findings stay visible, but the UI must
    /// label it incomplete and must NOT show Pass/compliance.</summary>
    private static bool IsIncomplete(AnalysisReport report)
    {
        var cov = report.Result.Coverage;
        return EngineOutcome(report) == RuleOutcome.Indeterminate
            || EngineOutcome(report) == RuleOutcome.Unavailable
            || (report.Result.Profile.Id == AnalysisCatalog.ReferenceId && report.Result.AggregateOutcome is RuleOutcome.Indeterminate or RuleOutcome.Unavailable)
            || (report.Result.Knu is null && cov.DiagnosticsTruncated) || cov.ResultTruncated
            || cov.TruncatedFiles.Count > 0
            || report.Result.Facts.Files.Any(f => f.Truncated || f.BraceDepthExceeded);
    }

    private static RuleOutcome EngineOutcome(AnalysisReport report)
        => report.Result.Profile.Id == AnalysisCatalog.ReferenceId
            ? report.Result.RuleResults.Single(r => r.RuleId == AnalysisCatalog.Engine).Outcome
            : report.Result.Knu?.EngineAggregateOutcome ?? report.Result.AggregateOutcome;

