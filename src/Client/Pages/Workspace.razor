    private string _sourceQuery = "", _sourceReplacement = "";
    private bool _sourceCase;
    private string _sourceStatus = "Literal search; selected full lines use two-space indentation.";
    private long _sourceIntent;
    private (SourceToolSnapshot Snapshot, SourceRange Range, System.Threading.CancellationToken Token, object Owner)? _sourceSelection;
    // Ownership is separate from query/navigation intent: a query-only change
    // invalidates work but its eventual finalizer must still release its busy state.
    private object? _sourceOperation;
    private bool _sourceBusy => _sourceOperation is not null || _completionOperation is not null || _assistance?.Busy == true;
    private bool SourceEditsDisabled => _sourceBusy || Coordinator.IsReadOnly || Coordinator.Recovery is not null ||
        Coordinator.ActiveFile is not { Deleted: false, MediaKind: "text" };

    private void SourceQueryChanged()
    {
        _sourceIntent++;
        InvalidateCompletion();
        _assistance?.Invalidate();
        _sourceStatus = "Search changed; choose Next or Previous.";
    }

    private sealed class SourceDomRange
    {
        public SourceDomRange() { }
        public int? Start { get; set; }
        public int? End { get; set; }
    }

    // Completion proposals share ordinary source-edit/selection ownership, but
    // this extra lease survives cancellation until actual interop settles.
    private CommandCompletionSession? _completions;
    private object? _completionOperation, _completionSelecting;
    private CommandCompletionSession.Proposal? _completionApplied;
    private string _completionState = "idle";
    private string CompletionNotice => _completionState switch
    {
        "reading" => "Checking the current editor caret…",
        "ready" => "Choose an explicit command insertion. Suggestions are lexical, not package or macro compatibility checks.",
        "empty" => "No common command matches this collapsed caret at a command end.",
        "unavailable" => "Command suggestions are unavailable for this source or editor selection.",
        "stale" => "Suggestions or their selection are no longer current; suggest again.",
        "applied" => "Command inserted; caret placed inside the empty braces. Ordinary autosave applies.",
        _ => "Explicit offline suggestions only; nothing is inserted automatically."
    };
    private void InvalidateCompletion()
    {
