    }
    private void CompletionAuthorityChanged()
    {
        if (_pageDisposed || _completions?.PendingRequest is not { } request || _completions.IsCurrent(request, _sourceIntent)) return;
        InvalidateCompletion();
        _ = InvokeAsync(() => { if (!_pageDisposed) StateHasChanged(); }).ContinueWith(ObserveTaskFault, TaskScheduler.Default);
    }
    private bool CompletionOwns(object owner, System.Threading.CancellationToken ct) => !_pageDisposed
        && !ct.IsCancellationRequested && ReferenceEquals(_completionOperation, owner) && ReferenceEquals(_sourceOperation, owner);
    private bool CompletionCurrent(object owner, CommandCompletionSession.Request request, System.Threading.CancellationToken ct)
    {
        if (!CompletionOwns(owner, ct) || _completions is null || !ReferenceEquals(_completions.PendingRequest, request)) return false;
        if (_completions.IsCurrent(request, _sourceIntent)) return true;
        InvalidateCompletion(); return false;
    }
    private bool RetireCompletion(object owner)
    {
        if (!ReferenceEquals(_completionOperation, owner)) return false;
        _completionOperation = null; _completionApplied = null;
        return true;
    }
    private void DismissCompletion(CommandCompletionSession.Proposal proposal)
    {
