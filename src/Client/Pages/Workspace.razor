        // FolderTransferService calls showDirectoryPicker as its first await.
        var result = await Folders.StageImportFromFolderAsync("Imported project", System.Threading.CancellationToken.None);
        _staged = result.Staged;
        _stagedExcluded = result.ExcludedTrees;
