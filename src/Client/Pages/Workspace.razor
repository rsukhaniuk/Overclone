    // ---- export ----

    private async Task ExportZipAsync()
    {
        try
        {
            var source = await Coordinator.CaptureExportSourceAsync(System.Threading.CancellationToken.None);
            var receipt = await Transfer.ExportZipAsync(source, System.Threading.CancellationToken.None);
            // Build the actual ZIP bytes for download from the captured revision.
            var zipBytes = await BuildZipBytesAsync(source, System.Threading.CancellationToken.None);
            var filename = (Coordinator.Project?.Name ?? "project") + ".zip";
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            await module.InvokeVoidAsync("downloadZip", filename, zipBytes);
            await module.DisposeAsync();
            _transferStatus = $"Exported revision {receipt.CapturedRevision.ToString().Substring(0,8)} ({receipt.FileCount} files, {receipt.ByteLength} bytes).";
            _transferOk = true;
        }
        catch (System.Exception ex)
        {
            _transferStatus = "Export ZIP failed: " + ex.Message;
            _transferOk = false;
        }
        StateHasChanged();
    }

    private async Task ExportFolderAsync()
    {
        try
        {
            var source = await Coordinator.CaptureExportSourceAsync(System.Threading.CancellationToken.None);
            var result = await Folders.ExportToFolderAsync(source, System.Threading.CancellationToken.None);
            if (result.Complete)
            {
                _transferStatus = $"Exported to '{result.DirectoryName}' ({result.Completed.Count} files).";
                _transferOk = true;
            }
            else
            {
                _transferStatus = result.PartialNote ?? "Folder export did not complete.";
                _transferOk = false;
            }
        }
        catch (System.Exception ex)
        {
            _transferStatus = "Export to folder failed: " + ex.Message;
            _transferOk = false;
        }
        StateHasChanged();
    }

    private async Task<byte[]> BuildZipBytesAsync(ExportSource source, System.Threading.CancellationToken ct)
    {
        // Stream exact durable bytes of the captured revision into an in-memory ZIP.
        using var ms = new System.IO.MemoryStream();
        using (var zip = new System.IO.Compression.ZipArchive(ms, System.IO.Compression.ZipArchiveMode.Create, leaveOpen: true))
        {
            foreach (var f in source.Revision.Files)
            {
                ct.ThrowIfCancellationRequested();
                var entry = zip.CreateEntry(f.RelativePath, System.IO.Compression.CompressionLevel.Optimal);
                using var es = entry.Open();
                var bytes = await source.ReadContent(f.ContentHash, ct);
                es.Write(bytes, 0, bytes.Length);
            }
        }
        return ms.ToArray();
    }

    private string TransferStatusClass => _transferOk ? "status-saved" : "status-failed";

