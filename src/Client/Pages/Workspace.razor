    // ---- history ----

    private async Task LoadHistoryAsync(bool first)
    {
        if (Coordinator.Project is null) return;
        if (first)
        {
            _history.Clear();
            _historyNextCursor = null;
        }
        var page = await Coordinator.ReadHistoryAsync(Coordinator.Project.Id,
            _historyNextCursor is null ? null : new HistoryCursor(_historyNextCursor),
            System.Threading.CancellationToken.None);
        _history.AddRange(page.Checkpoints);
        _historyNextCursor = page.NextCursor;
    }

    private async Task LoadMoreHistoryAsync()
    {
        await LoadHistoryAsync(first: false);
        StateHasChanged();
    }

    private async Task SelectHistoryAsync(CheckpointId id)
    {
        SelectedHistoryId = id;
        _restoreError = null;
        if (Coordinator.Project is null) return;
        var cp = _history.FirstOrDefault(c => c.Id == id);
        if (cp is null) return;
        try
        {
            _restorePreview = await Coordinator.CaptureRestorePreviewAsync(cp.RevisionId, System.Threading.CancellationToken.None);
            _comparison = _restorePreview.Summary;
            // Pick the first content-changed text file for an optional detailed diff.
            var changed = _comparison.Changes.FirstOrDefault(c =>
                c.Kind == FileChangeKind.ContentChanged && c.Diff is not null);
            if (changed is { } ch && ch.Diff is { } d)
            {
                _selectedDiff = d;
                _selectedDiffPath = ch.Path;
            }
            else
            {
                _selectedDiff = null;
                _selectedDiffPath = "";
            }
        }
        catch (System.Exception ex)
        {
            _restoreError = ex.Message;
            _comparison = null;
            _restorePreview = null;
        }
        StateHasChanged();
    }

    private async Task AcceptRestoreAsync()
    {
        if (_restorePreview is null) return;
        var result = await Coordinator.AcceptRestoreAsync(_restorePreview, System.Threading.CancellationToken.None);
        if (result.Status == CommitStatus.Saved)
        {
            _restoreError = null;
            _comparison = null;
            _restorePreview = null;
            SelectedHistoryId = null;
            await LoadHistoryAsync(first: true);
        }
        else
        {
            _restoreError = result.SafeMessage ?? result.ErrorCode ?? "Restore failed.";
            // The preview is stale; clear it so the user re-captures.
            _restorePreview = null;
            _comparison = null;
        }
        StateHasChanged();
    }

    // ---- independent engine analysis actions ----

    private async Task AnalyzeNowAsync()
    {
        _navNotice = null;
        AnalysisCoord.RequestReanalyze();
        await Task.CompletedTask;
    }

    private void CancelAnalysis()
    {
        _navNotice = null;
        CancelSelectionIntents();
        AnalysisCoord.Cancel();
    }

    // A single competing navigation seam for tree, analysis, source tools and
    // project search. Clearing pending renders is as important as cancellation:
    // an older deferred selection must never run under a newer click's render.
    private void CancelSelectionIntents()
    {
        // A deferred callback has started no foreign work. Started callbacks
        // clear this slot and retain their actual settlement lease in finally.
        if (_assistPendingNavigation is { } assistance) assistance.Completion.TrySetResult(false);
        _assistPendingNavigation = null;
        _sourceIntent++;
        InvalidateCompletion();
        _assistance?.Invalidate();
        // A deferred selection not yet started owns no foreign work. Once the
        // after-render callback starts it clears this slot and owns retirement.
        if (_sourceSelection is { } deferred && ReferenceEquals(deferred.Owner, _completionOperation))
            RetireCompletion(deferred.Owner);
        // Revoke ownership BEFORE cancellation can resume an old continuation.
        // Its catch/finally may no longer repaint status or clear newer busy work.
        if (_sourceOperation is not null)
        {
            _sourceOperation = null;
            _sourceStatus = "Source action superseded; action discarded. Try again.";
        }
        _pendingSelect = null;
        _pendingProjectSearch = null;
        _pendingCompilerSource = null;
        _pendingSyncSource = null;
        if (_syncBusy) _syncStatus = "Source/PDF navigation superseded by another action.";
        _syncBusy = false; _syncResult = null; _syncPointer = null;
        if (_compilerSourceNavigating)
            _compilerSourceStatus = "Compiler source navigation superseded by another action.";
        _compilerSourceNavigating = false;
        _compilerSourceRequest = null;
        _sourceSelection = null;
        if (_projectSearchNavigating)
            _projectSearchNavigationStatus = "Search navigation superseded by another action.";
        _projectSearchNavigating = false;
        var navigation = _navCts;
        _navCts = null;
        navigation?.Cancel();
        navigation?.Dispose();
    }

    private System.Threading.CancellationToken NavCancelAndStart()
    {
        CancelSelectionIntents();
        _navCts = new System.Threading.CancellationTokenSource();
        return _navCts.Token;
    }

    private void CompilerSourceAuthorityChanged()
    {
        if (!_pageDisposed && _syncBusy && (!CanMapNavigate || _syncPointer is { } point && !SyncPointerCurrent(point))) CancelSelectionIntents();
        if (!_pageDisposed && _syncResult is { } mapped && !_syncNavigation.IsCurrent(mapped))
        {
            _syncResult = null; _pendingSyncSource = null;
            _syncStatus = "Source or compilation changed. Compile again before navigating.";
            _ = InvokeAsync(() => { if (!_pageDisposed) StateHasChanged(); }).ContinueWith(ObserveTaskFault, TaskScheduler.Default);
        }
        if (_pageDisposed || _compilerSourceRequest is not { } request || _compilerSource.IsCurrent(request)) return;
        if (_compilerSourceNavigating) CancelSelectionIntents();
        _compilerSourceRequest = null;
        _compilerSourceStatus = "Compiler attempt, selection or source changed; line navigation is stale. Compile again.";
        _ = InvokeAsync(() => { if (!_pageDisposed) StateHasChanged(); }).ContinueWith(ObserveTaskFault, TaskScheduler.Default);
    }

    private bool CompilerSourceIntentCurrent(System.Threading.CancellationToken ct) =>
        !_pageDisposed && !ct.IsCancellationRequested && _navCts is not null && _navCts.Token == ct;

    private bool SyncPointerCurrent(PdfPreviewPointer point)
    {
        var view = CompileSession.Preview.State;
        return view.Status == PdfPreviewStatus.Available && view.Frame is not null
            && point.Generation == view.Generation && point.DocumentSha256 == view.DocumentSha256 && point.PageIndex == view.PageIndex;
    }
    private bool SyncIntentCurrent(System.Threading.CancellationToken ct) => CompilerSourceIntentCurrent(ct)
        && (_syncPointer is null || SyncPointerCurrent(_syncPointer));
    private void SyncNotice(System.Threading.CancellationToken ct, string message)
    {
        if (!CompilerSourceIntentCurrent(ct)) return;
        _syncBusy = false; _syncStatus = message; StateHasChanged();
    }
    private async Task GoToPdfAsync()
    {
        if (!CanMapNavigate || _syncBusy || Coordinator.ActiveFile is not { MediaKind: "text" } file) return;
        var output = CompileSession.DisplayedOutput;
        var content = file.Content;
        var ct = NavCancelAndStart(); _syncBusy = true; _syncStatus = "Locating source in PDF…";
        try
        {
            var module = await GetEditorSelectAsync(ct);
            if (!SyncIntentCurrent(ct)) return;
            if (module is null || !ReferenceEquals(Coordinator.ActiveFile, file) || file.Content != content
                || !ReferenceEquals(output, CompileSession.DisplayedOutput) || !CanMapNavigate)
            { SyncNotice(ct, "Source or PDF changed. Compile again before navigating."); return; }
            var dom = await module.InvokeAsync<SourceDomRange?>("readSelection", _editorRef, file.Id.ToString(), SourceTools.TextareaText(content));
            if (!SyncIntentCurrent(ct)) return;
            if (dom?.Start is not { } caret || !ReferenceEquals(Coordinator.ActiveFile, file) || file.Content != content
                || !ReferenceEquals(output, CompileSession.DisplayedOutput)
                || !SourceTools.TryFromTextarea(content, new(caret, caret), out var source))
            { SyncNotice(ct, "Editor text no longer matches the compiled source. Compile again."); return; }
            var result = await _syncNavigation.ForwardAsync(file.Id, source.Start, ct);
            if (!SyncIntentCurrent(ct)) return;
            if (result is null || !_syncNavigation.IsCurrent(result, ct))
            { SyncNotice(ct, "No current source location is available. Check source-map resources or compile again."); return; }
            _syncResult = result; _syncBusy = false;
            await ActivateSyncMatchAsync(result, 0);
        }
        catch (Exception error) when (error is JSException or System.OperationCanceledException or ObjectDisposedException)
        { SyncNotice(ct, "Source/PDF navigation could not finish. Retry when ready."); }
    }
    private async Task OnPdfPointAsync(PdfPreviewPointer point)
    {
        if (!CanMapNavigate || !SyncPointerCurrent(point) || CompileSession.Preview.State.PageGeometry is not { } geometry
            || CompileSession.Preview.State.DocumentSha256 != CompileSession.DisplayedOutput?.OutputHash?.Hex) return;
        var location = SyncTeXDisplayGeometry.Inverse(geometry, point.X, point.Y);
        if (location is null) { _syncStatus = "Source navigation is unavailable for this page geometry."; return; }
        var ct = NavCancelAndStart(); _syncPointer = point; _syncBusy = true; _syncStatus = "Locating PDF position in source…";
        var result = await _syncNavigation.InverseAsync(point.PageIndex + 1, location.H, location.V, ct);
        if (!SyncIntentCurrent(ct)) return;
        if (result is null || !_syncNavigation.IsCurrent(result, ct))
        { SyncNotice(ct, "No captured source line is available at that PDF position."); return; }
        _syncResult = result;
        await ActivateSyncMatchAsync(result, 0);
    }
    private async Task ActivateSyncMatchAsync(SyncTeXNavigationResult result, int index)
    {
        if (_navCts is null || !ReferenceEquals(result, _syncResult) || !_syncNavigation.IsCurrent(result, _navCts.Token)
            || index < 0 || index >= result.Matches.Length) return;
        var ct = _navCts.Token; var match = result.Matches[index]; var view = CompileSession.Preview.State;
        if (!SyncIntentCurrent(ct) || match.Page > view.PageCount || view.DocumentSha256 != result.Output.OutputHash?.Hex)
        { SyncNotice(ct, "PDF preview changed or is still loading. Retry when ready."); return; }
        _syncIndex = index;
        if (result.Direction == SyncTeXDirection.Forward)
        {
            if (!_syncNavigation.IsCurrent(result, ct) || !CompileSession.Preview.GoToPage(match.Page))
            { SyncNotice(ct, "PDF location is no longer available."); return; }
            SyncNotice(ct, $"PDF page {match.Page}, native source line {match.File.RelativePath}:{match.Line}. Choose another match if needed.");
            return;
        }
        var selection = await _syncNavigation.PrepareSourceAsync(result, index, ct);
        if (!SyncIntentCurrent(ct)) return;
        if (selection is null || !_syncNavigation.IsCurrent(selection, ct))
        { SyncNotice(ct, "Captured source changed. Compile again before navigating."); return; }
        if (Coordinator.ActiveFileId == selection.File.FileId) { await ApplySyncSourceAsync(selection, ct); return; }
        if (!_syncNavigation.IsCurrent(selection, ct) || !Coordinator.SelectFile(selection.File.FileId))
        { SyncNotice(ct, "Captured source file is unavailable."); return; }
        if (!SyncIntentCurrent(ct) || !_syncNavigation.IsCurrent(selection, ct, requireActiveFile: true)) return;
        _pendingSyncSource = selection; _pendingSyncSourceCt = ct; StateHasChanged();
    }
    private async Task ApplySyncSourceAsync(SyncTeXNavigationSelection selection, System.Threading.CancellationToken ct)
    {
        if (!SyncIntentCurrent(ct) || !_syncNavigation.IsCurrent(selection, ct, requireActiveFile: true)) return;
        var module = await GetEditorSelectAsync(ct);
        if (!SyncIntentCurrent(ct)) return;
        if (module is null || !_syncNavigation.IsCurrent(selection, ct, requireActiveFile: true))
        { SyncNotice(ct, "Source selection is unavailable or stale."); return; }
        var verified = await _syncNavigation.PrepareSourceAsync(selection.Result, selection.Result.Matches.IndexOf(selection.Match), ct);
        if (!SyncIntentCurrent(ct)) return;
        if (verified is null || !_syncNavigation.IsCurrent(verified, ct, requireActiveFile: true))
        { SyncNotice(ct, "Source preimage changed. Selection discarded."); return; }
        try
        {
            bool selected = await module.InvokeAsync<bool>("trySelectForFind", _editorRef, verified.File.FileId.ToString(),
                verified.ExpectedTextareaText, verified.TextareaRange.Start, verified.TextareaRange.End);
            if (!SyncIntentCurrent(ct)) return;
            if (!_syncNavigation.IsCurrent(verified, ct, requireActiveFile: true) || !selected)
            { SyncNotice(ct, "Editor file or text changed. Selection discarded."); return; }
            SyncNotice(ct, $"Selected {verified.File.RelativePath}:{verified.Match.Line} (native line-level precision).");
        }
        catch (JSException) { SyncNotice(ct, "Could not select the source line. Retry when ready."); }
    }

    private void RejectCompilerSource(System.Threading.CancellationToken ct, string status)
    {
        if (!CompilerSourceIntentCurrent(ct)) return; // A newer intent owns its notice.
        _compilerSourceNavigating = false;
        _compilerSourceStatus = status;
        StateHasChanged();
    }

    private async Task OnCompilerSourceNavigateAsync(CompilerSourceNavigationRequest request)
    {
        if (_pageDisposed) return;
        var ct = NavCancelAndStart();
        _compilerSourceNavigating = true;
        _compilerSourceRequest = request;
        _compilerSourceStatus = "Selecting captured compiler source line…";
        var selection = await _compilerSource.PrepareAsync(request, ct);
        if (!CompilerSourceIntentCurrent(ct)) return;
        if (selection is null || !_compilerSource.IsCurrent(selection, ct))
        { RejectCompilerSource(ct, "Compiler attempt or source is stale/unavailable; compile again."); return; }
        if (Coordinator.ActiveFileId == request.File.FileId)
        {
            // Already active: never rerender away a DOM-only value mismatch.
            await ApplyCompilerSourceSelectionAsync(selection, ct);
            return;
        }
        // Validated authority, never a path/file-ID alleged by UI or a PDF.
        if (!_compilerSource.IsCurrent(selection, ct) || !Coordinator.SelectFile(request.File.FileId))
        { RejectCompilerSource(ct, "Compiler source file is no longer available; compile again."); return; }
        if (!CompilerSourceIntentCurrent(ct)) return;
        if (!_compilerSource.IsCurrent(selection, ct, requireActiveFile: true))
        { RejectCompilerSource(ct, "Compiler source changed before render; compile again."); return; }
        _pendingCompilerSource = selection;
        _pendingCompilerSourceCt = ct;
        StateHasChanged(); // OnAfterRenderAsync applies to the actual target textarea.
    }

    private async Task ApplyCompilerSourceSelectionAsync(CompilerSourceNavigationPolicy.Selection selection,
        System.Threading.CancellationToken ct)
    {
        if (!CompilerSourceIntentCurrent(ct)) return;
        if (!_compilerSource.IsCurrent(selection, ct, requireActiveFile: true))
        { RejectCompilerSource(ct, "Compiler attempt or source is stale; compile again."); return; }
        var module = await GetEditorSelectAsync(ct);
        if (!CompilerSourceIntentCurrent(ct)) return;
        if (!_compilerSource.IsCurrent(selection, ct, requireActiveFile: true))
        { RejectCompilerSource(ct, "Compiler attempt or source changed; selection discarded."); return; }
        if (module is null)
        { RejectCompilerSource(ct, "Source selection module unavailable; try again when provisioned."); return; }
        // Re-materialize exact bytes after the render/import await, not merely
        // a file hash allegation. The centralized policy checks after this IO.
        var verified = await _compilerSource.PrepareAsync(selection.Request, ct);
        if (!CompilerSourceIntentCurrent(ct)) return;
        if (verified is null || !_compilerSource.IsCurrent(verified, ct, requireActiveFile: true))
        { RejectCompilerSource(ct, "Compiler source preimage changed; selection discarded."); return; }
        try
        {
            // Final synchronous authority/file/preimage check immediately above
            // the existing atomic expected-file/full-value DOM comparison.
            // Read-only find is allowed; this never unlocks or edits text.
            bool selected = await module.InvokeAsync<bool>("trySelectForFind", _editorRef,
                verified.Request.File.FileId.ToString(), verified.ExpectedTextareaText,
                verified.TextareaRange.Start, verified.TextareaRange.End);
            if (!CompilerSourceIntentCurrent(ct)) return;
            if (!_compilerSource.IsCurrent(verified, ct, requireActiveFile: true))
            { RejectCompilerSource(ct, "Compiler attempt or source changed; selection discarded."); return; }
            if (!selected)
            { RejectCompilerSource(ct, "Editor file or text does not match the compiler source; selection rejected."); return; }
            _compilerSourceNavigating = false;
            _compilerSourceStatus = $"Selected {verified.Request.File.RelativePath}:{verified.Request.Location.Line} (line-level precision).";
            StateHasChanged();
        }
        catch (JSException)
        { RejectCompilerSource(ct, "Could not select compiler source line; no source was changed."); }
    }

    private bool ProjectSearchCurrent(ProjectSearchNavigationRequest request, System.Threading.CancellationToken ct)
        => !_pageDisposed && !ct.IsCancellationRequested && _navCts is not null && _navCts.Token == ct
            && request.IsCurrent && request.ProjectId == Coordinator.Project?.Id
            && request.SessionId == Coordinator.SessionId
            && request.WorkingGeneration == Coordinator.WorkingGeneration;

    private void RejectProjectSearchNavigation(System.Threading.CancellationToken ct, string notice)
    {
        // A superseded callback must not overwrite the newer intent's status.
        if (_pageDisposed || ct.IsCancellationRequested || _navCts is null || _navCts.Token != ct) return;
        _projectSearchNavigating = false;
        _projectSearchNavigationStatus = notice;
        StateHasChanged();
    }

    private async Task OnProjectSearchNavigateAsync(ProjectSearchNavigationRequest request)
    {
        if (_pageDisposed) return;
        var ct = NavCancelAndStart();
        _projectSearchNavigating = true;
        _projectSearchNavigationStatus = "Selecting search result…";
        if (!ProjectSearchCurrent(request, ct))
        {
            RejectProjectSearchNavigation(ct, "Search result is stale. Search again.");
            return;
        }
        if (Coordinator.ActiveFileId == request.FileId)
        {
            // Do not force a render before the atomic DOM value comparison: it
            // could conceal a DOM-only mismatch in the already-active file.
            await ApplyProjectSearchSelectionAsync(request, ct);
            if (!ProjectSearchCurrent(request, ct))
                RejectProjectSearchNavigation(ct, "Search result is stale. Search again.");
            return;
        }
        // Active-file changes are not source mutations and do not invalidate the
        // listing. Only this validated request may supply the target identity.
        if (!ProjectSearchCurrent(request, ct) || !Coordinator.SelectFile(request.FileId))
        {
            RejectProjectSearchNavigation(ct, "Search target is no longer available. Search again.");
            return;
        }
        if (!ProjectSearchCurrent(request, ct))
        {
            RejectProjectSearchNavigation(ct, "Search result is stale. Search again.");
            return;
        }
        _pendingProjectSearch = request;
        _pendingProjectSearchCt = ct;
        StateHasChanged();
    }

    private async Task ApplyProjectSearchSelectionAsync(ProjectSearchNavigationRequest request, System.Threading.CancellationToken ct)
    {
        if (!ProjectSearchCurrent(request, ct))
        {
            RejectProjectSearchNavigation(ct, "Search result is stale. Search again.");
            return;
        }
        var module = await GetEditorSelectAsync(ct);
        if (!ProjectSearchCurrent(request, ct))
        {
            RejectProjectSearchNavigation(ct, "Search result is stale. Search again.");
            return;
        }
        if (module is null)
        {
            RejectProjectSearchNavigation(ct, "Search selection module unavailable. Try again when provisioned.");
            return;
        }
        if (Coordinator.ActiveFile is not { MediaKind: "text", Deleted: false } file || file.Id != request.FileId)
        {
            RejectProjectSearchNavigation(ct, "Search target is not the active text file. Search again.");
            return;
        }
        var source = file.Content;
        var range = SourceTools.ToTextarea(source, new(request.Start, request.End));
        if (range is not { } dom)
        {
            RejectProjectSearchNavigation(ct, "Search source range is no longer selectable. Search again.");
            return;
        }
        var expected = SourceTools.TextareaText(source);
        // Final synchronous identity/preimage/intent check, immediately before
        // the existing DOM-only atomic file/value/range guard. Read-only find is
        // allowed; analysis navigation continues to use the stricter trySelect.
        if (!ProjectSearchCurrent(request, ct) || Coordinator.ActiveFileId != request.FileId)
        {
            RejectProjectSearchNavigation(ct, "Search target changed. Search again.");
            return;
        }
        try
        {
            bool selected = await module.InvokeAsync<bool>("trySelectForFind", _editorRef,
                request.FileId.ToString(), expected, dom.Start, dom.End);
            if (!ProjectSearchCurrent(request, ct))
            {
                RejectProjectSearchNavigation(ct, "Search result is stale. Search again.");
                return;
            }
            if (Coordinator.ActiveFileId != request.FileId || !selected)
            {
                RejectProjectSearchNavigation(ct, "Editor file or text no longer matches this search result; selection rejected. Search again.");
                return;
            }
            _projectSearchNavigating = false;
            _projectSearchNavigationStatus = $"Selected {request.RelativePath}, line {request.Line}, column {request.Column}.";
            StateHasChanged();
        }
        catch (JSException)
        {
            if (!ProjectSearchCurrent(request, ct))
            {
                RejectProjectSearchNavigation(ct, "Search result is stale. Search again.");
                return;
            }
            RejectProjectSearchNavigation(ct, "Could not select search result; no source was changed.");
        }
    }

    private async Task OnFindingClickAsync(AnalysisReport report, AnalysisEngineDiagnosticDto diag)
    {
        // The rendered action owns THIS report; a stable diagnostic ID must not
        // retarget an old click to a newer root/profile/snapshot after A->B->A.
        if (!ReferenceEquals(AnalysisCurrentReport, report))
        {
            _navNotice = "This analysis is no longer current; run analysis again.";
            StateHasChanged();
            return;
        }
        var ct = NavCancelAndStart();
        _navNotice = null;
        NavigationResult result;
        try { result = await Navigator.NavigateAsync(report, diag, ct); }
        catch (System.OperationCanceledException) { return; }
        catch (System.Exception)
        {
            if (!_pageDisposed && !ct.IsCancellationRequested)
            { _navNotice = "Analysis could not navigate to this diagnostic; run analysis again."; StateHasChanged(); }
            return;
        }
        if (ct.IsCancellationRequested || _pageDisposed) return;

        switch (result)
        {
            case NavigationResult.Selected s:
                if (Coordinator.ActiveFileId == s.FileId)
                {
                    // Already active: validate the existing DOM value BEFORE an
                    // unnecessary rerender can overwrite a DOM-only mismatch.
                    await ApplySelectionAsync(s, ct);
                }
                else
                {
                    // Switch files: SelectFile + render, then OnAfterRenderAsync
                    // applies the selection once the target textarea has rendered.
                    SourceQueryChanged();
                    if (!Coordinator.SelectFile(s.FileId))
                    {
                        if (!ct.IsCancellationRequested && !_pageDisposed)
                        { _navNotice = "The diagnostic's file is no longer open."; StateHasChanged(); }
                        return;
                    }
                    if (ct.IsCancellationRequested || _pageDisposed) return;
                    _pendingSelect = s;
                    _pendingSelectCt = ct;
                    StateHasChanged();
                }
                break;
            case NavigationResult.NonSelectable ns:
                _navNotice = ns.Display;
                if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
                break;
            case NavigationResult.Rejected r:
                _navNotice = r.Reason;
                if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
                break;
        }
    }

    private async Task ApplySelectionAsync(NavigationResult.Selected s, System.Threading.CancellationToken ct)
    {
        // Check after EVERY await: a newer navigation, a page dispose, or an
        // edit/close/worker-reset during any await must prevent a stale
        // selection. The JS module then atomically verifies the DOM
        // (data-file-id + live value) in the SAME call as focus/setSelectionRange.
        if (_pageDisposed || ct.IsCancellationRequested) return;

        // Load/import the DOM module FIRST (shared single-flight import). A late
        // module arriving after page dispose is disposed, not assigned into a
        // dead page.
        var mod = await GetEditorSelectAsync(ct);
        if (ct.IsCancellationRequested || _pageDisposed) return;
        if (mod is null)
        {
            _navNotice = "Could not load the editor selection module; run analysis again.";
            if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
            return;
        }

        // Final AWAITED verification: report reference + workspace identity +
        // worker epoch, checked before AND after the epoch query. This re-runs
        // the worker-epoch check that NavigateAsync already did — an edit/close/
        // reset during the module import/render is caught here.
        var v = await Navigator.VerifyCurrentAsync(s.Report, ct);
        if (ct.IsCancellationRequested || _pageDisposed) return;
        if (!v.Ok)
        {
            _navNotice = v.Reason ?? "This analysis is no longer current; run analysis again.";
            if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
            return;
        }

        // Synchronous final checks IMMEDIATELY before the final DOM call (no
        // unrelated await between these and trySelect): page lifetime, intent,
        // report currency, and the target file is the active file.
        if (_pageDisposed || ct.IsCancellationRequested) return;
        if (!Navigator.IsStillCurrent(s.Report))
        {
            _navNotice = "The workspace changed since this analysis; run analysis again.";
            if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
            return;
        }
        if (Coordinator.ActiveFileId != s.FileId)
        {
            _navNotice = "The target file is not active; run analysis again.";
            if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
            return;
        }

        try
        {
            var ok = await mod.InvokeAsync<bool>("trySelect", _editorRef, s.FileId.ToString(), s.ExpectedTextareaText, s.TextareaStart, s.TextareaEnd);
            if (ct.IsCancellationRequested || _pageDisposed) return;
            _navNotice = ok ? null : "The editor no longer matches the analyzed source; run analysis again.";
        }
        catch (JSException)
        {
            if (ct.IsCancellationRequested || _pageDisposed) return;
            _navNotice = "Could not select the diagnostic location; run analysis again.";
        }
        if (!_pageDisposed && !ct.IsCancellationRequested) StateHasChanged();
    }

    private async System.Threading.Tasks.Task<IJSObjectReference?> GetEditorSelectAsync(System.Threading.CancellationToken ct)
    {
        if (_pageDisposed) return null;
        // Single-flight shared import: the FIRST caller assigns the import Task
        // synchronously (before awaiting), so a concurrent second navigation
        // reuses the SAME Task — no duplicate module refs leak on rapid clicks.
        var t = _editorSelectTask;
        if (t is null)
            t = _editorSelectTask = JS.InvokeAsync<IJSObjectReference>("import", "./js/editor-select.js").AsTask();
        // Per-caller WaitAsync(ct): a navigation's cancellation finishes promptly
        // WITHOUT canceling the shared import Task (a newer click reuses it).
        try { return await t.WaitAsync(ct).ConfigureAwait(false); }
        catch (System.OperationCanceledException) { return null; } // per-caller cancel; do NOT fault the shared task
        catch (JSException)
        {
            // Genuine interop fault: clear the shared task BY IDENTITY so a
            // later caller retries, but an old failed/canceled import cannot
            // clear a newer cached import (different task).
            if (System.Threading.Tasks.Task<IJSObjectReference>.ReferenceEquals(_editorSelectTask, t)) _editorSelectTask = null;
            return null;
        }
    }

    private void ScheduleAutosave()
    {
        CancelAutosave();
        if (_pageDisposed || Coordinator.Project is not { } project) return;
        var session = Coordinator.SessionId;
        var timer = _autosaveCts = new System.Threading.CancellationTokenSource();
        var token = timer.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(2), token);
                await InvokeAsync(async () =>
                {
                    // A cancelled debounce can already be queued on the renderer.
                    // Never let an old page/timer save whichever project is open.
                    if (_pageDisposed || token.IsCancellationRequested || !ReferenceEquals(_autosaveCts, timer)
                        || Coordinator.SessionId != session || Coordinator.Project?.Id != project.Id) return;
                    await Coordinator.SaveSessionAsync(project.Id, session, token);
                    if (!_pageDisposed && Coordinator.SessionId == session && Coordinator.Project?.Id == project.Id)
                        StateHasChanged();
                });
            }
            catch (System.OperationCanceledException) { /* debounce/page/session superseded; no retry loop */ }
        });
    }

    private void CancelAutosave()
    {
        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();
        _autosaveCts = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_pageDisposed) return; // idempotent
        _pageDisposed = true;
        DisposeAssistance();
        _articleStarter?.Dispose();
        if (_projectRename is { } rename) { rename.Changed -= ProjectRenameChanged; rename.Dispose(); }
        Coordinator.WorkspaceChanged -= CompletionAuthorityChanged;
        _completions?.Dispose();
        if (_singleFileImport is { } importer) { importer.Changed -= SingleFileImportChanged; importer.Dispose(); }
        // 1. SYNCHRONOUS, bounded teardown FIRST: unsubscribe events and
        //    cancel analysis/nav/autosave, and release owned refs — BEFORE any
        //    await that could be unbounded (a blocked editor-module import).
        //    Never dispose the injected AnalysisCoordinator/ISourceAnalyzer:
        //    DI owns them (scoped = app lifetime in WASM); returning to this
        //    page must reuse the same coordinator.
        Coordinator.WorkspaceChanged -= CompilerSourceAuthorityChanged;
        CompileSession.Changed -= CompilerSourceAuthorityChanged;
        _compilerSource.Dispose();
        _syncNavigation.Dispose();
        AnalysisCoord.Changed -= OnAnalysisChanged;
        ReviewService.Changed -= OnReviewChanged;
        _reviewIntent++;
        _reviewCts?.Cancel();
        ReviewService.Cancel(); // cancel page work, never dispose the scoped service or erase accepted recovery
        AnalysisCoord.Cancel();
        CancelSelectionIntents();
        CancelAutosave();
        // Unsubscribe the readiness callback BEFORE disposing the DotNet ref
        // (so no .NET callback fires after the ref is gone). The JS glue
        // clears the sink only if it is still owned by THIS subscription.
        var readinessSubId = _offlineReadinessSubId;
        var readinessMod = _offlineReadinessModule;
        _offlineReadinessSubId = null;
        _offlineReadinessModule = null;
        var refObj = _offlineReadinessRef;
        _offlineReadinessRef = null;
        if (readinessMod is not null && readinessSubId is not null)
        {
            try { await readinessMod.InvokeVoidAsync("unsubscribeOfflineReadiness", readinessSubId); }
            catch (JSException) { /* best-effort */ }
        }
        refObj?.Dispose();
        // 2. Editor-select module: do NOT await an in-flight import in the dispose
        //    path (it could be blocked forever, e.g. a held route in tests or a
        //    network stall). Snapshot the task BY IDENTITY and attach an OBSERVED
        //    eventual-cleanup task that disposes the late module exactly once —
        //    without reviving the page, selecting/activating anything, or calling
        //    StateHasChanged. A newer page's import is a DIFFERENT task, so an
        //    old failed/canceled import cannot clear it.
        var modTask = _editorSelectTask;
        _editorSelectTask = null;
        if (modTask is not null)
            _ = DisposeEditorSelectLaterAsync(modTask);
        // 3. Dispose the readiness module ref (already imported; bounded await).
        if (readinessMod is not null)
        {
            try { await readinessMod.DisposeAsync(); } catch (JSException) { /* best-effort */ }
        }
        await ValueTask.CompletedTask;
    }

    private async System.Threading.Tasks.Task DisposeEditorSelectLaterAsync(
        System.Threading.Tasks.Task<IJSObjectReference> modTask)
    {
        // Observed eventual cleanup: dispose the late module exactly once. The
        // captured modTask is this page's import (identity); a newer page's
        // import is a different task and is unaffected. Never selects/activates
        // or revives the page; no StateHasChanged. All exceptions are caught so
        // the task never faults (no unobserved exception).
        try
        {
            var m = await modTask.ConfigureAwait(false);
            await m.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSException) { /* best-effort teardown */ }
        catch (System.OperationCanceledException) { /* best-effort */ }
    }
}
