    // Conservative exact UTF-8 preflight (including BOM), shared document limits.
    // Existing coordinator remains authoritative for writer/recovery/dirty state.
    private long SourceByteBudget(SourceToolSnapshot snapshot)
    {
        if (Coordinator.Files.Count(f => !f.Deleted) > Client.Workspace.Patching.WorkspaceTextLimits.FileCount) return -1;
        long otherBytes = 0;
        foreach (var file in Coordinator.Files.Where(f => !f.Deleted && f.Id != snapshot.File))
        {
            if (file.MediaKind == "text")
            {
                if (!SourceTools.ValidText(file.Content, out int bytes)) return -1;
                otherBytes += bytes + (file.HasBom ? 3 : 0);
            }
            else
            {
                long length = file.BinaryContent?.LongLength ?? file.DurableLength;
                if (length < 0) return -1;
                otherBytes += length;
            }
            if (otherBytes > Client.Workspace.Patching.WorkspaceTextLimits.ProjectBytes) return -1;
        }
        long bom = Coordinator.ActiveFile?.HasBom == true ? 3 : 0;
        return Math.Min(Client.Workspace.Patching.WorkspaceTextLimits.FileBytes - bom,
            Client.Workspace.Patching.WorkspaceTextLimits.ProjectBytes - otherBytes - bom);
    }

    private async Task RunSourceToolAsync(string action)
    {
        if (_sourceBusy || _pageDisposed) return;
        var ct = NavCancelAndStart();
        var owner = new object();
        _sourceOperation = owner;
        _sourceStatus = "Source action in progress…";
        try { await ExecuteSourceToolAsync(action, ct, owner); }
        finally
        {
            // A successful edit keeps ownership until post-render selection
            // settles. An old finalizer cannot release a newer action's busy state.
            if (_sourceSelection is not { } pending || !ReferenceEquals(pending.Owner, owner))
                FinishSourceOperation(owner);
        }
    }

    private async Task ExecuteSourceToolAsync(string action, System.Threading.CancellationToken ct, object owner)
    {
        bool editing = action is not ("next" or "previous");
        var snapshot = SourceToolSnapshot.Capture(Coordinator, _sourceIntent);
        string query = _sourceQuery, replacement = _sourceReplacement;
        bool matchCase = _sourceCase;
        if (snapshot is null || !snapshot.IsCurrent(Coordinator, _sourceIntent, editing) || _pageDisposed)
        { _sourceStatus = "A current writable text file is required for edits."; return; }
        if (!SourceTools.ValidText(snapshot.Text, out _))
        { _sourceStatus = "Source is invalid or exceeds the document budget; no changes made."; return; }
        try
        {
            if (!SourceOperationCurrent(owner, snapshot, ct, editing)) return;
            var module = await GetEditorSelectAsync(ct);
            // Cancellation/staleness takes precedence over null, which the
            // shared-import helper also returns for per-caller cancellation.
            if (!SourceOperationCurrent(owner, snapshot, ct, editing)) return;
            if (module is null) { _sourceStatus = "Source selection module unavailable; reload when provisioned."; return; }
            var dom = await module.InvokeAsync<SourceDomRange?>("readSelection", _editorRef,
                snapshot.File.ToString(), SourceTools.TextareaText(snapshot.Text));
            if (!SourceOperationCurrent(owner, snapshot, ct, editing)) return;
            if (dom is not { Start: { } start, End: { } end } ||
                !SourceTools.TryFromTextarea(snapshot.Text, new(start, end), out var selection))
            { _sourceStatus = "Selection or source is invalid; no changes made."; return; }
            if (!editing)
            {
                var matches = SourceTools.Find(snapshot.Text, selection, query, matchCase, action == "previous");
                _sourceStatus = matches is null ? "Invalid source or search text." : $"{matches.Ordinal} of {matches.Count} matches (wrap enabled).";
                if (matches?.Selection is { } found) await SelectSourceToolAsync(snapshot, found, true, ct, owner);
                return;
            }
            long budget = SourceByteBudget(snapshot);
            SourceEdit? edit = action switch
            {
                "indent" => SourceTools.Lines(snapshot.Text, selection, LineTool.Indent, budget),
                "unindent" => SourceTools.Lines(snapshot.Text, selection, LineTool.Unindent, budget),
                "comment" => SourceTools.Lines(snapshot.Text, selection, LineTool.ToggleComment, budget),
                "replace" or "all" => SourceTools.Replace(snapshot.Text, selection, query, replacement, matchCase, action == "all", budget),
                _ => null
            };
            if (edit is null)
            { _sourceStatus = "No edit: select an exact match for Replace current; check text, range and size limits."; return; }
            if (edit.Text == snapshot.Text) { _sourceStatus = "No text changes."; return; }
            ApplyOrdinarySourceEdit(owner, snapshot, edit, ct);
        }
        catch (JSException)
        {
            if (SourceOperationCurrent(owner, snapshot, ct, editing))
                _sourceStatus = "Source selection unavailable; no further action applied.";
        }
        catch (System.Text.Json.JsonException)
        {
            if (SourceOperationCurrent(owner, snapshot, ct, editing))
                _sourceStatus = "Invalid source selection response; no changes made.";
        }
    }

    private bool ApplyOrdinarySourceEdit(object owner, SourceToolSnapshot snapshot, SourceEdit edit, System.Threading.CancellationToken ct)
    {
        if (!SourceOperationCurrent(owner, snapshot, ct, true)) return false;
        // Existing ordinary edit path, shared without another autosave/commit.
        ActiveContent = edit.Text;
        if (Coordinator.WorkingGeneration != snapshot.Generation + 1 || Coordinator.ActiveFile is not { } active || active.Content != edit.Text)
        { _sourceStatus = "Edit was not accepted by the workspace."; return false; }
        var body = System.Text.Encoding.UTF8.GetBytes(edit.Text);
        var bytes = active.HasBom ? Client.Workspace.Transfer.TextContent.Bom.Concat(body).ToArray() : body;
        active.PendingTextBytes = Client.Workspace.Patching.ExactTextBytes.OwnPrepared(bytes);
        _sourceSelection = (SourceToolSnapshot.Capture(Coordinator, _sourceIntent)!, edit.Selection, ct, owner);
        _sourceStatus = "Source edited; ordinary autosave applies.";
        return true;
    }

    private bool FinishSourceOperation(object owner)
    {
        if (!ReferenceEquals(_sourceOperation, owner)) return false;
        _sourceOperation = null;
        return true;
    }

    private bool SourceOperationCurrent(object owner, SourceToolSnapshot snapshot, System.Threading.CancellationToken ct, bool editing)
    {
        // Superseding navigation/query handlers own their newer notices. Only
        // this operation may report same-intent source/revision staleness.
        if (_pageDisposed || !ReferenceEquals(_sourceOperation, owner)
            || ct.IsCancellationRequested || snapshot.Intent != _sourceIntent) return false;
        if (snapshot.IsCurrent(Coordinator, _sourceIntent, editing)
            && (!ReferenceEquals(_completionOperation, owner) || _completionApplied is null
                || _completions?.IsPostEditCurrent(_completionApplied, snapshot, _sourceIntent) == true)) return true;
        _sourceStatus = "Source or file changed; action discarded. Try again.";
        return false;
    }

    private async Task<bool> SelectSourceToolAsync(SourceToolSnapshot snapshot, SourceRange range, bool finding, System.Threading.CancellationToken ct, object owner)
    {
        if (!SourceOperationCurrent(owner, snapshot, ct, !finding)) return false;
        var module = await GetEditorSelectAsync(ReferenceEquals(_completionOperation, owner) ? System.Threading.CancellationToken.None : ct);
        if (!SourceOperationCurrent(owner, snapshot, ct, !finding)) return false;
        if (module is null) { _sourceStatus = "Source selection module unavailable; reload when provisioned."; return false; }
        if (SourceTools.ToTextarea(snapshot.Text, range) is not { } dom) return false;
        bool selected = await module.InvokeAsync<bool>(finding ? "trySelectForFind" : "trySelect", _editorRef,
            snapshot.File.ToString(), SourceTools.TextareaText(snapshot.Text), dom.Start, dom.End);
        if (!SourceOperationCurrent(owner, snapshot, ct, !finding)) return false;
        if (!selected) _sourceStatus = "Source selection changed; action discarded. Try again.";
        return selected;
    }

