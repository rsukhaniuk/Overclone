    private async Task OnImportZip(InputFileChangeEventArgs e)
    {
        if (_projectRename?.TryOtherAction() == false) return;
        var file = e.File;
        await using var stream = file.OpenReadStream(maxAllowedSize: ArchiveLimits.ZipInputSize);
        using var ms = new System.IO.MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();
        var defaultName = System.IO.Path.GetFileNameWithoutExtension(file.Name);
        if (string.IsNullOrEmpty(defaultName)) defaultName = "Imported project";
        var result = await Transfer.StageZipImportAsync(bytes, defaultName, System.Threading.CancellationToken.None);
        _staged = result.Staged;
        _stagedExcluded = result.ExcludedTrees;
        _stagedName = result.Staged.Name;
        _transferStatus = result.Valid ? null : "Archive has validation errors; review before publishing.";
        _transferOk = result.Valid;
        StateHasChanged();
    }

