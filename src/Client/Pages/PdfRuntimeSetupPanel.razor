@using Client.Compilation.Provisioning
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject PdfRuntimeSetupFactory Factory
<details data-testid="local-pdf-resources">
    <summary>Local PDF renderer resources</summary>
    <p>Advanced: verify and store a local PDF renderer loader and WASM file using their resource manifest. The manifest declares byte integrity, not trusted executable provenance. The installer does not download or execute these bytes. Preview separately checks the application's exact supported E1 renderer when used.</p>
    <label>PDF resource manifest
        <InputFile OnChange="ManifestSelected" disabled="@Busy" data-testid="pdf-runtime-manifest" />
    </label>
    <label>Matching loader and WASM files
        <InputFile OnChange="ResourcesSelected" multiple disabled="@Busy" data-testid="pdf-runtime-files" />
    </label>
    <p>@_selection</p>
    <div class="actions">
        <button @onclick="Install" disabled="@(Busy || _manifest is null || _files.Length != 2)" data-testid="pdf-runtime-install">Verify and install PDF resources</button>
        <button @onclick="Recheck" disabled="@Busy" data-testid="pdf-runtime-recheck">Recheck stored PDF resources</button>
        <button @onclick="Cancel" disabled="@(!Busy || !(_readingManifest || _setup.CanCancel))" data-testid="pdf-runtime-cancel">Cancel preparation</button>
    </div>
    <p role="status" data-testid="pdf-runtime-status" data-state="@_setup.State" data-busy="@Busy.ToString().ToLowerInvariant()">@Status</p>
    <p>Resources are stored separately from projects, exports and AI context. Browser storage is not a backup: keep your local package. Installing arbitrary bytes does not select a trusted renderer. Preview uses only the application's exact supported E1 pair after fresh verification; compiler availability is independent.</p>
</details>
@code {
    private PdfRuntimeSetup _setup = default!;
    private IBrowserFile? _manifest;
    private IBrowserFile[] _files = [];
    private bool _disposed, _readingManifest;
    private CancellationTokenSource? _manifestCancel;
    private string _selection = "No local PDF resource files selected.";
    private string? _inputError;
    private bool Busy => _readingManifest || _setup.Busy;
    protected override void OnInitialized() { _setup = Factory.Create(); _setup.Changed += Changed; }
    private string Status => _inputError ?? (_readingManifest ? "Reading PDF resource manifest…" : _setup.State switch
    {
        PdfRuntimeSetupState.Empty => "No PDF resources verified in this session. Select local files, or recheck a previous installation.",
        PdfRuntimeSetupState.Preparing => $"Verifying PDF resource bytes… {_setup.Completed} of 2 files read.",
        PdfRuntimeSetupState.Finishing => "Finishing… waiting for reads or storage to settle. Publication cannot be cancelled once started.",
        PdfRuntimeSetupState.Installed => "PDF resources installed. Preview separately verifies the supported E1 renderer when used.",
        PdfRuntimeSetupState.InvalidSelection => "Invalid PDF resource selection. Choose a version 1 manifest and exactly its matching loader and WASM files, with no duplicates or extras.",
        PdfRuntimeSetupState.Cancelled => "Preparation cancelled. Previous stored PDF selection was not replaced.",
        PdfRuntimeSetupState.TimedOut => "Preparation timed out. Previous stored PDF selection was not replaced. Reselect your local files and retry.",
        PdfRuntimeSetupState.Busy => "Resource storage is busy. Wait or close other installer tabs, then recheck.",
        PdfRuntimeSetupState.Missing => "Stored PDF resources are missing or incomplete. Select your local package to reinstall.",
        PdfRuntimeSetupState.Corrupt => "PDF resource bytes failed integrity or WASM header verification. Select the matching local files to retry.",
        PdfRuntimeSetupState.Unavailable => "Runtime storage is unavailable. Use a browser with OPFS and Web Locks support.",
        PdfRuntimeSetupState.QuotaExceeded => "Not enough browser storage. Free storage, keep your package, then retry.",
        PdfRuntimeSetupState.PermissionDenied => "Browser storage permission denied. Check site permissions, then recheck.",
        PdfRuntimeSetupState.Uncertain => "PDF resource installation completion is uncertain. Recheck before retrying; no package or project data was deleted.",
        _ => "PDF resource storage failed. Check browser storage permissions and space, then recheck."
    });
    private void ManifestSelected(InputFileChangeEventArgs e)
    {
        if (Busy) return; _inputError = null;
        if (e.FileCount != 1 || e.File.Size > PdfRuntimeSelection.MaxManifestBytes) { _manifest = null; _inputError = "Choose one PDF resource manifest no larger than 64 KiB."; return; }
        _manifest = e.File; _selection = "Manifest selected. Select its loader and WASM files.";
    }
    private void ResourcesSelected(InputFileChangeEventArgs e)
    {
        if (Busy) return; _inputError = null; _files = [];
        if (e.FileCount != 2) { _inputError = "Select exactly the two matching PDF resource files."; return; }
        _files = e.GetMultipleFiles(2).ToArray(); _selection = "Two PDF resource files selected. Verify and install to check their bytes.";
    }
    private async Task Install()
    {
        if (Busy || _manifest is null) return;
        _inputError = null; _readingManifest = true; _manifestCancel = new();
        _manifestCancel.CancelAfter(PdfRuntimeSelection.PreparationDeadlineMs);
        try
        {
            var manifest = await Read(_manifest, PdfRuntimeSelection.MaxManifestBytes, _manifestCancel.Token);
            _manifestCancel.Token.ThrowIfCancellationRequested();
            var files = _files.Select(f => new LocalRuntimeFile(f.Name, f.Size, token => Read(f, PdfRuntimeSelection.MaxWasmBytes, token))).ToArray();
            _readingManifest = false;
            if (!_disposed) await _setup.InstallAsync(manifest, files);
        }
        catch (OperationCanceledException) { if (!_disposed) _inputError = "Manifest preparation was cancelled or timed out. Previous stored PDF selection was not replaced."; }
        catch (Exception error) when (error is not OutOfMemoryException) { if (!_disposed) _inputError = "Selected PDF resource files could not be read. Reselect your local files and retry."; }
        finally { _readingManifest = false; _manifestCancel.Dispose(); _manifestCancel = null; }
    }
    private static async Task<byte[]> Read(IBrowserFile file, long max, CancellationToken token)
    {
        if (file.Size < 0 || file.Size > max) throw new IOException("Selected file exceeds PDF resource limit.");
        await using var stream = file.OpenReadStream(max, token);
        var bytes = new byte[checked((int)file.Size)]; await stream.ReadExactlyAsync(bytes, token);
        var extra = new byte[1]; if (await stream.ReadAsync(extra, token) != 0) throw new IOException("Selected resource size changed.");
        return bytes;
    }
    private Task Recheck() { if (Busy) return Task.CompletedTask; _inputError = null; return _setup.RecheckAsync(); }
    private void Cancel() { if (_readingManifest) _manifestCancel?.Cancel(); else _setup.Cancel(); }
    private void Changed() { if (!_disposed) _ = Render(); }
    private async Task Render()
    {
        try { await InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) when (_disposed) { }
    }
    public async ValueTask DisposeAsync()
    { _disposed = true; _manifestCancel?.Cancel(); _setup.Changed -= Changed; await _setup.DisposeAsync(); }
}
