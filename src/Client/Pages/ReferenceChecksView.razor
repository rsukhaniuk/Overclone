@using Client.Analysis
@if (Report.Result.Profile.Id == AnalysisCatalog.ReferenceId && Report.Result.ReferenceConfiguration is { } configuration)
{
    <details class="check-details" data-testid="reference-checks" aria-label="Source reference checks"
             data-root-file-id="@configuration.RootFileId" data-snapshot-id="@Report.Result.SnapshotId"
             data-profile-version="@AnalysisCatalog.ReferenceVersion">
        <summary>Reference coverage</summary>
        <p>Checks literal project-local inputs, includes, labels and references.</p>
        @foreach (var rule in Report.Result.RuleResults.Where(r => r.RuleId is AnalysisCatalog.Labels or AnalysisCatalog.References))
        {
            <section data-testid="reference-rule" data-rule-id="@rule.RuleId" data-outcome="@rule.Outcome">
                <h4>@AnalysisPresentation.SourceRule(rule.RuleId) · @rule.Outcome</h4>
                <ul>
                    @foreach (var limitation in rule.Limitations)
                    { <li>@ReferenceChecks.Limitation(limitation)</li> }
                </ul>
            </section>
        }
    </details>
}
@code {
    // Parent supplies only its current usable report; correlation attributes are
    // always this report's identities, never current dropdown values.
    [Parameter, EditorRequired] public AnalysisReport Report { get; set; } = default!;
}
