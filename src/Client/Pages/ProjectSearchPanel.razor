@using Client.Editing.Search
@using Client.Workspace
@using Client.Workspace.Domain
@implements IDisposable
@inject WorkspaceCoordinator Coordinator
@inject IWorkspaceLocks ReplacementLocks
@inject IProjectRepository ReplacementRepository

@{
    // Full currentness is checked once per render, not500 times over5000
    // files. Click handlers independently revalidate immediately before action.
    bool resultsCurrent = SearchSession.IsCurrentReport(SearchSession.Report);
    bool canReplace = CanReplace;
}
<section aria-label="Project search" data-testid="project-search-panel" data-busy="@(Busy.ToString().ToLowerInvariant())">
    <label>Find literal text
        <input type="text" @bind="_query" @bind:event="oninput" @bind:after="FindChanged" maxlength="1024" data-testid="project-search-query" />
    </label>
    <label><input type="checkbox" @bind="_caseSensitive" @bind:after="FindChanged" data-testid="project-search-case" /> Case sensitive</label>
    <button type="button" @onclick="Search" disabled="@Busy" data-testid="project-search-submit">Search</button>
    <button type="button" @onclick="Cancel" disabled="@(!Busy && SearchSession.Report.Matches.IsEmpty)" data-testid="project-search-cancel">Cancel / invalidate</button>
    <small>Literal text in current text files. Binary files are skipped. No regex or automatic source edits.</small>
    <p role="status" aria-live="polite" data-testid="project-search-status" data-search-status="@SearchSession.Report.Status">@SearchSession.Report.Notice</p>
    @if (Busy) { <p role="status">Search or replacement preview is settling. Cancellation revokes actions immediately; active reads/callbacks must finish before another request.</p> }
    @if ((_navigationNotice ?? NavigationStatus) is { } navigationStatus) { <p role="status" data-testid="project-search-navigation-status">@navigationStatus</p> }
    @if (_notice is not null) { <p role="status" data-testid="project-replace-status">@_notice</p> }
    <label>Literal replacement
        <textarea @bind="_replacement" @bind:event="oninput" @bind:after="ReplacementChanged" data-testid="project-replace-text" maxlength="8388608"></textarea>
    </label>
    <p>Only selected matches are proposed. Every selection/replacement change requires a fresh exact review. Accept, decline, Undo and save retry remain in the existing review workflow.</p>
    @if (!OnPreviewRequested.HasDelegate) { <p>Replacement review is unavailable in this host.</p> }
    @if (Coordinator.IsReadOnly || Coordinator.Recovery is not null) { <p>Read-only/recovery: search and navigation remain available; replacement preview requires the current writer.</p> }
    @if (SearchSession.Report.Status is ProjectSearchStatus.Complete or ProjectSearchStatus.Truncated)
    {
        <p data-testid="project-search-summary">@SearchSession.Report.Matches.Length listed matches; @SearchSession.Report.TextFiles text files; @SearchSession.Report.BinaryFiles binary files skipped.</p>
        <p>Last search: <code>@_searchedQuery</code> (@(_searchedCase ? "case sensitive" : "ignore case")).</p>
        @if (SearchSession.Report.Status == ProjectSearchStatus.Complete)
        { <button type="button" @onclick="SelectAllComplete" disabled="@(!canReplace)" data-testid="project-replace-all">Select all complete matches</button> }
        else { <p data-testid="project-replace-incomplete">Incomplete listing: Replace all is unavailable. Narrow and search again, or explicitly select listed matches as a subset.</p> }
        <button type="button" @onclick="SelectListed" disabled="@(!canReplace)" data-testid="project-replace-listed">Select listed matches only</button>
        <button type="button" @onclick="ClearSelection" disabled="@Busy">Clear selection</button>
        <label>File selection
            <select @bind="_fileSelection" disabled="@(!canReplace)" data-testid="project-replace-file">
                <option value="">Choose a result file</option>
                @foreach (var group in SearchSession.Report.Matches.GroupBy(m => m.FileId))
                { <option value="@group.Key.ToString()">@group.First().RelativePath</option> }
            </select>
        </label>
        <button type="button" @onclick="SelectFile" disabled="@(!canReplace)" data-testid="project-replace-select-file">Select listed matches in file</button>
        <p data-testid="project-replace-selection">@_selected.Count match(es) in @(_selected.Select(m => m.FileId).Distinct().Count()) file(s) selected; maximum500 matches /100 files per proposal. @(_allComplete ? "All complete matches selected." : "Explicit listed subset selected; not Replace all.")</p>
        <button type="button" @onclick="PreviewSelected" disabled="@(!canReplace || _selected.Count == 0)" data-testid="project-replace-preview">Preview selected replacements</button>
        <ol aria-label="Project search results" data-testid="project-search-results">
            @foreach (var match in SearchSession.Report.Matches)
            {
                <li @key="match">
                    <label><input type="checkbox" checked="@_selected.Contains(match)" @onchange="e => Select(match, e.Value is true)"
                        disabled="@(!canReplace)" data-testid="project-replace-match" /> Select replacement</label>
                    <button type="button" @onclick="() => Navigate(match)" disabled="@(!OnNavigate.HasDelegate || Busy || !resultsCurrent)" data-testid="project-search-result"
                            data-source-path="@match.RelativePath" data-source-start="@match.Start" data-source-end="@match.End">
                        <span>@match.RelativePath — line @match.Line, column @match.Column</span><code>@match.Snippet</code>
                    </button>
                </li>
            }
        </ol>
        @if (!OnNavigate.HasDelegate) { <p>Source navigation is unavailable in this host.</p> }
    }
</section>

@code {
    [Parameter] public ProjectSearchSession? Session { get; set; }
    [Parameter] public ProjectReplaceSession? Replacements { get; set; }
    [Parameter] public EventCallback<ProjectSearchNavigationRequest> OnNavigate { get; set; }
    [Parameter] public EventCallback<ProjectReplaceRequest> OnPreviewRequested { get; set; }
    [Parameter] public string? NavigationStatus { get; set; }
    private ProjectSearchSession? _session, _initialParameter;
    private ProjectReplaceSession? _replace, _initialReplace;
    private bool _ownsSession, _ownsReplace, _disposed, _pending;
    private string _query = "", _replacement = "", _fileSelection = "";
    private bool _caseSensitive = true, _searchedCase, _allComplete;
    private string _searchedQuery = "";
    private string? _navigationNotice, _notice;
    private readonly HashSet<ProjectSearchMatch> _selected = new();
    private ProjectSearchReport? _seenReport;
    private Task? _renderTask;
    private ProjectSearchSession SearchSession => _session!;
    private bool Busy => _pending || SearchSession.Busy || _replace!.Busy;
    private bool CanReplace => !Busy && OnPreviewRequested.HasDelegate && _replace!.CanRequest;
    protected override void OnParametersSet()
    {
        if (_session is not null)
        {
            if (!ReferenceEquals(_initialParameter, Session) || !ReferenceEquals(_initialReplace, Replacements))
                throw new InvalidOperationException("Search/replacement sessions are fixed for the component lifetime. Remount to change them.");
            return;
        }
        _initialParameter = Session; _initialReplace = Replacements; _ownsSession = Session is null; _ownsReplace = Replacements is null;
        _session = Session ?? new ProjectSearchSession(Coordinator);
        _replace = Replacements ?? new ProjectReplaceSession(Coordinator, _session, ReplacementLocks, ReplacementRepository);
        _seenReport = _session.Report; _session.Changed += Changed;
    }
    private void FindChanged() { _notice = null; SearchSession.Cancel(); }
    private void ReplacementChanged() { _replace!.Invalidate(); _notice = "Replacement changed; request a fresh preview."; }
    private void Cancel() { SearchSession.Cancel(); _replace!.Cancel(); _selected.Clear(); _allComplete = false; }
    private void SelectionChanged() { _replace!.Invalidate(); _notice = null; _allComplete = false; }
    private void Select(ProjectSearchMatch match, bool value) { if (!CanReplace) return; SelectionChanged(); if (value) _selected.Add(match); else _selected.Remove(match); }
    private void ClearSelection() { SelectionChanged(); _selected.Clear(); }
    private void SelectListed() { if (!CanReplace) return; SelectionChanged(); _selected.Clear(); foreach (var m in SearchSession.Report.Matches) _selected.Add(m); }
    private void SelectAllComplete() { if (SearchSession.Report.Status != ProjectSearchStatus.Complete) return; SelectListed(); _allComplete = true; }
    private void SelectFile()
    {
        if (!CanReplace || !Guid.TryParse(_fileSelection, out var id)) return;
        SelectionChanged(); foreach (var m in SearchSession.Report.Matches.Where(m => m.FileId.Value == id)) _selected.Add(m);
    }
    private async Task Search()
    {
        if (Busy) return; _pending = true; _navigationNotice = null; _notice = null;
        _searchedQuery = _query; _searchedCase = _caseSensitive;
        try { await SearchSession.SearchAsync(_query, _caseSensitive); }
        finally { await DrainRender(); _pending = false; }
    }
    private async Task PreviewSelected()
    {
        if (!CanReplace) return;
        var created = _replace!.CreateRequest(_selected, _replacement, _allComplete);
        if (created.Request is null) { _notice = $"Replacement preview unavailable: {created.Code}. No edits were applied."; return; }
        _pending = true;
        try
        {
            // Parent owns generic review admission and awaits request.PreviewAsync
            // inside its existing review wrapper. Await its actual callback.
            await OnPreviewRequested.InvokeAsync(created.Request);
            if (!_disposed) _notice = "Preview request finished. Inspect the review result; this panel has applied no edits.";
        }
        catch (Exception) { if (!_disposed) _notice = "Preview presentation could not finish. Inspect the existing review state; any recovery remains there."; }
        finally { await DrainRender(); _pending = false; }
    }
    private async Task Navigate(ProjectSearchMatch match)
    {
        var request = SearchSession.TryNavigate(match);
        if (request is null || Busy) { _navigationNotice = "This result is no longer current. Choose Search again."; return; }
        _navigationNotice = null; await OnNavigate.InvokeAsync(request);
    }
    private void Changed()
    {
        if (_disposed) return;
        if (!ReferenceEquals(_seenReport, SearchSession.Report)) { _seenReport = SearchSession.Report; _selected.Clear(); _allComplete = false; }
        if (_renderTask is not { IsCompleted: false }) _renderTask = Render();
    }
    private async Task DrainRender() { if (_renderTask is { } actual) await actual; }
    private async Task Render()
    {
        try { await InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) when (_disposed) { }
    }
    public void Dispose()
    {
        if (_disposed) return; _disposed = true; if (_session is null) return;
        _session.Changed -= Changed;
        if (_ownsReplace) _replace!.Dispose(); else _replace!.Cancel();
        if (_ownsSession) _session.Dispose(); else _session.Cancel();
    }
}
