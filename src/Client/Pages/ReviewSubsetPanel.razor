@using Client.Review
@using Client.Workspace.Patching

<section aria-label="Select reviewed edits" data-testid="review-subsets">
    @if (State.Preview is { } preview)
    {
        <h3>Select edits for a NEW preview</h3>
        <p>Nothing is applied by selecting. Accept, Decline, save recovery and one-action Undo remain in the review panel. Only stable file IDs and original proposal edit indexes are selected; line-diff summaries are not selectable evidence.</p>
        @if (preview.Proposal.Origin == TextPatchOrigin.Rule)
        {
            <p data-testid="subset-rule-indivisible">Canonical rule fixes are indivisible here. Use the original canonical Preview fix / Accept / Decline path; generic subsetting is unavailable.</p>
        }
        else
        {
            <p data-testid="subset-scope">@_selected.Count selected of @Total exact original edits. Showing at most @PageSize per page. Large text excerpts are bounded: selecting an edit selects its WHOLE exact replacement, never a guessed fragment.</p>
            @foreach (var choice in Visible())
            {
                var file = choice.File;
                var edit = file.Edits[choice.Index];
                var bound = preview.Id;
                <div @key="(file.FileId, choice.Index)" data-testid="subset-edit" data-file-id="@file.FileId" data-edit-index="@choice.Index">
                    <label><input type="checkbox" data-testid="subset-choice" checked="@_selected.Contains(new(file.FileId, choice.Index))" disabled="@(!Enabled)" @onchange="e => Toggle(bound, new(file.FileId, choice.Index), e)" />@file.RelativePath — original edit @choice.Index</label>
                    <p>File @file.FileId; preimage @file.ExpectedHash.Hex (@file.ExpectedLength bytes). UTF-8 bytes [@edit.StartByte, @edit.EndByte); @edit.Expected.Length expected → @edit.Replacement.Length replacement bytes. BOM and newline bytes are not normalized.</p>
                    <h4>Exact expected excerpt</h4><pre data-testid="subset-expected">@ReviewPresentation.Bytes(edit.Expected.Span)</pre>
                    <h4>Exact replacement excerpt</h4><pre data-testid="subset-replacement">@ReviewPresentation.Bytes(edit.Replacement.Span)</pre>
                    @if (file.Edits.Length == 1 && edit.StartByte <= 3 && edit.EndByte == file.ExpectedLength)
                    { <p>Whole-file text route (retaining any BOM); no speculative splitting.</p> }
                </div>
            }
            <button data-testid="subset-previous" disabled="@(_offset == 0 || State.Busy || Working)" @onclick="Previous">Previous exact edits</button>
            <button data-testid="subset-next" disabled="@(_offset + PageSize >= Total || State.Busy || Working)" @onclick="Next">Next exact edits</button>
            <button data-testid="subset-preview" disabled="@(!Enabled || _selected.Count == 0)" @onclick="PreviewSelected">Preview selected edits</button>
            <p>A new preview must be reviewed and explicitly accepted. Unselected bytes stay untouched. A pending unsaved action retains its recovery and must be resolved before accepting another.</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public ReviewServiceState State { get; set; } = null!;
    [Parameter] public bool Writable { get; set; }
    [Parameter] public bool Working { get; set; }
    [Parameter] public EventCallback<ReviewSubsetRequest> Preview { get; set; }
    private const int PageSize = 50;
    private readonly HashSet<ReviewSelectedEdit> _selected = new();
    private Guid? _bound;
    private int _offset;
    private int Total => State.Preview?.Proposal.Files.Sum(f => f.Edits.Length) ?? 0;
    private bool Enabled => Writable && !Working && !State.Busy && State.Status == ReviewStatus.Ready
        && State.Preview is { } p && p.Id == _bound && p.Proposal.Origin is TextPatchOrigin.User or TextPatchOrigin.Ai;
    protected override void OnParametersSet()
    {
        if (_bound == State.Preview?.Id) return;
        _bound = State.Preview?.Id; _selected.Clear(); _offset = 0;
    }
    private IEnumerable<(ProposedFileChange File, int Index)> Visible()
        => (State.Preview?.Proposal.Files.SelectMany(f => f.Edits.Select((_, i) => (f, i))) ?? Enumerable.Empty<(ProposedFileChange, int)>()).Skip(_offset).Take(PageSize);
    private void Toggle(Guid bound, ReviewSelectedEdit edit, ChangeEventArgs e)
    {
        if (!Enabled || bound != _bound) return;
        if (e.Value is true) _selected.Add(edit); else _selected.Remove(edit);
    }
    private void Previous() => _offset = Math.Max(0, _offset - PageSize);
    private void Next() { if (_offset + PageSize < Total) _offset += PageSize; }
    private Task PreviewSelected()
    {
        if (!Enabled || _selected.Count == 0 || State.Preview is not { } p) return Task.CompletedTask;
        return Preview.InvokeAsync(new(p.Id, new(p.Proposal.Id, _selected.ToArray())));
    }
}
