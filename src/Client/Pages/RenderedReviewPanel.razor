    private static int? EvidencePage(JsonElement evidence) => evidence.ValueKind == JsonValueKind.Object && evidence.TryGetProperty("pageIndex", out var page) && page.TryGetInt32(out var index) && index >= 0 ? index : null;
    private static string JsonText(JsonElement value, string property) => value.ValueKind == JsonValueKind.Object && value.TryGetProperty(property, out var part)
        ? part.ValueKind == JsonValueKind.String ? part.GetString() ?? "Not provided" : part.ValueKind == JsonValueKind.Number ? part.GetRawText() : "Not established"
        : "Not provided";
    private static string CitationLabel(JsonElement citation)
    {
        var section = JsonText(citation, "section");
        var pages = citation.ValueKind == JsonValueKind.Object && citation.TryGetProperty("printedPages", out var values) && values.ValueKind == JsonValueKind.Array
            ? string.Join(", ", values.EnumerateArray().Select(value => value.ToString())) : "not provided";
        return $"§{section}; printed pages {pages}";
    }
    private static string RoleLabel(string role) => Roles.FirstOrDefault(item => item.Id == role).Label ?? role;
    private static string CertaintyLabel(string certainty) => certainty == "confirmedObservation" ? "author-confirmed observation" : "tentative";
    private static string WorkTypeLabel(string type) => type switch { "coursework" => "Coursework", "bachelorQualification" => "Bachelor qualification", "masterQualification" => "Master qualification", _ => "Unspecified" };
    private static string AnnotationRange(RenderedRoleAnnotation value) => value.CharacterStart is null ? "whole page" : $"native characters [{value.CharacterStart}, {value.CharacterEnd})";
    private static string OutcomeLabel(string outcome) => outcome switch { "pass" => "consistent with this measured observation", "fail" => "review needed", "indeterminate" => "unknown", "unavailable" => "unavailable", "notApplicable" => "not applicable", _ => "unassessed" };
    private static string RuleLabel(string id) => id switch
    {
        "KNU-PAPER-001" => "Paper dimensions", "KNU-MARGINS-001" => "Margins", "KNU-TYPOGRAPHY-001" => "Typography",
        "KNU-PARAGRAPH-RENDERED-001" => "Paragraph layout", "KNU-HEADINGS-RENDERED-001" => "Headings", "KNU-PAGINATION-001" => "Pagination",
        "KNU-STRUCTURE-001" => "Document structure", "KNU-ABSTRACT-001" => "Abstract", "KNU-LENGTH-001" => "Length",
        "KNU-REFERENCES-001" => "References", "KNU-APPENDIX-001" => "Appendices", "KNU-CAPTION-RENDERED-001" => "Captions",
        "KNU-BIBLIOGRAPHY-RENDERED-001" => "Bibliography", _ => id
    };
    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true; _controller.Changed -= Changed;
        if (_ownsController) _controller.Dispose();
        _shown = null;
    }
}
