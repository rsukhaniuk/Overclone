    private bool TrySearchSelection(out SearchLabelDraft? draft, bool requireCurrentAnnotations = true)
    {
        draft = null;
        if (requireCurrentAnnotations && !_controller.AnnotationsCurrent || Compile.DisplayedOutput is not { } output || Compile.LastTicket is not { } ticket
            || !CurrentOutput(output, ticket)) return false;
        var state = Compile.Preview.State;
        if (state.Status != PdfPreviewStatus.Available || state.Frame is not { } frame || state.DocumentSha256 != output.OutputHash?.Hex
            || frame.Generation != state.Generation || frame.DocumentSha256 != state.DocumentSha256 || frame.PageIndex != state.PageIndex
            || state.NativeRequestId is not { Length: 32 } || state.NativeEpoch is null or <= 0
            || state.Search.Status is not (PdfPreviewSearchStatus.Complete or PdfPreviewSearchStatus.Partial) || state.Search.Query.Length == 0
            || state.SelectedHit < 0 || state.SelectedHit >= state.Search.Hits.Count) return false;
        var hit = state.Search.Hits[state.SelectedHit];
        long end = (long)hit.StartCharacterIndex + hit.CharacterCount;
        if (hit.PageIndex != state.PageIndex || hit.StartCharacterIndex < 0 || hit.CharacterCount <= 0 || end > state.Glyphs.Count || end > 100000) return false;
        var text = new StringBuilder();
        for (int index = hit.StartCharacterIndex; index < end; index++)
        {
            var glyph = state.Glyphs[index];
            if (glyph.Index != index || glyph.UnicodeValue == 0 || !Rune.TryCreate(glyph.UnicodeValue, out var scalar)) return false;
            text.Append(scalar.ToString());
        }
        if (!string.Equals(text.ToString(), hit.GlyphText, StringComparison.Ordinal)) return false;
        draft = new(output, ticket, Compile.Preview, state, hit, _controller.AnnotationVersion, _controller.WorkType); return true;
    }
