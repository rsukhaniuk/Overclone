    private async Task Render()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed) return;
                if (_shownProject != Workspace.Project?.Id || _shownSession != Workspace.SessionId)
                { _shown = null; _identityPage = 0; _evidencePages.Clear(); }
                if (_controller.Report is { } report && !ReferenceEquals(_shown, report))
                {
                    _shown = report; _shownWorkType = _controller.WorkType; _shownProject = Workspace.Project?.Id;
                    _shownSession = Workspace.SessionId; _identityPage = 0; _evidencePages.Clear();
                }
                if (Completed.HasDelegate && Compile.DisplayedOutput is { } compiled)
                {
                    // The controller publishes cumulative observations while it scans.
                    // Archive the settled run once, including partial results if retained.
                    if (!_controller.Busy && _controller.Report is { } settled && !ReferenceEquals(settled, _archivedLayout)
                        && compiled.OutputHash?.Hex == settled.Evidence.Compilation.PdfSha256)
                    {
                        _archivedLayout = settled;
                        var detail = string.Join(Environment.NewLine, settled.Results.Select(result =>
                            $"{result.RuleId} · {OutcomeLabel(result.Outcome)}. {result.Reason}\nGuideline {CitationLabel(result.Citation)}.\n"
                            + string.Join(Environment.NewLine, result.Evidence.Select(evidence => evidence.GetRawText()))));
                        await Completed.InvokeAsync(CheckReport.Create(compiled.SnapshotIdentity.ProjectId, "pdf", "Rendered layout review",
                            $"{settled.EvaluatedPages} of {settled.RequestedPages} pages inspected", compiled.SnapshotIdentity.BaseHeadRevisionId,
                            settled.Evidence.Compilation.PdfSha256, detail));
                    }
                    if (_controller.ReferencePairObservation is { } pair && !ReferenceEquals(pair, _archivedPair))
                    {
                        _archivedPair = pair;
                        await Completed.InvokeAsync(CheckReport.Create(compiled.SnapshotIdentity.ProjectId, "pdf", "Printed reference comparison",
                            pair.Comparison.ToString(), compiled.SnapshotIdentity.BaseHeadRevisionId, compiled.OutputHash?.Hex,
                            $"Citation: {pair.CitationNumber} · bibliography: {pair.EntryNumber}\n{pair.Reason}"));
                    }
                    if (_controller.CaptionImageObservation is { } caption && !ReferenceEquals(caption, _archivedCaption))
                    {
                        _archivedCaption = caption;
                        await Completed.InvokeAsync(CheckReport.Create(compiled.SnapshotIdentity.ProjectId, "pdf", "Caption and image placement",
                            caption.Relation.ToString(), compiled.SnapshotIdentity.BaseHeadRevisionId, compiled.OutputHash?.Hex,
                            $"Page {caption.PageIndex + 1} · {caption.Reason}\n{CheckReport.FormatEvidence(caption.Geometry)}"));
                    }
                }
                if (!_disposed) StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) when (_disposed) { }
    }
