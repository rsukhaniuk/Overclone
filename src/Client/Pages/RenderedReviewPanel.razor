    private void AddLabels()
    {
        if (!CanBindLabels) return;
        if (!_controller.AnnotationsCurrent) { _inputError = "Confirm or clear labels from the earlier PDF before adding labels to this one."; return; }
        int first = 0, last = 0;
        if ((_rangeKind != "search" && !PageRange(_firstPage, _lastPage, out first, out last)) || !Roles.Any(role => role.Id == _role)
            || _certainty is not ("tentative" or "confirmedObservation") || _rangeKind is not ("page" or "characters" or "search"))
        { _inputError = "Choose a supported role and ordered PDF pages from 1 to 512."; return; }
        int? begin = null, end = null;
        if (_rangeKind == "search")
        {
            if (!SearchDraftCurrent || _searchDraft is not { } draft)
            { _inputError = "The selected PDF search result is stale. Select the current result again or discard this draft."; return; }
            first = last = draft.Hit.PageIndex + 1; begin = draft.Hit.StartCharacterIndex; end = begin + draft.Hit.CharacterCount;
        }
        if (_rangeKind == "characters")
        {
            if (_lastPage.Length != 0 || !Number(_characterStart, 0, 99999, out var s) || !Number(_characterEnd, s + 1, 100000, out var e))
            { _inputError = "Character labels need one PDF page, a zero-based start and a larger exclusive end within the 100000-character inspection limit."; return; }
            begin = s; end = e;
        }
        if (last - first + 1 > LabelLimit - _controller.Annotations.Count)
        { _inputError = "The combined page labels exceed the 512-label limit. Remove labels before adding this range."; return; }
        var labels = _controller.Annotations.Concat(Enumerable.Range(first - 1, last - first + 1)
            .Select(page => new RenderedRoleAnnotation(0, _role, page, begin, end, null, null, "authorLabel", _certainty))).ToArray();
        long version = _controller.AnnotationVersion;
        _controller.SelectAnnotations(labels);
        if (_controller.AnnotationVersion == version)
        { _inputError = "Labels were refused. Check for incompatible overlapping roles; previously confirmed labels remain unchanged."; return; }
        _searchDraft = null; _draftChanged = false; _inputError = null; _labelPage = (_controller.Annotations.Count - 1) / LabelPageSize;
    }
