@using System.Globalization
@using System.Text.Json
@using System.Text
@using Client.Compilation
@using Client.Checks
@using Client.Compilation.Lifecycle
@using Client.Pdf
@using Client.Pdf.Preview
@using Client.Analysis.RenderedExtent
@using Client.Analysis
@using Client.Analysis.RenderedReview
@using Client.Compilation.Presentation
@using Client.Workspace
@implements IDisposable
@inject WorkspaceCoordinator Workspace
@inject CompileWorkspaceSession Compile
@inject IRenderedReviewEvaluator Evaluator

<details class="tool-disclosure" data-testid="rendered-review-panel">
    <summary>Rendered layout review</summary>
    <div class="tool-content">
        <p>Inspect measured pages of the current compiled PDF locally. KNU Faculty of Computer Science and Cybernetics, 2025. Coverage is partial: unknown or unavailable checks remain open, and this review does not certify overall compliance.</p>
        <label>Work type
            <select data-testid="rendered-review-work-type" value="@_controller.WorkType" @onchange="WorkTypeChanged">
                <option value="unspecified">Unspecified — applicability may be unknown</option>
                <option value="coursework">Coursework</option>
                <option value="bachelorQualification">Bachelor qualification</option>
                <option value="masterQualification">Master qualification</option>
            </select>
        </label>
        <label>
            <input type="checkbox" data-testid="rendered-review-work-numbers" checked="@_controller.ChecksWorkPageNumbers"
                   disabled="@(_controller.Busy || _controller.ChecksWorkPageNumbers && !_controller.CanTurnOffWorkPageNumbers)"
                   @onchange="PageNumberReviewChanged" />
            Inspect confirmed work page numbers
        </label>
        @if (_controller.ChecksWorkPageNumbers)
        {
            <p>Confirm the first page as the title page and select each printed number by its PDF text range. Use the numbering for the whole work, including appendices.</p>
            <label>
                <input type="checkbox" data-testid="rendered-review-major-heading-order" checked="@_controller.ChecksMajorHeadingOrder"
                       disabled="@_controller.Busy" @onchange="MajorHeadingReviewChanged" />
                Also inspect major heading placement
            </label>
            @if (_controller.ChecksMajorHeadingOrder)
            { <p>On each page to check, confirm one major heading and one ordinary body-text line using their PDF text ranges.</p> }
            @if (!_controller.CanTurnOffWorkPageNumbers)
            { <p>Remove either confirmed title-page label to turn off this check.</p> }
        }

        <details data-testid="rendered-reference-pair">
            <summary>Compare a printed citation and bibliography number</summary>
            <p>In the current PDF, search for and select one printed number such as <code>[1]</code>. Confirm each selection's role in the main work.</p>
            <button type="button" data-testid="rendered-reference-pair-citation" disabled="@(!CanCaptureReferenceNumber)"
                    @onclick="() => CaptureReferenceNumber(RenderedReferencePairRole.Citation)">Use selected in-text reference</button>
            @if (_controller.ReferenceCitation is { } citation)
            {
                <output data-testid="rendered-reference-pair-citation-selection" data-generation="@citation.PreviewGeneration"
                        data-page-index="@citation.Selection.PageIndex" data-character-start="@citation.Selection.CharacterStart"
                        data-character-end="@citation.Selection.CharacterEnd">
                    @citation.Selection.Literal on PDF page @(citation.Selection.PageIndex + 1)
                </output>
            }
            <button type="button" data-testid="rendered-reference-pair-entry" disabled="@(!CanCaptureReferenceNumber)"
                    @onclick="() => CaptureReferenceNumber(RenderedReferencePairRole.Entry)">Use selected bibliography-entry number</button>
            @if (_controller.ReferenceEntry is { } entry)
            {
                <output data-testid="rendered-reference-pair-entry-selection" data-generation="@entry.PreviewGeneration"
                        data-page-index="@entry.Selection.PageIndex" data-character-start="@entry.Selection.CharacterStart"
                        data-character-end="@entry.Selection.CharacterEnd">
                    @entry.Selection.Literal on PDF page @(entry.Selection.PageIndex + 1)
                </output>
            }
            <button type="button" data-testid="rendered-reference-pair-compare" disabled="@(!_controller.CanCheckReferencePair)"
                    @onclick="CheckReferencePair">Compare selected printed numbers</button>
            @if (_controller.ReferenceCitation is not null || _controller.ReferenceEntry is not null)
            {
                <button type="button" data-testid="rendered-reference-pair-clear" disabled="@_controller.Busy"
                        @onclick="_controller.ClearReferencePair">Clear selections</button>
            }
            @if (_controller.ReferencePairObservation is { } pair)
            {
                <output data-testid="rendered-reference-pair-result" data-comparison="@pair.Comparison"
                        data-reason="@pair.Reason" data-compile-request="@pair.Request.Review.CompileRequestId"
                        data-facts-sha256="@pair.Request.Review.FactsSha256">@ReferencePairResult(pair)</output>
                <p>Scope is limited to the selected numbers. Citation keys, order and bibliography completeness remain unassessed. KNU CSC 2025 §§2.8, 3.15.</p>
            }
            @if (_controller.ReferencePairNotice.Length > 0)
            { <p role="status" data-testid="rendered-reference-pair-notice">@_controller.ReferencePairNotice</p> }
        </details>

        <details data-testid="rendered-review-labels">
            <summary>Identify page roles for this PDF</summary>
            <p>These are your labels, not verified structural classifications. They apply only to the compiled PDF you confirm them against. Reconfirm after recompiling or reopening. Source text is never changed.</p>
            <fieldset disabled="@(!CanBindLabels)">
                <legend>Add a page role</legend>
                <label>Role
                    <select data-testid="rendered-role" @bind="_role" @bind:after="DraftChanged">
                        @foreach (var role in Roles)
                        { <option value="@role.Id">@(role.Id == "pageNumber" && _controller.ChecksWorkPageNumbers ? "Work page number" : role.Label)</option> }
                    </select>
                </label>
                <button type="button" data-testid="rendered-role-use-search" @onclick="UseSelectedSearch" disabled="@(!CanUseSelectedSearch)">Use selected PDF search result</button>
                <p>Search in the PDF preview and select a result first. This selects native PDF characters, not source or UTF-16 positions.</p>
                <label>Scope
                    <select data-testid="rendered-role-scope" @bind="_rangeKind" @bind:after="DraftChanged">
                        <option value="page">Whole page or page range</option>
                        <option value="search">Selected PDF search result</option>
                        <option value="characters">Advanced: native character range</option>
                    </select>
                </label>
                @if (_rangeKind == "search")
                {
                    @if (_searchDraft is { } draft)
                    {
                        <output data-testid="rendered-role-search-draft" data-current="@SearchDraftCurrent.ToString().ToLowerInvariant()"
                                data-pdf-sha256="@draft.State.DocumentSha256" data-generation="@draft.State.Generation"
                                data-page-index="@draft.Hit.PageIndex" data-character-start="@draft.Hit.StartCharacterIndex"
                                data-character-end="@(draft.Hit.StartCharacterIndex + draft.Hit.CharacterCount)" data-glyph-text="@SearchText(draft.Hit.GlyphText)" data-compile-request="@draft.Output.RequestId.Value.ToString("N")">
                            PDF page @(draft.Hit.PageIndex + 1), selected text: @SearchText(draft.Hit.GlyphText)
                        </output>
                        @if (!SearchDraftCurrent)
                        { <p role="status" data-testid="rendered-role-search-stale">The PDF or selected search result changed. Select the current result again, or discard this draft.</p> }
                    }
                    else { <p>No PDF search result has been selected for this label. Use the button above to capture the current result.</p> }
                }
                else
                {
                    <label>First PDF page (one-based)
                        <input data-testid="rendered-role-first" inputmode="numeric" maxlength="3" @bind="_firstPage" @bind:event="oninput" @bind:after="DraftChanged" />
                    </label>
                    <label>Last PDF page, inclusive (optional)
                        <input data-testid="rendered-role-last" inputmode="numeric" maxlength="3" @bind="_lastPage" @bind:event="oninput" @bind:after="DraftChanged" />
                    </label>
                }
                @if (_rangeKind == "characters")
                {
                    <details data-testid="rendered-role-advanced"><summary>Advanced native character indexes</summary>
                        <p>Use zero-based PDF inspector indexes with an exclusive end. Source-editor positions and UTF-16 offsets are different. Leave the last-page field empty.</p>
                        <label>First native character index
                            <input data-testid="rendered-role-start" inputmode="numeric" maxlength="6" @bind="_characterStart" @bind:event="oninput" @bind:after="DraftChanged" />
                        </label>
                        <label>Exclusive last native character index
                            <input data-testid="rendered-role-end" inputmode="numeric" maxlength="6" @bind="_characterEnd" @bind:event="oninput" @bind:after="DraftChanged" />
                        </label>
                    </details>
                }
                <label>Certainty
                    <select data-testid="rendered-role-certainty" @bind="_certainty" @bind:after="DraftChanged">
                        <option value="tentative">Tentative label</option>
                        <option value="confirmedObservation">I have confirmed this role in the PDF</option>
                    </select>
                </label>
                <button type="button" data-testid="rendered-role-add" @onclick="AddLabels" disabled="@(_controller.Annotations.Count >= LabelLimit || !_controller.AnnotationsCurrent || _rangeKind == "search" && !SearchDraftCurrent)">Add and confirm for the current PDF</button>
            </fieldset>
            <button type="button" data-testid="rendered-role-discard" @onclick="DiscardDraft" disabled="@(!_draftChanged)">Discard pending label input</button>
            @if (_draftChanged)
            { <p role="status" data-testid="rendered-role-pending">Label input has not been confirmed. Add it or discard it before checking; any previous review is shown as stale.</p> }
            @if (_controller.Annotations.Count == 0)
            { <p data-testid="rendered-role-empty">No page roles confirmed. Role-dependent checks remain unknown.</p> }
            else
            {
                <p>@_controller.Annotations.Count of @LabelLimit available labels; annotation version @_controller.AnnotationVersion.</p>
                <ul data-testid="rendered-role-list" data-annotation-version="@_controller.AnnotationVersion">
                    @foreach (var annotation in _controller.Annotations.Skip(_labelPage * LabelPageSize).Take(LabelPageSize))
                    {
                        <li @key="annotation.AnnotationId" data-testid="rendered-role-row" data-annotation-id="@annotation.AnnotationId" data-role="@annotation.Role" data-page-index="@annotation.PageIndex" data-character-start="@annotation.CharacterStart" data-character-end="@annotation.CharacterEnd" data-provenance="@annotation.Provenance" data-certainty="@annotation.Certainty">
                            Page @(annotation.PageIndex + 1): @RoleLabel(annotation.Role), @AnnotationRange(annotation).
                            @if (annotation.Provenance == "authorLabel") { <span>Your label: @CertaintyLabel(annotation.Certainty).</span> }
                            else { <span>Matched analyzed text; surrounding section or illustration is not established.</span> }
                            <button type="button" @onclick="() => RemoveLabel(annotation.AnnotationId)" disabled="@_controller.Busy" aria-label="@($"Remove {RoleLabel(annotation.Role)} label on page {annotation.PageIndex + 1}")">Remove label</button>
                        </li>
                    }
                </ul>
                @if (_controller.Annotations.Count > LabelPageSize)
                {
                    <nav aria-label="Page role labels">
                        <button type="button" @onclick="() => MoveLabelPage(-1)" disabled="@(_labelPage == 0)">Previous labels</button>
                        <span>Label page @(_labelPage + 1) of @PageTotal(_controller.Annotations.Count, LabelPageSize).</span>
                        <button type="button" @onclick="() => MoveLabelPage(1)" disabled="@((_labelPage + 1) * LabelPageSize >= _controller.Annotations.Count)">Next labels</button>
                    </nav>
                }
                @if (!_controller.AnnotationsCurrent)
                { <p role="status" data-testid="rendered-role-stale">These labels belong to an earlier PDF. Review their pages before confirming them for the current compiled PDF.</p> }
                <button type="button" data-testid="rendered-role-confirm" @onclick="ReconfirmLabels" disabled="@(!CanBindLabels || _draftChanged)">Confirm listed labels for the current PDF</button>
                <button type="button" data-testid="rendered-role-clear" @onclick="ClearLabels" disabled="@(!CanBindLabels)">Clear confirmed labels</button>
            }
        </details>

        @if (Binding is not null)
        {
            <details data-testid="rendered-source-binding-panel">
                <summary>Match analyzed text in the current PDF</summary>
                <p>Run the FCSC KNU ruleset with the same main file and work type as this review. Select an observation to match its text against the current PDF.</p>
                @if (UsesProjectCaptionRoles)
                {
                    <p>Ukrainian caption titles can be matched in the main file and literal includes for supported pdfLaTeX projects containing only TeX source files.</p>
                    @if (!SourceCandidates.Any())
                    { <p role="status">No caption titles met the project context needed for a PDF match.</p> }
                }
                <label>Source observation
                    <select data-testid="rendered-source-event" value="@SourceChoice" @onchange="SourceEventChanged" disabled="@_controller.Busy">
                        <option value="">Choose analyzed text</option>
                        @foreach (var candidate in SourceCandidates)
                        { <option value="@candidate.Index">@SourceEventLabel(candidate.Event)</option> }
                    </select>
                </label>
                @if (SourceReport?.Result.Thesis is null)
                { <p>Current KNU source observations are unavailable. Run source analysis before matching.</p> }
                @if (_sourceDraft is not null && !ReferenceEquals(_sourceDraft.Report, SourceReport))
                { <p role="status" data-testid="rendered-source-draft-stale">Source analysis changed. Choose an observation from the current report.</p> }
                <button type="button" data-testid="rendered-source-bind" @onclick="MatchSource" disabled="@(!CanMatchSource)">Match analyzed text with current PDF</button>
                @foreach (var proof in _controller.SourceBindings)
                {
                    <p data-testid="rendered-source-binding" data-annotation-id="@proof.Annotation.AnnotationId" data-range-kind="@proof.RangeKind" data-glyph-ink-measured="false">
                        Matched @(proof.RangeKind == "captionText" ? "caption text" : "heading text") on PDF page @(proof.Annotation.PageIndex + 1).
                        This identifies only those text characters. Reanalyze and match again after source, analysis settings or compilation changes.
                    </p>
                }
            </details>
        }

        @if (_controller.ConfirmedCaptions is { Count: > 0 } captions)
        {
            <details data-testid="rendered-caption-image-panel">
                <summary>Measure a caption and image</summary>
                <label>Confirmed caption
                    <select data-testid="rendered-caption-image-caption" @bind="_imageCaption" @bind:after="CaptionImageChoiceChanged" disabled="@_controller.Busy">
                        <option value="">Choose a caption</option>
                        @foreach (var caption in captions)
                        {
                            <option value="@caption.AnnotationId">Page @(caption.PageIndex + 1), @RoleLabel(caption.Role), @AnnotationRange(caption)</option>
                        }
                    </select>
                </label>
                <button type="button" @onclick="ShowCaptionImagePage" disabled="@(SelectedImageCaption is null || _controller.Busy)">Show caption page</button>
                <button type="button" data-testid="rendered-caption-image-inspect" @onclick="InspectCaptionImages"
                        disabled="@(!CanInspectCaptionImages)">Find direct images on the caption page</button>
                @if (CaptionImageListCurrent && _controller.InspectedImages.Count > 0)
                {
                    <label>Image placement
                        <select data-testid="rendered-caption-image-object" @bind="_captionImageObject" disabled="@_controller.Busy">
                            <option value="">Choose the matching image</option>
                            @foreach (var image in _controller.InspectedImages)
                            {
                                <option value="@image.ObjectIndex">@ImagePlacementLabel(image)</option>
                            }
                        </select>
                    </label>
                    <button type="button" data-testid="rendered-caption-image-measure" @onclick="MeasureCaptionImage"
                            disabled="@(!CanInspectCaptionImages || SelectedCaptionImageObject is null)">Measure selected pair</button>
                }
                @if (CaptionImageListCurrent && _controller.CaptionImageObservation is { } observed
                    && observed.Request.Pair.ObjectIndex == SelectedCaptionImageObject)
                {
                    <output role="status" data-testid="rendered-caption-image-result" data-relation="@observed.Relation"
                            data-object-index="@observed.Request.Pair.ObjectIndex" data-caption-id="@observed.Request.Pair.CaptionAnnotationId"
                            data-compile-request="@observed.Request.Review.CompileRequestId" data-inspection-request="@observed.Request.Pair.InspectionRequestId"
                            data-layout-sha256="@observed.Request.Pair.LayoutFactsSha256" data-object-facts-sha256="@observed.Request.Pair.ObjectFactsSha256">
                        @CaptionImageResult(observed)
                    </output>
                    @if (observed.Geometry is not null)
                    { <p>The gap is between the caption ink box and the image placement box. Image visibility and compliance are unassessed.</p> }
                }
            </details>
        }

        <fieldset disabled="@_controller.Busy">
            <legend>Pages to inspect</legend>
            <label><input type="checkbox" data-testid="rendered-review-all-pages" @bind="_allPages" /> Inspect all PDF pages sequentially</label>
            @if (!_allPages)
            {
                <label>First PDF page <input data-testid="rendered-review-first" inputmode="numeric" maxlength="3" @bind="_checkFirst" @bind:event="oninput" /></label>
                <label>Last PDF page, inclusive (optional) <input data-testid="rendered-review-last" inputmode="numeric" maxlength="3" @bind="_checkLast" @bind:event="oninput" /></label>
            }
            <p>At most 512 pages per review. If collection stops early, explicitly check the remaining pages; uninspected pages do not pass.</p>
        </fieldset>
        <button type="button" data-testid="rendered-review-check" @onclick="Check" disabled="@(!_controller.CanCheck || _draftChanged)">Check current compiled PDF</button>
        <details data-testid="rendered-paragraph-indent-controls">
            <summary>Check first-line paragraph indent</summary>
            <p>Open the paragraph’s PDF page. In PDF search, enter its first three complete lines with spaces between them.
                Label the matching result Paragraph and choose “I have confirmed this role in the PDF.” Use one ordinary left-aligned paragraph on the current page.</p>
            <button type="button" data-testid="rendered-paragraph-indent-check" disabled="@(ParagraphIndentPage is null)"
                    @onclick="CheckParagraphIndent">Check paragraph indent on current page</button>
        </details>
        <details data-testid="rendered-heading-page-end-controls">
            <summary>Check whether a minor heading ends the page</summary>
            <p>In PDF search, select the complete heading on the current page and confirm its Minor heading role.
                Compare the page image with Extracted page text in the preview before confirming text coverage.</p>
            <label>
                <input type="checkbox" data-testid="rendered-heading-page-end-confirm"
                       checked="@(HeadingPage is { } confirmedPage && _confirmedHeadingPage == confirmedPage)"
                       disabled="@(HeadingPage is null)" @onchange="ConfirmHeadingPage" />
                I verified that all visible text on this PDF page is present in the extracted page text.
            </label>
            <button type="button" data-testid="rendered-heading-page-end-check"
                    disabled="@(HeadingPage is not { } current || _confirmedHeadingPage != current)"
                    @onclick="CheckHeadingPageEnd">Check heading on current page</button>
        </details>
        <details data-testid="rendered-heading-spacing-controls">
            <summary>Compare heading and body line spacing</summary>
            <p>On the current PDF page, confirm one complete two-line heading and the first three complete lines of the paragraph directly below it. Use PDF search to select each range, then label it Major heading or Minor heading, or Paragraph.</p>
            <button type="button" data-testid="rendered-heading-spacing-check" disabled="@(HeadingSpacingPage is null)"
                    @onclick="CheckHeadingSpacing">Compare line spacing on current page</button>
        </details>
        <button type="button" data-testid="rendered-review-cancel" @onclick="Cancel" disabled="@(!_controller.CanCancel)">Cancel rendered review</button>
        <p role="status" data-testid="rendered-review-status" data-busy="@_controller.Busy.ToString().ToLowerInvariant()">@_controller.Notice</p>
        @if (_inputError is not null) { <p role="alert" data-testid="rendered-review-input-error">@_inputError</p> }
        @if (_controller.Busy && !_controller.CanCancel)
        { <p>Finishing the active inspection or evaluation. Another review starts after it settles.</p> }

        @if (_shown is { } report)
        {
            <section aria-label="Measured rendered observations" data-testid="rendered-review-report" data-current="@ShownCurrent.ToString().ToLowerInvariant()"
                     data-complete="@report.Complete.ToString().ToLowerInvariant()" data-pdf-sha256="@report.Evidence.Compilation.PdfSha256"
                     data-annotation-version="@report.Evidence.AnnotationVersion">
                <h3>Measured observations — partial standards coverage</h3>
                @if (!ShownCurrent) { <p role="status" data-testid="rendered-review-stale">Previous review — stale. PDF, source, work type or labels changed. Check the current compiled PDF again.</p> }
                <p data-testid="rendered-review-coverage">Inspected @report.EvaluatedPages of @report.RequestedPages requested pages. @(report.Complete ? "The requested page collection is complete." : "Page coverage is incomplete.") Overall compliance is not assessed.</p>
                <p>Work type for these observations: @WorkTypeLabel(_shownWorkType).</p>
                @if (report.Results.Count == 0)
                { <p>No rule observations were returned. No checks have been established.</p> }
                @foreach (var result in report.Results)
                {
                    <article data-testid="rendered-review-rule" data-rule-id="@result.RuleId" data-outcome="@result.Outcome" data-support="@result.SupportState">
                        <h4>@result.RuleId — @RuleLabel(result.RuleId)</h4>
                        <p>Observation: @OutcomeLabel(result.Outcome). Support: @result.SupportState. Severity: @result.Severity.</p>
                        <p data-testid="rendered-review-reason">@result.Reason.Replace('-', ' ')</p>
                        @if (report.ProfileVersion == RenderedReviewContract.ParagraphIndentProfileVersion && result.RuleId == "KNU-PARAGRAPH-RENDERED-001")
                        {
                            <p data-testid="rendered-paragraph-indent" data-reason="@result.Reason">@ParagraphIndentSummary(result)</p>
                        }
                        @if (report.ProfileVersion == RenderedReviewContract.HeadingPageEndProfileVersion && result.RuleId == "KNU-HEADINGS-RENDERED-001")
                        {
                            <p data-testid="rendered-heading-page-end-result" data-reason="@result.Reason">@HeadingPageEndSummary(result.Reason)</p>
                        }
                        @if (report.ProfileVersion == RenderedReviewContract.HeadingSpacingProfileVersion && result.RuleId == "KNU-HEADINGS-RENDERED-001")
                        {
                            <p data-testid="rendered-heading-spacing-result" data-reason="@result.Reason">@HeadingSpacingSummary(result)</p>
                        }
                        <p><a href="@RenderedExtentContract.SourceUrl" target="_blank" rel="noopener noreferrer">KNU CSC 2025, @CitationLabel(result.Citation)</a></p>
                        @if (result.Evidence.Count > 0)
                        {
                            <ul aria-label="@($"Measured evidence for {result.RuleId}")">
                                @foreach (var evidence in VisibleEvidence(result))
                                {
                                    <li data-testid="rendered-review-measurement">
                                        @if (EvidencePage(evidence) is { } page)
                                        {
                                            <span>PDF page @(page + 1). </span>
                                            <button type="button" @onclick="() => ShowPage(page)" disabled="@(!CanShowPage(page))">Show page @(page + 1) in PDF preview</button>
                                        }
                                        <p>Measured: @JsonText(evidence, "measured"). Expected observation: @JsonText(evidence, "expected"). Unit: @JsonText(evidence, "unit"). Method: @JsonText(evidence, "method").</p>
                                        @if (result.RuleId == "KNU-PAGINATION-001" && evidence.TryGetProperty("observation", out var observation)
                                            && observation.TryGetProperty("placement", out var placement))
                                        {
                                            <p>Work page number ink is @JsonText(placement, "topClearanceMm") mm from the media top
                                                and @JsonText(placement, "rightClearanceMm") mm from the right, with a measurement uncertainty
                                                of @JsonText(placement, "absoluteErrorMm") mm.</p>
                                        }
                                        <details><summary>Exact measurement evidence</summary><pre style="white-space:pre-wrap">@evidence.GetRawText()</pre></details>
                                    </li>
                                }
                            </ul>
                            @if (result.Evidence.Count > EvidencePageSize)
                            {
                                <nav aria-label="@($"Evidence pages for {result.RuleId}")">
                                    <button type="button" @onclick="() => MoveEvidence(result, -1)" disabled="@(EvidencePageNumber(result.RuleId) == 0)">Previous measurements</button>
                                    <span>Measurement page @(EvidencePageNumber(result.RuleId) + 1) of @PageTotal(result.Evidence.Count, EvidencePageSize).</span>
                                    <button type="button" @onclick="() => MoveEvidence(result, 1)" disabled="@((EvidencePageNumber(result.RuleId) + 1) * EvidencePageSize >= result.Evidence.Count)">Next measurements</button>
                                </nav>
                            }
                        }
                        else { <p>No measured page evidence establishes this category. Its reported outcome remains @(OutcomeLabel(result.Outcome).ToLowerInvariant()).</p> }
                        @if (result.Limitations.Count > 0)
                        { <ul aria-label="Limitations">@foreach (var limitation in result.Limitations) { <li>@limitation.Replace('-', ' ')</li> }</ul> }
                    </article>
                }
                <details data-testid="rendered-review-identity"><summary>Compiled revision and measurement identity</summary>
                    <p>PDF SHA256: @report.Evidence.Compilation.PdfSha256; @report.Evidence.Compilation.PdfBytes bytes.</p>
                    <p>Compile request: @report.Evidence.Compilation.CompileRequestId; epoch: @report.Evidence.Compilation.CompileEpoch; capture: @report.Evidence.Compilation.CaptureId.</p>
                    <p>Input digest: @report.Evidence.Compilation.InputDigest. Artifact digest: @report.Evidence.ContentIdentity.Digest.Hex.</p>
                    <p>Annotation version: @report.Evidence.AnnotationVersion; profile: @RenderedReviewContract.ProfileId @report.ProfileVersion.</p>
                    <p>Inspector loader SHA256: @report.Evidence.Compilation.Runtime.LoaderSha256; WASM SHA256: @report.Evidence.Compilation.Runtime.WasmSha256.</p>
                    <p>@report.Evidence.Pages.Count pages have recorded inspection, facts-hash and evaluation identities. These identify the observations; they do not establish unassessed rules.</p>
                    <ul>
                        @foreach (var identity in report.Evidence.Pages.Skip(_identityPage * EvidencePageSize).Take(EvidencePageSize))
                        { <li>PDF page @(identity.PageIndex + 1): inspection @identity.InspectionRequestId / epoch @identity.InspectionEpoch; facts SHA256 @identity.FactsSha256; evaluation @identity.EvaluationRequestId / epoch @identity.EvaluationEpoch.</li> }
                    </ul>
                    @if (report.Evidence.Pages.Count > EvidencePageSize)
                    {
                        <nav aria-label="Measurement identities">
                            <button type="button" @onclick="() => MoveIdentity(-1)" disabled="@(_identityPage == 0)">Previous page identities</button>
                            <button type="button" @onclick="() => MoveIdentity(1)" disabled="@((_identityPage + 1) * EvidencePageSize >= report.Evidence.Pages.Count)">Next page identities</button>
                        </nav>
                    }
                </details>
                <p>No source fixes, automatic edits or PDF replacement are offered by rendered review.</p>
            </section>
        }
    </div>
</details>

@code {
    [Parameter] public CompiledReviewController? Session { get; set; }
    [Parameter] public EventCallback<CheckReport> Completed { get; set; }
    [Parameter] public EventCallback PreviewRequested { get; set; }
    private RenderedReviewReport? _archivedLayout;
    private RenderedReferencePairObservation? _archivedPair;
