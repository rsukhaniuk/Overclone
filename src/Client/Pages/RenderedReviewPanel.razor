            double measured = evidence.GetProperty("measured").GetDouble();
            double error = evidence.GetProperty("uncertainty").GetProperty("absoluteError").GetDouble();
            string comparison = result.Outcome == "fail" ? "lies outside this measurement interval" : "lies within this measurement interval";
            return $"The first line starts {measured:0.###} ± {error:0.###} mm from the continuation line starts. KNU §3.1 specifies 12.7 mm, which {comparison}.";
        }
        return result.Reason switch
        {
            "ambiguous-paragraph-selected-range" => "Select one confirmed paragraph range on this page.",
            "confirmed-paragraph-three-line-range-required" => "Confirm the first three complete lines of one ordinary paragraph to measure its indent.",
            "paragraph-physical-scale-unavailable" => "The PDF does not supply a usable physical page scale.",
            "paragraph-line-ink-unavailable" => "Measurable glyphs are unavailable for one or more selected lines.",
            _ => "The selected text does not establish isolated, aligned continuation lines."
