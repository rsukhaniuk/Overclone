    private static string HeadingSpacingSummary(RenderedRuleResult result)
    {
        if (result.Evidence.Count == 1)
        {
            var evidence = result.Evidence[0];
            var body = evidence.GetProperty("observation").GetProperty("bodyIntervals");
            double heading = evidence.GetProperty("measured").GetDouble();
            double error = evidence.GetProperty("uncertainty").GetProperty("absoluteError").GetDouble();
            string comparison = result.Reason == "confirmed-heading-baselines-differ-from-local-body"
                ? "The heading interval is outside both body measurement intervals."
                : "The measurements do not establish a difference.";
            return $"Heading: {heading:0.###} ± {error:0.###} mm. Body: {Format(body[0])} and {Format(body[1])}. {comparison}";
        }
        return result.Reason switch
        {
            "confirmed-heading-and-paragraph-ranges-required" or "ambiguous-heading-or-paragraph-ranges" => "Confirm one heading and one paragraph range on the current page.",
            "heading-spacing-complete-adjacent-lines-required" => "Select two complete heading lines and the next three complete paragraph lines.",
            "heading-spacing-body-reference-unestablished" => "The two paragraph intervals do not establish a common body reference.",
            "heading-spacing-physical-scale-unavailable" => "The PDF does not supply a usable physical page scale.",
            _ => "The selected lines do not establish isolated baseline geometry."
        };

        static string Format(JsonElement interval) =>
            $"{interval.GetProperty("measuredMm").GetDouble():0.###} ± {interval.GetProperty("absoluteErrorMm").GetDouble():0.###} mm";
    }
    private static string ParagraphIndentSummary(RenderedRuleResult result)
