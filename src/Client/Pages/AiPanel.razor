@using Client.AI
@implements IDisposable
@inject AiSessionFactory Factory

<section class="integration-panel" aria-label="Optional Ollama assistance" data-testid="ai-panel">
    <h3>AI review</h3>
    @if (_session.Connection is null)
    {
        <fieldset>
            <legend>Connect to local Ollama</legend>
            <label>Local service URL <input @bind="_localUrl" @bind:event="oninput" @bind:after="ResetModelChoice"
                maxlength="256" autocomplete="off" data-testid="ai-local-url" /></label>
            <button class="@(_models.Count == 0 ? "primary" : null)" @onclick="DiscoverModelsAsync"
                disabled="@(_discovery is not null)" data-testid="ai-discover-models">@(_models.Count == 0 ? "Find installed models" : "Refresh model list")</button>
            <p class="hint ai-discovery-status" role="status" data-testid="ai-discovery-status">@_discoveryStatus</p>
            @if (_models.Count > 0)
            {
                <label>Installed model
                    <select @bind="_model" data-testid="ai-installed-models">
                        <option value="">Choose a model</option>
                        @foreach (var model in _models)
                        {
                            <option value="@model">@model</option>
                        }
                    </select>
                </label>
            }
            <details>
                <summary>Enter model ID manually</summary>
                <label>Model ID <input @bind="_model" @bind:event="oninput" maxlength="128" autocomplete="off" data-testid="ai-model" /></label>
            </details>
            <button class="primary" @onclick="Connect" disabled="@(_discovery is not null || string.IsNullOrWhiteSpace(_model))"
                data-testid="ai-connect">Use this model</button>
        </fieldset>
        <p class="hint">You’ll see the file context before sending anything.</p>
    }
    else
    {
        var connection = _session.Connection;
        <p class="ai-destination" data-testid="ai-destination"><strong>Ollama · @connection.Model</strong><br />@connection.Destination.AbsoluteUri</p>
        <div class="actions">
            <button @onclick="Prepare" disabled="@_session.Busy">Prepare active-file context</button>
            @if (PrepareSelection.HasDelegate)
            {
                <button @onclick="() => PrepareSelection.InvokeAsync()" disabled="@_session.Busy">Prepare selected passage</button>
            }
        </div>
        @if (_session.CurrentContext is { } context)
        {
            <p class="context-file">@context.Filename · @(context.Selection.HasValue ? "selected passage" : $"{context.ByteLength} UTF-8 bytes")</p>
            <pre data-testid="ai-context">@context.DisclosedText</pre>
            <details><summary>Context verification</summary><p>BOM: @context.HasBom · Exact hash: @context.Hash</p></details>
        }
        @if (_session.CurrentContext is not null && _session.Answer is { } answer)
        {
            <h3>Response</h3>
            <pre class="ai-answer" data-testid="ai-answer">@answer</pre>
        }
        @if (_session.CurrentContext is not null && _session.Findings.Count > 0)
        {
            @if (_session.Findings.Any(finding => ReferenceEquals(finding, SelectedFinding)))
            {
                <p class="ai-gutter-finding" role="status" data-testid="active-ai-finding">@SelectedFinding!.Comment</p>
            }
            <ol class="ai-inline-findings" aria-label="AI suggestions">
                @foreach (var finding in _session.Findings)
                {
                    <li @key="finding" data-testid="ai-finding" data-anchored="@(finding.Range.HasValue ? "true" : "false")">
                        @if (finding.Range.HasValue)
                        {
                            <button type="button" class="finding-link" @onclick="() => FindingSelected.InvokeAsync(finding)">@finding.Comment</button>
                        }
                        else
                        {
                            <p>@finding.Comment <small>Comment without a verified source location</small></p>
                        }
                        @if (finding.Replacement is not null)
                        {
                            <button type="button" disabled="@_session.Busy" @onclick="() => _session.PreviewFindingAsync(finding)">Preview fix</button>
                        }
                    </li>
                }
            </ol>
        }
        <label>Request type
            <select value="@EffectiveRequestType" @onchange="ChangeRequestType" disabled="@(_session.Busy || _session.CurrentContext?.Selection is not null)">
                <option value="InlineReview">Inline review</option>
                <option value="Question">Question</option>
                <option value="Proposal">Whole-file edit proposal</option>
            </select>
        </label>
        <label>Your request
            <textarea @bind="_instruction" @bind:event="oninput" maxlength="8192" disabled="@_session.Busy" placeholder="Ask about this document…"></textarea>
        </label>
        <details>
            <summary>Exact request payload</summary>
            <pre data-testid="ai-payload">@_session.PayloadPreview(Instruction, Propose, InlineReview)</pre>
        </details>
        <p class="hint">Send shares the displayed context and your request with Ollama.</p>
        <div class="actions">
            <button class="primary" @onclick="Send" disabled="@(_session.Busy || _session.CurrentContext is null || string.IsNullOrWhiteSpace(Instruction))">Send disclosed request</button>
            @if (_session.Busy) { <button @onclick="Cancel">Cancel</button> }
        </div>
        @if (_session.HasProposal)
        {
            <button @onclick="Preview" disabled="@_session.Busy">Review proposed edits</button>
        }
        <button class="disconnect" @onclick="Disconnect">Disconnect and clear memory</button>
    }
    <p role="status" hidden="@(!_connectionAttempted && _session.Connection is null)" data-testid="ai-status">@(_session.Context is not null && _session.CurrentContext is null ? "Active source changed. Prepare fresh context." : _session.Status)</p>
</section>

@code {
    // Optional borrowed session is fixed for this mount; otherwise this panel owns one.
    [Parameter] public AiSession? Session { get; set; }
    [Parameter] public EventCallback<AiFinding> FindingSelected { get; set; }
    [Parameter] public EventCallback PrepareSelection { get; set; }
    [Parameter] public AiFinding? SelectedFinding { get; set; }
    private AiSession _session = default!;
    private bool _ownsSession;
    private string _model = "", _localUrl = AiConnection.DefaultLocalUrl, _instruction = "";
    private IReadOnlyList<string> _models = [];
    private CancellationTokenSource? _discovery;
    private string? _discoveryStatus;
    private enum RequestType { InlineReview, Question, Proposal }
    private RequestType _requestType;
    private RequestType EffectiveRequestType => _session.CurrentContext?.Selection is not null ? RequestType.InlineReview : _requestType;
    private bool InlineReview => EffectiveRequestType == RequestType.InlineReview;
    private bool Propose => EffectiveRequestType == RequestType.Proposal;
    private void ChangeRequestType(ChangeEventArgs e)
    {
        if (Enum.TryParse<RequestType>(e.Value?.ToString(), out var mode)) _requestType = mode;
    }
    private string Instruction => InlineReview && string.IsNullOrWhiteSpace(_instruction) ? "Review this LaTeX for clarity and correctness." : _instruction;
    private bool _disposed, _connectionAttempted;
    protected override void OnInitialized()
    {
        _ownsSession = Session is null;
        _session = Session ?? Factory.Create();
        _session.Changed += Changed;
    }
    private void Connect()
    {
        _connectionAttempted = true;
        _session.Connect(_model, _localUrl);
    }
    private async Task DiscoverModelsAsync()
    {
        if (_disposed || _discovery is not null) return;
        using var discovery = _discovery = new();
        _discoveryStatus = "Looking for installed models…";
        try
        {
            var catalog = await Factory.DiscoverModelsAsync(_localUrl, discovery.Token);
            if (_disposed || discovery.IsCancellationRequested) return;
            if (_models.Contains(_model) && !catalog.Models.Contains(_model)) _model = "";
            _models = catalog.Models;
            if (_models.Count == 1 && _model.Length == 0) _model = _models[0];
            _discoveryStatus = catalog.Outcome switch
            {
                AiOutcome.Success => _models.Count == 0 ? "No local chat models found. Install a model in Ollama, then try again." : null,
                AiOutcome.Unconfigured => "Use http://localhost:11434 or http://127.0.0.1:11434.",
                AiOutcome.Connectivity or AiOutcome.AccessDenied => "Could not list models. Check that Ollama is running and allows this browser origin.",
                AiOutcome.Timeout => "Ollama took too long to list models. Try again or enter the model ID manually.",
                _ => "Could not list models. Try again or enter the model ID manually."
            };
        }
        finally { _discovery = null; }
    }
    private void ResetModelChoice()
    {
        _discovery?.Cancel();
        if (_models.Contains(_model)) _model = "";
        _models = [];
        _discoveryStatus = null;
        _connectionAttempted = false;
    }
    private Task Prepare() => InvokeAsync(() => _session.PrepareAsync());
    private Task Send() => _session.SendAsync(Instruction, Propose, consent: true, inlineReview: InlineReview);
    private Task Preview() => InvokeAsync(_session.PreviewProposalAsync);
    private Task Cancel() => InvokeAsync(_session.Cancel);
    private Task Disconnect() => InvokeAsync(() => { _session.Disconnect(); _instruction = ""; _model = ""; ResetModelChoice(); });
    private void Changed() { if (!_disposed) _ = Render(); }
    private async Task Render()
    {
        try { await InvokeAsync(() => { if (!_disposed) StateHasChanged(); }).ConfigureAwait(false); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) when (_disposed) { }
    }
    public void Dispose()
    {
        _disposed = true;
        _discovery?.Cancel();
        if (_session is not null) { _session.Changed -= Changed; if (_ownsSession) _session.Dispose(); }
        _instruction = "";
    }
}
