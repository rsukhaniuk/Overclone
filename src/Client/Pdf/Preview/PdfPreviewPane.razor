@namespace Client.Pdf.Preview
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Client.Compilation.SyncTeX
@implements IAsyncDisposable
@inject IJSRuntime JS
<section class="pdf-preview @(View.DocumentSha256 is null ? "pdf-empty" : "pdf-loaded")" aria-label="PDF preview" data-testid="pdf-pane" data-generation="@View.Generation" data-document="@View.DocumentSha256">
    <header>
        <h2>PDF preview</h2>
        <span>@View.DisplayName</span>
    </header>
    <div class="pdf-page-toolbar" role="toolbar" aria-label="PDF page controls" hidden="@(!FillPane && View.DocumentSha256 is null)">
        <div class="pdf-active-controls" hidden="@(View.DocumentSha256 is null)">
            <button aria-label="Previous page" disabled="@(View.PageCount == 0 || View.PageIndex == 0)" @onclick="Previous" title="Previous page">‹</button>
            <label><span class="sr-only">Page</span> <input aria-label="Go to page" type="number" min="1" max="@View.PageCount" value="@(View.PageIndex + 1)" @onchange="Go" disabled="@(View.PageCount == 0)" /></label>
            <span data-testid="page-label">@(View.PageCount == 0 ? "No pages" : $"Page {View.PageIndex + 1} of {View.PageCount}")</span>
            <button aria-label="Next page" disabled="@(View.PageCount == 0 || View.PageIndex + 1 >= View.PageCount)" @onclick="Next" title="Next page">›</button>
            <label><span class="sr-only">Zoom</span> <select aria-label="Zoom" value="@View.ZoomPercent" @onchange="Zoom" disabled="@(View.DocumentSha256 is null)">
                @foreach (int value in new[] { 25, 50, 75, 100, 125, 150, 200, 300 }) { <option value="@value">@(FillPane && value == 100 ? "Fit width" : $"{value}%")</option> }
            </select></label>
            <button aria-label="Cancel preview" @onclick="Cancel" disabled="@(View.Status != PdfPreviewStatus.Loading)">Cancel</button>
            <button hidden="@(FillPane && View.Status is PdfPreviewStatus.Available or PdfPreviewStatus.Loading)" aria-label="Retry preview" @onclick="Retry" disabled="@(_current.ActualWorkPending || View.DocumentSha256 is null)">Retry</button>
            @ToolbarActions
            <details class="pdf-option pdf-search-option">
                <summary>Find</summary>
                <div role="search" aria-label="PDF full document search" hidden="@(View.DocumentSha256 is null)">
                    <label>Search <input aria-label="Search PDF" maxlength="255" value="@_query" @oninput="QueryChanged" @onkeydown="SearchKey" /></label>
                    <button aria-label="Search document" @onclick="Search" disabled="@(View.DocumentSha256 is null)">Search document</button>
                    <button aria-label="Continue search" data-testid="continue-pdf-search" @onclick="ContinueSearch" disabled="@(!_current.CanContinueSearch || _query != View.Search.Query)">Continue search</button>
                    <button aria-label="Previous result" disabled="@(View.Search.Hits.Count == 0)" @onclick="PreviousHit">Previous result</button>
                    <button aria-label="Next result" disabled="@(View.Search.Hits.Count == 0)" @onclick="NextHit">Next result</button>
                    <output hidden="@(View.Search.Status == PdfPreviewSearchStatus.Empty)" aria-live="polite" data-testid="search-status" data-search-status="@View.Search.Status" data-scanned-pages="@View.Search.ScannedPages" data-total-pages="@View.Search.TotalPages" data-match-count="@View.Search.Hits.Count">@SearchMessage</output>
                    <output hidden="@(View.Search.Hits.Count == 0)" data-testid="selected-result">@(View.SelectedHit < 0 ? "No result selected" : $"Result {View.SelectedHit + 1} / {View.Search.Hits.Count}")</output>
                </div>
            </details>
            <button class="pdf-to-source" aria-label="Go to source" disabled="@(!CanGoToSource)" hidden="@(!CanGoToSource)" @onclick="GoToSource">Go to source</button>
        </div>
        <details class="pdf-option pdf-more-option"><summary>PDF tools</summary>
            <div class="pdf-more-content">
                <button aria-label="Fit width" hidden="@(View.DocumentSha256 is null)" @onclick="Fit">Fit width</button>
                @if (_current.InteractiveReader && !string.IsNullOrWhiteSpace(View.Text))
                {
                    <button type="button" @onclick="() => _canvas?.SelectReaderText()">Select page text</button>
                }
                @MoreTools
                @PdfDetails
            </div>
        </details>
    </div>
    <p role="status" hidden="@(View.Status is PdfPreviewStatus.Empty or PdfPreviewStatus.Available)" data-testid="preview-status" data-preview-status="@View.Status">@PreviewMessage</p>
    @if (View.DocumentSha256 is null)
    {
        <div class="pdf-empty-state">
            <span class="empty-file-icon" aria-hidden="true"></span>
            <h3>Your PDF will appear here</h3>

        </div>
    }
    @if (_current.InteractiveReader)
    {
        <div class="pdf-scroll pdf-reader" @ref="_element" hidden="@(View.DocumentSha256 is null)"
             tabindex="0" aria-label="PDF viewport keyboard navigation" @onkeydown="PageKey"></div>
    }
    else
    {
    <div class="pdf-scroll" hidden="@(View.DocumentSha256 is null)" tabindex="0" aria-label="PDF viewport keyboard navigation" @onkeydown="PageKey">
        <div class="pdf-surface @(FillPane ? "pdf-fit" : "")" style="@SurfaceStyle">
            <canvas @ref="_element" aria-label="PDF page" data-testid="pdf-canvas"></canvas>
            @if (View.Frame is not null)
            {
                <div class="pdf-highlights" aria-label="Native glyph highlights">
                    @if (SourceBox is { } sourceBox)
                    { <span class="pdf-highlight pdf-source-highlight" data-testid="source-pdf-highlight" style="@BoxStyle(sourceBox)"></span> }
                    @foreach (var hit in VisibleHits())
                    {
                        @foreach (var box in hit.NormalizedBoxes)
                        { <span class="pdf-highlight" data-testid="glyph-highlight" title="@hit.GeometryStatus" style="@BoxStyle(box)"></span> }
                    }
                </div>
            }
        </div>
    </div>
    }
</section>
@code {
    [Parameter] public bool FillPane { get; set; }
    [Parameter] public RenderFragment? ToolbarActions { get; set; }
    [Parameter] public RenderFragment? MoreTools { get; set; }
    private RenderFragment PdfDetails => @<details data-testid="pdf-details">
        <summary>PDF details</summary>
        <p data-testid="pdf-provenance">Caller label: @View.Provenance. This is unverified display information, not compilation freshness.</p>
        <code data-testid="pdf-hash">@(View.DocumentSha256 ?? "No PDF")</code>
        <p>Request: @View.NativeRequestId; epoch: @View.NativeEpoch; generation: @View.Generation.</p>
        <p>Runtime: @View.Runtime</p>
        <p>@View.Detail</p>
        <p data-testid="canvas-status">@(_canvas?.Status ?? "Not drawn")</p>
        <p data-testid="geometry-status">@SelectedGeometry</p>
        <p data-testid="source-navigation">@(SourceNavigationNotice ?? View.SourceNavigationStatus)</p>
        <p data-testid="physical-size">@View.PhysicalSizeStatus</p>
        <small>@View.Compatibility</small>
        <details><summary>Extracted page text</summary><pre data-testid="page-text">@View.Text</pre></details>
    </details>;
    [Parameter] public PdfPreviewController? Controller { get; set; }
    [Parameter] public bool OwnsController { get; set; }
    [Parameter] public bool SourceMappingAvailable { get; set; }
    [Parameter] public EventCallback<PdfPreviewPointer> SourcePointRequested { get; set; }
    [Parameter] public string? SourceNavigationNotice { get; set; }
    [Parameter] public SyncTeXMatch? SourceMatch { get; set; }
    [Parameter] public string? SourceMatchPdfHash { get; set; }
    [Parameter] public SourceMapPageTransform? SourceMatchTransform { get; set; }
    [Parameter] public bool SourceMatchUsesNativeTransform { get; set; }
    private PdfPreviewController _current = new();
    private bool _ownsCurrent = true, _disposed;
    private ElementReference _element;
    private PdfPreviewCanvas? _canvas;
    private PdfPreviewPointer? _point;
    private bool CanGoToSource => SourceMappingAvailable && _point is { } point && PointCurrent(point);
    private PdfPreviewRect? SourceBox => SourceMatch is { } match && match.Page == View.PageIndex + 1
        && SourceMatchPdfHash == View.DocumentSha256 && View.Status == PdfPreviewStatus.Available && View.PageGeometry is { } geometry
        ? SourceMatchUsesNativeTransform
            ? SyncTeXDisplayGeometry.Highlight(geometry, SourceMatchTransform, match.Box)
            : SyncTeXDisplayGeometry.Highlight(geometry, match.Box)
        : null;
    private string _query = "", _lastSearchQuery = "";
    private string? _lastDocument;
    private long _submittedGeneration = -1;
    private PdfPreviewFrame? _submittedFrame;
    private PdfReaderHighlight[]? _readerHighlights;
    private long _readerHighlightsGeneration = -1;
    private PdfPreviewState View => _current.State;
    private string SurfaceStyle => View.Frame is { } frame
        ? FormattableString.Invariant($"width:{frame.Width}px;aspect-ratio:{frame.Width}/{frame.Height};--pdf-zoom:{View.ZoomPercent / 100.0}")
        : "width:360px;min-height:100px;--pdf-zoom:1";
    private string PreviewMessage => View.Status switch
    {
        PdfPreviewStatus.Empty => "No PDF is available.",
        PdfPreviewStatus.Loading => "Loading page…",
        PdfPreviewStatus.Available => "Page ready.",
        PdfPreviewStatus.Unavailable => "Preview unavailable.",
        PdfPreviewStatus.Busy => "Preview is busy. Retry when ready.",
        PdfPreviewStatus.Cancelled => _current.ActualWorkPending ? "Preview cancelled. Finishing previous request." : "Preview cancelled.",
        PdfPreviewStatus.TimedOut => "Preview took too long. Retry when ready.",
        PdfPreviewStatus.Disposed => "Preview closed.",
        _ => "Could not display the PDF. Try again."
    };
    private string SearchMessage => View.Search.Status switch
    {
        PdfPreviewSearchStatus.Empty => "Enter a search term.",
        PdfPreviewSearchStatus.Scanning => $"Searching PDF… {SearchCoverage}",
        PdfPreviewSearchStatus.Complete when View.Search.Hits.Count == 0 => $"No matches. All {View.Search.TotalPages} pages checked.",
        PdfPreviewSearchStatus.Complete => $"{View.Search.Hits.Count} {(View.Search.Hits.Count == 1 ? "match" : "matches")} across {View.Search.TotalPages} {(View.Search.TotalPages == 1 ? "page" : "pages")}.",
        PdfPreviewSearchStatus.Partial => $"Search incomplete: {View.Search.Hits.Count} {(View.Search.Hits.Count == 1 ? "match" : "matches")}; {View.Search.ScannedPages} of {View.Search.TotalPages} pages fully checked. {View.Search.Detail}",
        PdfPreviewSearchStatus.Cancelled => $"Search cancelled. Results are incomplete. {SearchCoverage} Continue when ready, or Retry.",
        _ => $"Search could not finish. Results may be incomplete. {SearchCoverage} Continue when ready, or Retry."
    };
    private string SearchCoverage => $"{View.Search.ScannedPages} of {View.Search.TotalPages} pages fully checked; {View.Search.Hits.Count} matches.";
    private string SelectedGeometry => View.SelectedHit >= 0 && View.SelectedHit < View.Search.Hits.Count ? View.Search.Hits[View.SelectedHit].GeometryStatus : "No native result selected; no guessed source/geometry mapping.";
    protected override void OnInitialized()
    {
        _current.Changed += Changed;
        _current.ReaderPageReady += ReaderPageReady;
    }
    private void ReaderPageReady(PdfPreviewFrame frame) => _canvas?.CacheReaderPage(frame);
    protected override async Task OnParametersSetAsync()
    {
        if (Controller is null || ReferenceEquals(Controller, _current)) return;
        _current.Changed -= Changed; _current.ReaderPageReady -= ReaderPageReady;
        if (_ownsCurrent) await _current.DisposeAsync();
        if (_canvas is not null) { await _canvas.DisposeAsync(); _canvas = null; }
        _current = Controller; _ownsCurrent = OwnsController; _current.Changed += Changed; _current.ReaderPageReady += ReaderPageReady;
        _submittedGeneration = -1; _submittedFrame = null; _query = View.Search.Query; _lastSearchQuery = _query; _lastDocument = View.DocumentSha256;
        _readerHighlightsGeneration = -1; _readerHighlights = null;
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_disposed)
        {
            if (_canvas is null)
            {
                _canvas = new(JS, _element, _current.InteractiveReader);
                _canvas.Changed += CanvasChanged;
                _canvas.PointRequested += CanvasPoint;
                _canvas.ReaderPageRequested += ReaderPageRequested;
                _canvas.ReaderRasterRequested += ReaderRasterRequested;
            }
            DrawLatest();
            UpdateReaderHighlights();
        }
        return Task.CompletedTask;
    }
    private void DrawLatest()
    {
        if (_disposed || _canvas is null) return;
        var state = View;
        _canvas.ConfigureReader(state);
        if (_submittedGeneration == state.Generation && ReferenceEquals(_submittedFrame, state.Frame)) return;
        _submittedGeneration = state.Generation; _submittedFrame = state.Frame;
        _canvas.Select(state.Generation, state.Frame);
    }
    private void Changed()
    {
        if (_disposed) return;
        if (_lastDocument != View.DocumentSha256 || _lastSearchQuery != View.Search.Query)
        { _lastDocument = View.DocumentSha256; _lastSearchQuery = View.Search.Query; _query = _lastSearchQuery; }
        DrawLatest(); // synchronous invalidation precedes queued Razor labels
        _ = Refresh();
    }
    private void CanvasChanged() { if (!_disposed) _ = Refresh(); }
    private void ReaderPageRequested(string hash, int page) => _ = InvokeAsync(() =>
    {
        if (!_disposed && View.DocumentSha256 == hash && View.PageIndex != page) _current.GoToPage(page + 1);
    });
    private void ReaderRasterRequested(long generation, string hash, int page, int pixelWidth) => _ = InvokeAsync(() =>
    {
        if (!_disposed) _current.RefineReaderRaster(generation, hash, page, pixelWidth);
    });
    private void UpdateReaderHighlights()
    {
        if (!_current.InteractiveReader || _canvas?.Status != "Drawn" || View.Frame is not { } frame) return;
        var highlights = new List<PdfReaderHighlight>();
        if (SourceBox is { } source) highlights.Add(new(DisplayBox(source), true));
        foreach (var hit in VisibleHits())
            highlights.AddRange(hit.NormalizedBoxes.Select(box => new PdfReaderHighlight(DisplayBox(box), false, hit.GeometryStatus)));
        if (_readerHighlightsGeneration == frame.Generation && _readerHighlights?.SequenceEqual(highlights) == true) return;
        _readerHighlightsGeneration = frame.Generation;
        _readerHighlights = highlights.ToArray();
        _canvas.SetReaderHighlights(frame.Generation, _readerHighlights);

        PdfPreviewRect DisplayBox(PdfPreviewRect box)
        {
            var pixels = PdfPreviewPixels.RasterBox(box, frame.Width, frame.Height);
            return new(pixels.Left / frame.Width, pixels.Top / frame.Height, pixels.Width / frame.Width, pixels.Height / frame.Height);
        }
    }
    private bool PointCurrent(PdfPreviewPointer point) => !_disposed && View.Status == PdfPreviewStatus.Available
        && point.Generation == View.Generation && point.DocumentSha256 == View.DocumentSha256 && point.PageIndex == View.PageIndex
        && View.Frame is { } frame && frame.Generation == point.Generation && frame.DocumentSha256 == point.DocumentSha256;
    private void CanvasPoint(PdfPreviewPointer point)
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (!PointCurrent(point)) return;
            _point = point;
            if (point.Activate && SourceMappingAvailable) await SourcePointRequested.InvokeAsync(point);
            if (!_disposed) StateHasChanged();
        });
    }
    private Task GoToSource() => _point is { } point && PointCurrent(point) && SourceMappingAvailable
        ? SourcePointRequested.InvokeAsync(point) : Task.CompletedTask;
    private async Task Refresh()
    {
        try { await InvokeAsync(() => { if (!_disposed) StateHasChanged(); }).ConfigureAwait(false); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) when (_disposed) { }
    }
    private void Previous() => _current.GoToPage(View.PageIndex);
    private void Next() => _current.GoToPage(View.PageIndex + 2);
    private void Go(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int p)) _current.GoToPage(p); }
    private void Zoom(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int z)) _current.Zoom(z); }
    private void Fit() => _current.Fit(_canvas?.MeasureFitWidth() ?? 360);
    private void Cancel() => _current.Cancel();
    private void Retry() => _current.Retry();
    private void QueryChanged(ChangeEventArgs e) { _query = e.Value?.ToString() ?? ""; if (_query.Length == 0) _current.Search(""); }
    private void Search() => _current.Search(_query);
    private void ContinueSearch() { if (_query == View.Search.Query) _current.ContinueSearch(); }
    private void SearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") Search(); }
    private void PreviousHit() { int n = View.Search.Hits.Count; if (n > 0) _current.SelectHit((View.SelectedHit <= 0 ? n : View.SelectedHit) - 1); }
    private void NextHit() { int n = View.Search.Hits.Count; if (n > 0) _current.SelectHit((View.SelectedHit + 1) % n); }
    private void PageKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight" || !_current.InteractiveReader && e.Key == "PageDown") Next();
        if (e.Key == "ArrowLeft" || !_current.InteractiveReader && e.Key == "PageUp") Previous();
        if (e.Key == "Home") _current.GoToPage(1);
        if (e.Key == "End") _current.GoToPage(View.PageCount);
    }
    private IEnumerable<PdfPreviewHit> VisibleHits() => View.SelectedHit >= 0 && View.SelectedHit < View.Search.Hits.Count
        ? View.Search.Hits.Where((h, i) => i == View.SelectedHit && h.PageIndex == View.PageIndex)
        : View.Search.Hits.Where(h => h.PageIndex == View.PageIndex);
    private string BoxStyle(PdfPreviewRect normalized)
    {
        if (View.Frame is not { } frame) return "display:none";
        var b = PdfPreviewPixels.RasterBox(normalized, frame.Width, frame.Height);
        // Anchor raster-rounded boxes to the same responsive surface as the canvas.
        return FormattableString.Invariant(
            $"left:{100 * b.Left / frame.Width:G}%;top:{100 * b.Top / frame.Height:G}%;width:{100 * b.Width / frame.Width:G}%;height:{100 * b.Height / frame.Height:G}%");
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return; _disposed = true; _current.Changed -= Changed; _current.ReaderPageReady -= ReaderPageReady;
        if (_canvas is not null) await _canvas.DisposeAsync();
        if (_ownsCurrent) await _current.DisposeAsync();
    }
}
